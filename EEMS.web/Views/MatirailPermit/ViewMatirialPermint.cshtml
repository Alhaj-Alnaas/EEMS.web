@using Core.Entities.DTOs
@using static Core.Enums.BaseEnums
@model EEMS.web.ViewModels.PermitViewModel
@using Core.Extensions
@using EEMS.web.ViewModels


@* @{
    Layout = "_Layout";
} *@

<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>عرض تصريح المواد</title>

    <!-- ✅ استيراد Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- ✅ استيراد FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <!-- ✅ استيراد ملف التنسيق الخارجي -->
    <link rel="stylesheet" href="~/css/permit-view.css" />

    
</head>

<body>
    <div class="container mt-3">
        <!-- تقليل المسافة العلوية -->
        <div class="card shadow-sm">
            <div class="header-bar">عرض تصريح المواد</div>
            <div class="card-body">
                <!-- الصف الأول -->
                <div class="page-section">
                    <div class="row">
                        <!-- العمود الأول: البيانات الأساسية -->
                        <div class="col-md-5">

                            <div>
                                <div id="alert-container" style="position: fixed; top: 20px; right: 20px; z-index: 9999; width: 300px;"></div>
                                <input type="hidden" id="PermitId" value="@Model.Id" />

                                <div class="dual-field">
                                    <div>
                                        <label class="form-label fw-bold">رقم التصريح</label>
                                        <input asp-for="No" id="No" type="text" class="form-control permit-number-display text-center fw-bold" readonly style="border: 2px solid #fd7e14;" />
                                    </div>

                                    <div class="permit-status-container">
                                        <div class="status-label">حالة التصريح</div>
                                        <div>
                                            <span class="permit-status @(ViewData["StatusClass"])">
                                                @(ViewData["DisplayStatus"])
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div>
                                <div class="dual-field">
                                    <div>
                                        <label asp-for="Date" class="form-label fw-bold">تاريخ التصريح</label>
                                        <input asp-for="Date" type="date" class="form-control" readonly />
                                    </div>
                                    <div>
                                        <label asp-for="HourOfEntry" class="form-label fw-bold">الوقت</label>
                                        <input asp-for="HourOfEntry" type="time" class="form-control" readonly />
                                    </div>
                                </div>
                            </div>

                            <div>
                                <div class="dual-field">
                                    <div>
                                        <label asp-for="Type" class="form-label fw-bold">نوع التصريح</label>
                                        <select asp-for="Type" class="form-select" disabled text-end>
                                            @foreach (var type in Enum.GetValues(typeof(Core.Enums.BaseEnums.EnumPermitType)).Cast<Core.Enums.BaseEnums.EnumPermitType>())
                                            {
                                                if (type.ToString() == Model.Type.ToString())
                                                {
                                                    <option value="@type" selected>@type.GetDescription()</option>
                                                }
                                                else
                                                {
                                                    <option value="@type">@type.GetDescription()</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                    <div>
                                        <label class="form-label fw-bold">تاريخ الترجيع</label>
                                        <input asp-for="ReturnDate" type="date" class="form-control" readonly />
                                    </div>
                                </div>
                            </div>

                            <div>
                                <label class="form-label fw-bold">الجهة الطالبة</label>
                                <input asp-for="ReqDepartment" class="form-control" readonly />
                            </div>

                            <div>
                                <label class="form-label fw-bold">وصف الجهة</label>
                                <input asp-for="OrgDescription" class="form-control" readonly />
                            </div>

                            <div class="dual-field">
                                <div>
                                    <label class="form-label fw-bold">رقم الهاتف</label>
                                    <input asp-for="PhoneNo" class="form-control" readonly />
                                </div>

                                <div>
                                    <label class="form-label fw-bold">بوابة الدخول</label>
                                    <select asp-for="EntryGate" class="form-select"
                                            asp-items="@(new SelectList(Model.Gates, "Id", "no", Model.EntryGate))">
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-1"></div>

                        <!-- العمود الثاني: المواد والمعلومات الإضافية -->
                        <div class="col-md-6">
                            <!-- المواد -->
                            <div>
                                <h5 class="section-title">المواد والمعدات</h5>
                                @if (Model.EquipmentsAndMaterials != null && Model.EquipmentsAndMaterials.Count > 0)
                                {
                                    <div class="table-responsive">
                                        <table class="table table-bordered">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>اسم المادة</th>
                                                    <th>الكمية</th>
                                                    <th>الوحدة</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @for (int i = 0; i < Model.EquipmentsAndMaterials.Count; i++)
                                                {
                                                    <tr>
                                                        <td>@Model.EquipmentsAndMaterials[i].ItemName</td>
                                                        <td>@Model.EquipmentsAndMaterials[i].Quantity</td>
                                                        <td>@Model.EquipmentsAndMaterials[i].Unit</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                else
                                {
                                    <div class="no-data-message">لا توجد مواد أو معدات للعرض</div>
                                }
                            </div>

                            <div class="dual-field">
                                <div>
                                    <label class="form-label fw-bold">قادم من</label>
                                    <input asp-for="MoveFrom" class="form-control" readonly />
                                </div>
                                <div>
                                    <label class="form-label fw-bold">ذاهب إلى</label>
                                    <input asp-for="MoveTo" class="form-control" readonly />
                                </div>
                            </div>

                            <div>
                                <label class="form-label fw-bold">ملاحظات</label>
                                <textarea name="Notes" class="form-control notes-textarea" readonly>@Model.Notes</textarea>
                            </div>
                        </div>
                    </div>

                    <!-- الأزرار في الأسفل -->
                    @{
                        var visibility = ViewData["ActionsVisibility"] as PermitActionsVisibility;
                    }
                    <div class="field-container">
                        @if (visibility?.CanApprove == true)
                        {
                            <button type="button" class="btn btn-green" data-action="approve" onclick="handlePermitAction(this)">
                                <i class="fas fa-check"></i> اعتماد
                            </button>
                        }

                        @if (visibility?.CanReject == true)
                        {
                            <button type="button" class="btn btn-red" data-action="reject" onclick="handlePermitAction(this)">
                                <i class="fas fa-times"></i> رفض
                            </button>
                        }

                        @if (visibility?.CanReturn == true)
                        {
                            <button type="button" class="btn btn-orange" data-action="return" onclick="handlePermitAction(this)">
                                <i class="fas fa-undo"></i> ترجيع
                            </button>
                        }

                        @if (visibility?.CanClose == true)
                        {
                            <button type="button" class="btn btn-blue" data-action="close" onclick="handlePermitAction(this)">
                                <i class="fas fa-lock"></i> إغلاق
                            </button>
                        }

                        @if (visibility?.CanDelete == true)
                        {
                            <button type="button" class="btn btn-red" data-action="delete" onclick="handlePermitAction(this)">
                                <i class="fas fa-trash"></i> حذف
                            </button>
                        }
                        @* <div class="action-buttons no-print">
                            <button type="button" class="btn btn-green" data-action="approve" onclick="handlePermitAction(this)">
                                <i class="fas fa-check"></i> اعتماد
                            </button>
                            <button type="button" class="btn btn-red" data-action="reject" onclick="handlePermitAction(this)">
                                <i class="fas fa-times"></i> رفض
                            </button>
                            <button type="button" class="btn btn-orange" data-action="return" onclick="handlePermitAction(this)">
                                <i class="fas fa-undo"></i> ترجيع
                            </button>
                            <button type="button" class="btn btn-blue" data-action="close" onclick="handlePermitAction(this)">
                                <i class="fas fa-lock"></i> إغلاق
                            </button>
                            <button type="button" class="btn btn-red" data-action="delete" onclick="handlePermitAction(this)">
                                <i class="fas fa-trash"></i> حذف
                            </button> *@

                            <button id="btnPrintPermit" type="button" class="btn btn-purple print-button-left" >
                                <i class="fas fa-print"></i> طباعة
                                </button>
                        </div>
                    </div>
                </div>

                <!-- زر إظهار/إخفاء الصف الثاني -->
                <div class="text-center mb-3 no-print">
                    <button type="button" class="btn-toggle" onclick="toggleSecondPage()">
                        <i class="fas fa-chevron-down" id="toggle-icon"></i>
                        <span id="toggle-text">إظهار التفاصيل الإضافية</span>
                    </button>
                </div>

                <!-- الصف الثاني -->
                <div id="second-page" class="page-section procedures-section hidden">
                    <h5 class="page-section-title">التفاصيل الإضافية</h5>
                    <div class="row">
                        <!-- العمود الأول: السيارات -->
                        <div class="col-md-5">
                            <h5 class="section-title">السيارات</h5>
                            @if (Model.Cars != null && Model.Cars.Count > 0)
                            {
                                <div class="table-responsive">
                                    <table class="table table-bordered">
                                        <thead class="table-light">
                                            <tr>
                                                <th>رقم السيارة</th>
                                                <th>نوع السيارة</th>
                                                <th>اسم السائق</th>
                                                <th>جنسية السائق</th>
                                                <th>رخصة القيادة</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < Model.Cars.Count; i++)
                                            {
                                                <tr>
                                                    <td>@Model.Cars[i].CarNo</td>
                                                    <td>@Model.Cars[i].CarType</td>
                                                    <td>@Model.Cars[i].DriverName</td>
                                                    <td>@Model.Cars[i].driverNationality</td>
                                                    <td>@Model.Cars[i].licenseNo</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="no-data-message">لا توجد سيارات للعرض</div>
                            }
                        </div>

                        <div class="col-md-1"></div>

                        <!-- العمود الثاني: الإجراءات -->
                        <div class="col-md-6">
                            <h5 class="section-title">الإجراءات المتخذة</h5>
                            @if (Model.Procedures != null && Model.Procedures.Count > 0)
                            {
                                <div class="table-responsive transaction-table">
                                    <table class="table table-bordered">
                                        <thead class="table-light">
                                            <tr>
                                                <th>الإجراء</th>
                                                <th>التاريخ</th>
                                                <th>من قام بالإجراء</th>
                                                <th>الصفة</th>
                                                <th>ملاحظات</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (int i = 0; i < Model.Procedures.Count; i++)
                                            {
                                                <tr>
                                                    <td>
                                                        @if (Model.Procedures[i].ProcedureType == "Insert")
                                                        {
                                                            <span class="badge bg-success">إدخال</span>
                                                        }
                                                        else if (Model.Procedures[i].ProcedureType == "approve")
                                                        {
                                                            <span class="badge bg-primary">اعتماد</span>
                                                        }
                                                        else if (Model.Procedures[i].ProcedureType == "Update")
                                                        {
                                                            <span class="badge bg-info">تعديل</span>
                                                        }
                                                        else if (Model.Procedures[i].ProcedureType == "reject")
                                                        {
                                                            <span class="badge bg-danger">رفض</span>
                                                        }
                                                        else if (Model.Procedures[i].ProcedureType == "return")
                                                        {
                                                            <span class="badge bg-warning">ترجيع</span>
                                                        }
                                                        else if (Model.Procedures[i].ProcedureType == "delete")
                                                        {
                                                            <span class="badge bg-danger">حدف</span>
                                                        }
                                                        else if (Model.Procedures[i].ProcedureType == "close")
                                                        {
                                                            <span class="badge bg-secondary">إغلاق</span>
                                                        }
                                                        else
                                                        {
                                                        <span class="badge bg-secondary">إغلاق</span>
                                                        }
                                                    </td>
                                                    <td>@Model.Procedures[i].DoneOn.Value.ToString("dd/MM/yyyy")</td>
                                                    <td>@Model.Procedures[i].DonedBy</td>
                                                    <td>@Model.Procedures[i].DoneAs</td>
                                                    <td>@Model.Procedures[i].Remarks</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="no-data-message">لا توجد إجراءات مسجلة</div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // دالة لإظهار رسائل التنبيه
        function showAlert(message, type) {
            const alertDiv = document.createElement('div');
            alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed`;
            alertDiv.style.top = '20px';
            alertDiv.style.left = '50%';
            alertDiv.style.transform = 'translateX(-50%)';
            alertDiv.style.zIndex = '9999';
            alertDiv.style.minWidth = '300px';
            alertDiv.innerHTML = `
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            `;
            document.body.appendChild(alertDiv);

            setTimeout(() => {
                alertDiv.remove();
            }, 5000);
        }

        // دالة طباعة التصريح
        function printPermit() {
            window.print();
        }

        // دالة إظهار/إخفاء الصف الثاني
        function toggleSecondPage() {
            const secondPage = document.getElementById('second-page');
            const toggleIcon = document.getElementById('toggle-icon');
            const toggleText = document.getElementById('toggle-text');

            if (secondPage.classList.contains('hidden')) {
                secondPage.classList.remove('hidden');
                toggleIcon.className = 'fas fa-chevron-up';
                toggleText.textContent = 'إخفاء التفاصيل الإضافية';
            } else {
                secondPage.classList.add('hidden');
                toggleIcon.className = 'fas fa-chevron-down';
                toggleText.textContent = 'إظهار التفاصيل الإضافية';
            }
        }



       // 🔹 دالة عامة لمعالجة جميع أنواع العمليات على التصريح

                function handlePermitAction(button) {
                    const actionType = $(button).data('action');
                    const permitId = $('#PermitId').val();
                    let reason = null;

                    const actionLabels = {
                        approve: { title: 'اعتماد التصريح', confirm: 'هل أنت متأكد من اعتماد هذا التصريح؟', icon: 'success' },
                        reject: { title: 'رفض التصريح', confirm: 'هل أنت متأكد من رفض هذا التصريح؟', icon: 'error' },
                        return: { title: 'ترجيع التصريح', confirm: 'هل أنت متأكد من ترجيع هذا التصريح؟', icon: 'warning' },
                        close: { title: 'إغلاق التصريح', confirm: 'هل أنت متأكد من إغلاق هذا التصريح؟', icon: 'info' },
                        delete: { title: 'حذف التصريح', confirm: 'هل أنت متأكد من حذف هذا التصريح؟ لا يمكن التراجع عن العملية.', icon: 'error' }
                    };

                    const action = actionLabels[actionType];
                    if (!action) {
                        Swal.fire('خطأ', 'نوع الإجراء غير معروف.', 'error');
                        return;
                    }

                    // 🔹 أولاً: تأكيد الإجراء
                    Swal.fire({
                        title: action.title,
                        text: action.confirm,
                        icon: action.icon,
                        showCancelButton: true,
                        confirmButtonText: 'نعم',
                        cancelButtonText: 'لا',
                        reverseButtons: true,
                        confirmButtonColor: '#198754', // لون الزر الأخضر
                        cancelButtonColor: '#dc3545',  // لون الزر الأحمر
                    }).then((result) => {
                        if (!result.isConfirmed) return;

                        // 🔸 ثانياً: إذا احتاج سبب (رفض أو ترجيع)
                        if (actionType === 'reject' || actionType === 'return') {
                            Swal.fire({
                                title: 'يرجى إدخال السبب',
                                input: 'text',
                                inputPlaceholder: 'اكتب السبب هنا...',
                                confirmButtonText: 'موافق',
                                showCancelButton: true,
                                cancelButtonText: 'إلغاء',
                                inputValidator: (value) => {
                                    if (!value) return 'يجب إدخال السبب';
                                }
                            }).then((inputResult) => {
                                if (inputResult.isConfirmed) {
                                    reason = inputResult.value;
                                    sendPermitAction(permitId, actionType, reason);
                                }
                            });
                        } else {
                            sendPermitAction(permitId, actionType, reason);
                        }
                    });
                }

                // 🔹 إرسال الطلب إلى السيرفر
                function sendPermitAction(permitId, actionType, reason) {
                    $.ajax({
                        url: '/Permit/HandlePermitAction',
                        type: 'POST',
                        data: { permitId, actionType, reason },
                        success: function (response) {
                            if (response.success) {
                                Swal.fire({
                                    title: 'تم بنجاح',
                                    text: response.message,
                                    icon: 'success',
                                    confirmButtonText: 'موافق',
                                    confirmButtonColor: '#198754'
                                }).then(() => {
                                    if (actionType === 'delete')
                                        window.location.href = '/MatirailPermit/Index';
                                    else
                                        location.reload();
                                });
                            } else {
                                Swal.fire('خطأ', response.message, 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('خطأ', 'حدث خطأ أثناء تنفيذ العملية.', 'error');
                        }
                    });
                }
       

        function showAlert(message, type = 'info') {
            const alertBox = $(`
                <div class="alert alert-${type} text-center fw-bold shadow-sm fade show" role="alert">
                    ${message}
                </div>
            `).hide();

            $('#alert-container').append(alertBox);
            alertBox.fadeIn(400);

            setTimeout(() => {
                alertBox.fadeOut(500, () => alertBox.remove());
            }, 2500);
        }

      
        $('#btnPrintPermit').on('click', function () {
            const permitId = $('#PermitId').val();
             window.open(`/Permit/PrintPermitPdf?permitId=${permitId}`, '_blank');
        });
    

    </script>
</body>
</html>