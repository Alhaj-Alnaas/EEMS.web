[@using EEMS.web.ViewModels
@model CreateGateViewModel
@Html.ValidationSummary(true, "", new { @class = "text-danger" })

@{
    ViewData["Title"] = "إضافة بوابة";
}

<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            background-color: #f8f9fa;
            direction: rtl;
            text-align: right;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container {
            max-width: 1200px;
        }

        .header-bar {
            background: linear-gradient(45deg, #495057, #343a40);
            color: #fff;
            padding: 15px;
            border-radius: 10px 10px 0 0;
            font-weight: bold;
            margin-bottom: 0;
            text-align: center;
            font-size: 1.2rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .card {
            border-radius: 10px;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
            border: 2px solid #fd7e14;
            overflow: hidden;
        }

        .card-body {
            padding: 25px;
        }

        .btn-orange {
            background-color: #fd7e14;
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 8px 16px;
            font-weight: 500;
            transition: all 0.3s ease;
        }

            .btn-orange:hover {
                background-color: #e96b0c;
                color: #fff;
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(253, 126, 20, 0.3);
            }

        .form-control, .form-select {
            border-radius: 8px;
            border: 1px solid #ced4da;
            padding: 10px 15px;
            transition: all 0.3s ease;
        }

            .form-control:focus, .form-select:focus {
                border-color: #fd7e14;
                box-shadow: 0 0 0 0.25rem rgba(253, 126, 20, 0.25);
            }

        .form-label {
            font-weight: 600;
            color: #495057;
            margin-bottom: 5px;
        }

        .form-check-input:checked {
            background-color: #fd7e14;
            border-color: #fd7e14;
        }

        .form-switch {
            padding-right: 0;
            margin-bottom: 15px;
        }

        .form-check-label {
            font-weight: 600;
            color: #495057;
        }

        /* فاصل بين العمودين */
        .column-divider {
            position: relative;
            padding-right: 30px;
        }

            .column-divider::after {
                content: "";
                position: absolute;
                top: 0;
                left: -15px; /* تعديل الموضع ليكون بين العمودين */
                height: 100%;
                width: 2px;
                background: linear-gradient(to bottom, transparent, #fd7e14, transparent);
                border-radius: 1px;
            }

        /* تنسيق مربعات الاختيار */
        .permit-types-container {
            max-height: 400px;
            overflow-y: auto;
            padding: 15px;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            background-color: #f8f9fa;
        }

        .permit-type-item {
            margin-bottom: 10px;
            padding: 8px;
            border-radius: 6px;
            transition: background-color 0.2s;
        }

            .permit-type-item:hover {
                background-color: #e9ecef;
            }

        .section-title {
            font-weight: bold;
            margin-top: 1.5rem;
            margin-bottom: 1rem;
            text-align: center;
            color: #495057;
            position: relative;
            padding-bottom: 10px;
        }

            .section-title::after {
                content: "";
                position: absolute;
                bottom: 0;
                right: 25%;
                left: 25%;
                height: 2px;
                background: linear-gradient(90deg, transparent, #fd7e14, transparent);
            }

        /* تنسيق زر الرجوع */
        .btn-back {
            background-color: #495057;
            color: white;
            border: none;
            border-radius: 8px;
            padding: 8px 16px;
            font-weight: 500;
            transition: all 0.3s ease;
        }

            .btn-back:hover {
                background-color: #e96b0c;
                color: white;
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(253, 126, 20, 0.3);
            }
    </style>
</head>
<body>
    <div class="container mt-4">
        <div class="card shadow-sm">
            <div class="header-bar">إضافة بوابة جديدة</div>
            <div class="card-body">
                <form asp-action="Create">
                    <div class="row g-4">
                        <!-- العمود الأول: البيانات الأساسية -->
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label asp-for="No" class="form-label fw-bold">رقم البوابة</label>
                                <input asp-for="No" class="form-control" placeholder="أدخل رقم البوابة" />
                                <span asp-validation-for="No" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label fw-bold">الوصف</label>
                                <input asp-for="Description" class="form-control" placeholder="أدخل وصف البوابة" />
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="form-check form-switch mb-3">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                                <label class="form-check-label fw-bold" asp-for="IsActive">مفعلة</label>
                                <span asp-validation-for="IsActive" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Remarks" class="form-label fw-bold">الملاحظات</label>
                                <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="أدخل الملاحظات هنا"></textarea>
                                <span asp-validation-for="Remarks" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- العمود الثاني: أنواع التصاريح -->
                        <div class="col-md-6 column-divider">
                            <h5 class="section-title">أنواع التصاريح المتاحة</h5>
                            <div class="permit-types-container">
                                @if (Model.PermitTypes != null && Model.PermitTypes.Any())
                                {
                                    @foreach (var permit in Model.PermitTypes)
                                    {
                                        <div class="permit-type-item">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="SelectedPermitTypeIds" value="@permit.Id" id="permit_@permit.Id" />
                                                <label class="form-check-label" for="permit_@permit.Id">@permit.Name</label>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="alert alert-info text-center">
                                        لا توجد أنواع تصاريح متاحة حالياً
                                    </div>
                                }
                                <span asp-validation-for="SelectedPermitTypeIds" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 text-center">
                        <button type="submit" class="btn btn-orange px-4">
                            <i class="fas fa-save ms-2"></i> حفظ
                        </button>
                        <a asp-action="Index" class="btn btn-back px-4">
                            <i class="fas fa-arrow-right ms-2"></i> رجوع
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
</body>
</html>




