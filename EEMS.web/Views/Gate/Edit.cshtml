@model EditGateViewModel

@{
    ViewData["Title"] = "تعديل البوابة";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
        body {
            background-color: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            direction: rtl;
        }

        .container {
            max-width: 900px; /* تم تعديل العرض لتحسين المظهر */
        }

        .card {
            border-radius: 10px;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
            border: 2px solid #fd7e14; /* إطار برتقالي رقيق */
            overflow: hidden;
        }

        .card-header-custom {
            background-color: #495057; /* لون رصاصي غامق */
            color: #fff;
            padding: 15px;
            text-align: center;
            font-weight: bold;
            font-size: 1.2rem;
        }

        .card-body {
            padding: 25px;
        }

        .btn-primary {
            background-color: #fd7e14;
            border-color: #fd7e14;
            transition: all 0.3s ease;
        }

            .btn-primary:hover {
                background-color: #e96b0c;
                border-color: #e96b0c;
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(253, 126, 20, 0.3);
            }

        .btn-secondary {
            background-color: #6c757d;
            border-color: #6c757d;
        }

            .btn-secondary:hover {
                background-color: #5a6268;
                border-color: #5a6268;
            }

        .form-label {
            font-weight: 600;
            color: #495057;
            margin-bottom: 5px;
        }

        .form-check-input:checked {
            background-color: #fd7e14;
            border-color: #fd7e14;
        }

        .permit-types-container {
            max-height: 250px; /* تعديل الارتفاع ليتناسب مع التصميم */
            overflow-y: auto;
            padding: 15px;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            background-color: #f8f9fa;
        }

        .section-title {
            font-weight: bold;
            margin-bottom: 1rem;
            color: #495057;
            position: relative;
            padding-bottom: 10px;
        }

            .section-title::after {
                content: "";
                position: absolute;
                bottom: 0;
                right: 0;
                width: 100%;
                height: 2px;
                background: linear-gradient(90deg, transparent, #fd7e14, transparent);
            }
    </style>
</head>
<body>
    <div class="container mt-4">
        <div class="card shadow-sm">
            <div class="card-header-custom">
                <h4>@ViewData["Title"]</h4>
            </div>
            <div class="card-body">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />

                    <div class="row g-4">
                        <div class="col-lg-6">
                            <h5 class="section-title text-center">البيانات الأساسية</h5>
                            <div class="mb-3">
                                <label asp-for="No" class="form-label">رقم البوابة</label>
                                <input asp-for="No" class="form-control" />
                                <span asp-validation-for="No" class="text-danger"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Description" class="form-label">الوصف</label>
                                <input asp-for="Description" class="form-control" />
                                <span asp-validation-for="Description" class="text-danger"></span>
                            </div>

                            <div class="form-check mb-3">
                                <input asp-for="IsActive" class="form-check-input" />
                                <label asp-for="IsActive" class="form-check-label">مفعلة</label>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Remarks" class="form-label">الملاحظات</label>
                                <textarea asp-for="Remarks" class="form-control" rows="3"></textarea>
                                <span asp-validation-for="Remarks" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="col-lg-6">
                            <h5 class="section-title text-center">أنواع التصاريح المسموح بها</h5>
                            <div class="permit-types-container">
                                @foreach (var permit in Model.PermitTypes)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               name="SelectedPermitTypeIds"
                                               value="@permit.Id"
                                               @(Model.SelectedPermitTypeIds.Contains(permit.Id) ? "checked" : "") />
                                        <label class="form-check-label">@permit.Name</label>
                                    </div>
                                }
                            </div>
                            <span asp-validation-for="SelectedPermitTypeIds" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mt-4 text-center">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i> حفظ التعديلات
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="fas fa-arrow-right me-2"></i> إلغاء
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}


