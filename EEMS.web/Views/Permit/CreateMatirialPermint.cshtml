@model EEMS.web.ViewModels.PermitViewModel

<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>إضافة تصريح</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            background-color: #f8f9fa;
            direction: rtl;
            text-align: right;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container {
            max-width: 1200px;
        }

        .header-bar {
            background: linear-gradient(45deg, #495057, #343a40);
            color: #fff;
            padding: 15px;
            border-radius: 10px 10px 0 0;
            font-weight: bold;
            margin-bottom: 0;
            text-align: center;
            font-size: 1.2rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .card {
            border-radius: 10px;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
            border: 2px solid #fd7e14;
            overflow: hidden;
        }

        .card-body {
            padding: 25px;
        }

        .btn-orange {
            background-color: #fd7e14;
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 8px 16px;
            font-weight: 500;
            transition: all 0.3s ease;
        }

            .btn-orange:hover {
                background-color: #e96b0c;
                color: #fff;
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(253, 126, 20, 0.3);
            }

        table th, table td {
            vertical-align: middle;
            text-align: right;
        }

        .section-title {
            font-weight: bold;
            margin-top: 1.5rem;
            margin-bottom: 1rem;
            text-align: center;
            color: #495057;
            position: relative;
            padding-bottom: 10px;
        }

            .section-title::after {
                content: "";
                position: absolute;
                bottom: 0;
                right: 25%;
                left: 25%;
                height: 2px;
                background: linear-gradient(90deg, transparent, #fd7e14, transparent);
            }

        .table {
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 3px 6px rgba(0, 0, 0, 0.05);
        }

            .table thead th {
                background-color: #f1f3f5;
                border-bottom: 2px solid #dee2e6;
                font-weight: 600;
                color: #495057;
            }

        .form-control, .form-select {
            border-radius: 8px;
            border: 1px solid #ced4da;
            padding: 10px 15px;
            transition: all 0.3s ease;
        }

            .form-control:focus, .form-select:focus {
                border-color: #fd7e14;
                box-shadow: 0 0 0 0.25rem rgba(253, 126, 20, 0.25);
            }

        .form-label {
            font-weight: 600;
            color: #495057;
            margin-bottom: 5px;
        }

        .form-check-input:checked {
            background-color: #fd7e14;
            border-color: #fd7e14;
        }

        .btn-icon {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            border: none;
            transition: all 0.3s ease;
        }

        .btn-add {
            background-color: #28a745;
            color: white;
        }

            .btn-add:hover {
                background-color: #218838;
                transform: scale(1.1);
            }

        .btn-delete {
            background-color: #dc3545;
            color: white;
        }

            .btn-delete:hover {
                background-color: #c82333;
                transform: scale(1.1);
            }

        .form-switch {
            padding-right: 0;
            margin-bottom: 15px;
        }

        .form-check-label {
            font-weight: 600;
            color: #495057;
        }

        .notes-textarea {
            min-height: 120px;
            resize: vertical;
        }

        /* تحسين عرض القوائم المنسدلة */
        .form-select {
            min-width: 100%;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

            /* تحسين عرض خيارات القائمة المنسدلة */
            .form-select option {
                padding-right: 10px;
                direction: rtl;
                text-align: right;
            }

        /* إضافة مساحة داخلية للقائمة المنسدلة */
        .form-select {
            padding-right: 30px !important;
        }

        /* فاصل بين العمودين */
        .column-divider {
            position: relative;
            padding-right: 30px;
        }

            .column-divider::after {
                content: "";
                position: absolute;
                top: 0;
                left: -15px; /* تعديل الموضع ليكون بين العمودين */
                height: 100%;
                width: 2px;
                background: linear-gradient(to bottom, transparent, #fd7e14, transparent);
                border-radius: 1px;
            }

        /* تحسين مظهر الجداول */
        .table-responsive {
            margin-bottom: 1rem;
        }

        /* تحسين مظهر الأزرار */
        .btn {
            font-weight: 500;
            border-radius: 8px;
            padding: 8px 16px;
            transition: all 0.3s ease;
        }

        /* تحسين مظهر العناوين */
        h5.section-title {
            margin-top: 2rem;
            margin-bottom: 1.5rem;
        }

        /* تحسين المسافات بين الحقول */
        .mb-sm-3 {
            margin-bottom: 1.25rem !important;
        }

        /* تحسين مظهر حقول الإدخال عند التركيز */
        .form-control:focus, .form-select:focus {
            border-color: #fd7e14;
            box-shadow: 0 0 0 0.25rem rgba(253, 126, 20, 0.25);
        }

        /* تأثير الحركة للإظهار والإخفاء */
        .fade-effect {
            transition: opacity 0.3s ease-in-out, height 0.3s ease-in-out;
        }

        .hidden-field {
            opacity: 0;
            height: 0;
            overflow: hidden;
            margin: 0;
            padding: 0;
        }

        .visible-field {
            opacity: 1;
            height: auto;
            overflow: visible;
        }
    </style>
</head>
<body>
    <div class="container mt-4">
        <div class="card shadow-sm">
            <div class="header-bar">إضافة تصريح جديد</div>
            <div class="card-body">
                <form asp-action="Create" method="post">

                    <div class="row g-4">
                        <!-- العمود الأول: البيانات الأساسية (1/3 من العرض) -->
                        <div class="col-md-4">
                            <div class="form-check form-switch mb-2">
                                <input asp-for="IsTemp" class="form-check-input" type="checkbox" />
                                <label class="form-check-label fw-bold" asp-for="IsTemp">تصريح مؤقت</label>
                            </div>
                            <div class="mb-sm-3">
                                <input asp-for="No" class="form-control" placeholder="رقم التصريح" readonly />
                            </div>
                            <div class="mb-sm-3">
                                <label asp-for="Date" class="form-label fw-bold">تاريخ التصريح</label>
                                <input asp-for="Date" type="datetime-local" class="form-control" placeholder="تاريخ التصريح" />
                            </div>
                            <div class="mb-sm-3">
                                <label asp-for="Type" class="form-label fw-bold">نوع التصريح</label>
                                <select asp-for="Type" id="permitType" class="form-select">
                                    <option value="">-- اختر نوع التصريح --</option>
                                    <option value="استخراج">استخراج</option>
                                    <option value="إدخال">إدخال</option>
                                    <option value="إستخراج وإدخال">إستخراج وإدخال</option>
                                </select>
                            </div>

                            <!-- حقل تاريخ الترجيع - سيتم إظهاره فقط عند اختيار "إستخراج وإدخال" -->
                            <div id="returnDateField" class="mb-sm-3 fade-effect hidden-field">
                                <label asp-for="ReturnDate" class="form-label fw-bold">تاريخ الترجيع</label>
                                <input asp-for="ReturnDate" type="datetime-local" class="form-control" placeholder="تاريخ الترجيع" />
                            </div>

                            <div class="mb-sm-3">
                                <select asp-for="ReqDepartment" class="form-select">
                                    <option value="">-- اختر الجهة الطالبة --</option>
                                </select>
                            </div>
                            <div class="mb-sm-3">
                                <input name="DepartmentDescription" class="form-control" placeholder="وصف الجهة" />
                            </div>
                            <div class="mb-sm-3">
                                <input asp-for="PhoneNo" class="form-control" placeholder="رقم الهاتف" />
                            </div>
                            <div class="mb-sm-3">
                                <input asp-for="MoveFrom" class="form-control" placeholder="قادم من" />
                            </div>
                            <div class="mb-sm-3">
                                <input asp-for="MoveTo" class="form-control" placeholder="ذاهب إلى" />
                            </div>

                            <!-- حقل الملاحظات الجديد -->
                            <div class="mb-sm-3">
                                <label class="form-label fw-bold">ملاحظات</label>
                                <textarea name="Notes" class="form-control notes-textarea" placeholder="أدخل الملاحظات هنا..."></textarea>
                            </div>
                        </div>

                        <!-- العمود الثاني: المواد + السيارات (2/3 من العرض) -->
                        <div class="col-md-8 column-divider">
                            <!-- المواد -->
                            <h5 class="section-title">المواد والمعدات</h5>
                            <div class="table-responsive">
                                <table class="table table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="col-6">اسم المادة/المعدة</th>
                                            <th class="col-3">الكمية</th>
                                            <th class="col-3">وحدة القياس</th>
                                            <th class="text-center">
                                                <button type="button" id="addEquipBtn" class="btn-icon btn-add" title="إضافة مادة/معدة">
                                                    <i class="fas fa-plus"></i>
                                                </button>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody id="equipmentsTableBody"></tbody>
                                </table>
                            </div>

                            <!-- السيارات -->
                            <h5 class="section-title">السيارات</h5>
                            <div class="table-responsive">
                                <table class="table table-bordered">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="col-2">رقم السيارة</th>
                                            <th class="col-2">نوع السيارة</th>
                                            <th class="col-4">اسم السائق</th>
                                            <th class="col-2">جنسية السائق</th>
                                            <th class="col-2">رخصة القيادة</th>
                                            <th class="text-center">
                                                <button type="button" id="addCarBtn" class="btn-icon btn-add" title="إضافة سيارة">
                                                    <i class="fas fa-plus"></i>
                                                </button>
                                            </th>
                                        </tr>
                                    </thead>
                                    <tbody id="carsTableBody"></tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 text-center">
                        <button type="submit" class="btn btn-orange px-4">
                            <i class="fas fa-save ms-2"></i> حفظ
                        </button>
                        <a asp-action="Index" class="btn btn-secondary px-4">
                            <i class="fas fa-times ms-2"></i> إلغاء
                        </a>
                    </div>

                </form>
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script>
        $(document).ready(function() {
            // دالة للتحقق من أن المدخل رقم فقط
            function isNumberKey(evt) {
                var charCode = (evt.which) ? evt.which : evt.keyCode;
                // السماح بالأرقام ومفتاح المسافة ومفتاح الحذف والنقطة العشرية
                if (charCode > 31 && (charCode < 48 || charCode > 57) && charCode !== 46) {
                    return false;
                }
                return true;
            }

            // دالة لتنسيق حقل الكمية
            function formatQuantityField(input) {
                $(input).attr({
                    'type': 'text', // استخدام text بدلاً من number للتحكم الكامل
                    'min': '1',
                    'step': '0.01',
                    'pattern': '[0-9.]*',
                    'inputmode': 'decimal'
                }).on('keypress input', function(e) {
                    // السماح فقط بالأرقام والنقطة العشرية
                    if (!isNumberKey(e)) {
                        e.preventDefault();
                        return false;
                    }

                    // التأكد من أن هناك نقطة عشرية واحدة فقط
                    var value = $(this).val();
                    if (value.split('.').length > 2) {
                        $(this).val(value.replace(/\.+$/, ""));
                    }

                    // التأكد من أن القيمة رقم موجب
                    if (value !== '' && (isNaN(value) || parseFloat(value) <= 0)) {
                        $(this).val('');
                    }
                });
            }

            // التحكم في إظهار/إخفاء حقل تاريخ الترجيع
            $('#permitType').change(function() {
                var selectedType = $(this).val();
                var returnDateField = $('#returnDateField');

                if (selectedType === 'إستخراج وإدخال') {
                    returnDateField.removeClass('hidden-field').addClass('visible-field');
                } else {
                    returnDateField.removeClass('visible-field').addClass('hidden-field');
                    // مسح قيمة الحقل عند إخفائه
                    $('#ReturnDate').val('');
                }
            });

            // إضافة صف مادة
            $("#addEquipBtn").click(function () {
                var tbody = $("#equipmentsTableBody");
                var index = tbody.children("tr").length;

                // إنشاء الصف الجديد
                var newRow = $(`
                    <tr>
                        <td><input name="EquipmentsAndMaterials[${index}].ItemName" class="form-control" placeholder="اسم المادة" /></td>
                        <td>
                            <input name="EquipmentsAndMaterials[${index}].Quantity" class="form-control quantity-field" placeholder="الكمية" />
                        </td>
                        <td>
                            <select name="EquipmentsAndMaterials[${index}].Unit" class="form-select">
                                <option value="">-- اختر الوحدة --</option>
                                <option value="قطعة">قطعة</option>
                                <option value="كيلوغرام">كيلوغرام</option>
                                <option value="جرام">جرام</option>
                                <option value="طن">طن</option>
                                <option value="لتر">لتر</option>
                                <option value="متر">متر</option>
                                <option value="متر مربع">متر مربع</option>
                                <option value="متر مكعب">متر مكعب</option>
                                <option value="صندوق">صندوق</option>
                                <option value="عبوة">عبوة</option>
                                <option value="كرتونة">كرتونة</option>
                                <option value="شحنة">شحنة</option>
                                <option value="طرد">طرد</option>
                                <option value="غير معروف">غير معروف</option>
                            </select>
                        </td>
                        <td class="text-center">
                            <button type="button" class="btn-icon btn-delete removeRow" title="حذف">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </td>
                    </tr>
                `);

                tbody.append(newRow);

                // تطبيق تنسيق حقل الكمية
                formatQuantityField(newRow.find('.quantity-field'));
            });

            // إضافة صف سيارة
            $("#addCarBtn").click(function () {
                var tbody = $("#carsTableBody");
                var index = tbody.children("tr").length;
                var newRow = $(`
                    <tr>
                        <td><input name="Cars[${index}].CarNo" class="form-control" placeholder="رقم السيارة" /></td>
                        <td><input name="Cars[${index}].CarType" class="form-control" placeholder="نوع السيارة" /></td>
                        <td><input name="Cars[${index}].DriverName" class="form-control" placeholder="اسم السائق" /></td>
                        <td>
                            <select name="Cars[${index}].DriverNationality" class="form-select">
                                <option value="">-- اختر الجنسية --</option>
                                <option value="ليبي">ليبي</option>
                                <option value="مصري">مصري</option>
                                <option value="سوداني">سوداني</option>
                                <option value="تونسي">تونسي</option>
                                <option value="جزائري">جزائري</option>
                                <option value="مغربي">مغربي</option>
                                <option value="فلسطيني">فلسطيني</option>
                                <option value="يمني">يمني</option>
                                <option value="سوري">سوري</option>
                                <option value="عراقي">عراقي</option>
                                <option value="هندي">هندي</option>
                                <option value="باكستاني">باكستاني</option>
                                <option value="بنغلاديشي">بنغلاديشي</option>
                                <option value="فلبيني">فلبيني</option>
                                <option value="إندونيسي">إندونيسي</option>
                                <option value="ماليزي">ماليزي</option>
                                <option value="تركي">تركي</option>
                                <option value="صيني">صيني</option>
                                <option value="ياباني">ياباني</option>
                                <option value="كوري">كوري</option>
                                <option value="غير معروف">غير معروف</option>
                            </select>
                        </td>
                        <td><input name="Cars[${index}].DriverLicense" class="form-control" placeholder="رخصة القيادة" /></td>
                        <td class="text-center">
                            <button type="button" class="btn-icon btn-delete removeRow" title="حذف">
                                <i class="fas fa-trash-alt"></i>
                            </button>
                        </td>
                    </tr>
                `);

                tbody.append(newRow);
            });

            // زر حذف الصف لأي جدول
            $(document).on("click", ".removeRow", function () {
                $(this).closest("tr").fadeOut(300, function() {
                    $(this).remove();
                });
            });
        });
    </script>
</body>
</html>