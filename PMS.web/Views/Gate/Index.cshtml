@model IEnumerable<Core.Entities.Gate>

@{
    ViewData["Title"] = "إدارة البوابات";
}

<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            background-color: #f8f9fa;
            direction: rtl;
            text-align: right;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container {
            max-width: 1200px;
        }

        .header-bar {
            background: linear-gradient(45deg, #495057, #343a40);
            color: #fff;
            padding: 15px;
            border-radius: 10px 10px 0 0;
            font-weight: bold;
            margin-bottom: 0;
            text-align: center;
            font-size: 1.2rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .card {
            border-radius: 10px;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
            border: 2px solid #fd7e14;
            overflow: hidden;
        }

        .card-body {
            padding: 25px;
        }

        table {
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 3px 6px rgba(0, 0, 0, 0.05);
        }

            table th {
                background-color: #f1f3f5;
                border-bottom: 2px solid #dee2e6;
                font-weight: 600;
                color: #495057;
                text-align: center;
            }

            table td {
                vertical-align: middle;
                text-align: center;
            }

        .status-icon {
            font-size: 1.2rem;
        }

        .status-active {
            color: #28a745;
        }

        .status-inactive {
            color: #dc3545;
        }

        /* زر دائري أخضر */
        .btn-icon {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            border: none;
            font-size: 1.2rem;
            transition: all 0.3s ease;
        }

        .btn-add {
            background-color: #28a745;
            color: white;
        }

            .btn-add:hover {
                background-color: #218838;
                transform: scale(1.1);
            }

        .btn-view {
            background-color: #17a2b8;
            color: white;
        }

            .btn-view:hover {
                background-color: #138496;
                transform: scale(1.1);
            }

        .btn-edit {
            background-color: #007bff;
            color: white;
        }

            .btn-edit:hover {
                background-color: #0069d9;
                transform: scale(1.1);
            }
    </style>
</head>
<body>
    <div class="container mt-4">
        <div class="card shadow-sm">
            
            <div class="header-bar">
                <h4 class="header-title">إدارة البوابات</h4>
            </div>

            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th>رقم البوابة</th>
                                <th>الوصف</th>
                                <th>الحالة</th>
                                <th>أضيفت بواسطة</th>
                                <th>تاريخ الإضافة</th>
                                <th>الملاحظات</th>
                                <th>الإجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td>@Html.DisplayFor(modelItem => item.no)</td>
                                        <td>@Html.DisplayFor(modelItem => item.description)</td>
                                        <td>
                                            @if (item.isActive)
                                            {
                                                <i class="fas fa-check-circle status-icon status-active" title="مفعلة"></i>
                                            }
                                            else
                                            {
                                                <i class="fas fa-times-circle status-icon status-inactive" title="غير مفعلة"></i>
                                            }
                                        </td>
                                        <td>@Html.DisplayFor(modelItem => item.createdBy)</td>
                                        <td>@item.createdOn.ToString("yyyy/MM/dd")</td>
                                        <td>@Html.DisplayFor(modelItem => item.remarks)</td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a asp-action="Details" asp-route-id="@item.Id"
                                                   class="btn-icon btn-view me-2" title="عرض التفاصيل">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@item.Id"
                                                   class="btn-icon btn-edit" title="تعديل البوابة">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-4">
                                        <div class="alert alert-info mb-0">
                                            <i class="fas fa-info-circle me-2"></i>
                                            لا توجد بوابات مسجلة حالياً
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- زر إضافة بوابة أسفل يسار -->
                <div class="d-flex justify-content-start mt-3">
                    <a asp-action="Create" class="btn-icon btn-add" title="إضافة بوابة جديدة">
                        <i class="fas fa-plus"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>



