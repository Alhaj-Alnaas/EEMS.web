
@using Core.Entities.DTOs
@using static Core.Enums.BaseEnums
@model PMS.web.ViewModels.PermitViewModel
@using Core.Extensions

<!DOCTYPE html>
<html lang="ar">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>تعديل تصريح</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        body {
            background-color: #f8f9fa;
            direction: rtl;
            text-align: right;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .container {
            max-width: 1200px;
        }

        .header-bar {
            background: linear-gradient(45deg, #495057, #343a40);
            color: #fff;
            padding: 15px;
            border-radius: 10px 10px 0 0;
            font-weight: bold;
            margin-bottom: 0;
            text-align: center;
            font-size: 1.2rem;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .card {
            border-radius: 10px;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
            border: 2px solid #fd7e14;
            overflow: hidden;
        }

        .card-body {
            padding: 25px;
        }

        .btn-orange {
            background-color: #fd7e14;
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 8px 16px;
            font-weight: 500;
            transition: all 0.3s ease;
        }

            .btn-orange:hover {
                background-color: #e96b0c;
                color: #fff;
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(253, 126, 20, 0.3);
            }

        table th, table td {
            vertical-align: middle;
            text-align: right;
        }

        .section-title {
            font-weight: bold;
            margin-top: 1.5rem;
            margin-bottom: 1rem;
            text-align: center;
            color: #495057;
            position: relative;
            padding-bottom: 10px;
        }

            .section-title::after {
                content: "";
                position: absolute;
                bottom: 0;
                right: 25%;
                left: 25%;
                height: 2px;
                background: linear-gradient(90deg, transparent, #fd7e14, transparent);
            }

        .table {
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 3px 6px rgba(0, 0, 0, 0.05);
        }

            .table thead th {
                background-color: #f1f3f5;
                border-bottom: 2px solid #dee2e6;
                font-weight: 600;
                color: #495057;
            }

        .form-control, .form-select {
            border-radius: 8px;
            border: 1px solid #ced4da;
            padding: 10px 15px;
            transition: all 0.3s ease;
        }

            .form-control:focus, .form-select:focus {
                border-color: #fd7e14;
                box-shadow: 0 0 0 0.25rem rgba(253, 126, 20, 0.25);
            }

        .form-label {
            font-weight: 600;
            color: #495057;
            margin-bottom: 5px;
        }

        .form-check-input:checked {
            background-color: #fd7e14;
            border-color: #fd7e14;
        }

        .btn-icon {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            border: none;
            transition: all 0.3s ease;
        }

        .btn-add {
            background-color: #28a745;
            color: white;
        }

            .btn-add:hover {
                background-color: #218838;
                transform: scale(1.1);
            }

        .btn-delete {
            background-color: #dc3545;
            color: white;
        }

            .btn-delete:hover {
                background-color: #c82333;
                transform: scale(1.1);
            }

        .form-switch {
            padding-right: 0;
            margin-bottom: 15px;
        }

        .form-check-label {
            font-weight: 600;
            color: #495057;
        }

        .notes-textarea {
            min-height: 120px;
            resize: vertical;
        }

        /* تحسين عرض القوائم المنسدلة */
        .form-select {
            min-width: 100%;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

            /* تحسين عرض خيارات القائمة المنسدلة */
            .form-select option {
                padding-right: 10px;
                direction: rtl;
                text-align: right;
            }

        /* إضافة مساحة داخلية للقائمة المنسدلة */
        .form-select {
            padding-right: 30px !important;
        }

        /* فاصل بين العمودين */
        .column-divider {
            position: relative;
            padding-right: 30px;
        }

            .column-divider::after {
                content: "";
                position: absolute;
                top: 0;
                left: -15px; /* تعديل الموضع ليكون بين العمودين */
                height: 100%;
                width: 2px;
                background: linear-gradient(to bottom, transparent, #fd7e14, transparent);
                border-radius: 1px;
            }

        /* تحسين مظهر الجداول */
        .table-responsive {
            margin-bottom: 1rem;
        }

        /* تحسين مظهر الأزرار */
        .btn {
            font-weight: 500;
            border-radius: 8px;
            padding: 8px 16px;
            transition: all 0.3s ease;
        }

        /* تحسين مظهر العناوين */
        h5.section-title {
            margin-top: 2rem;
            margin-bottom: 1.5rem;
        }

        /* تحسين المسافات بين الحقول */
        .mb-sm-3 {
            margin-bottom: 1.25rem !important;
        }

        /* تحسين مظهر حقول الإدخال عند التركيز */
        .form-control:focus, .form-select:focus {
            border-color: #fd7e14;
            box-shadow: 0 0 0 0.25rem rgba(253, 126, 20, 0.25);
        }

        /* تأثير الحركة للإظهار والإخفاء */
        .fade-effect {
            transition: opacity 0.3s ease-in-out, height 0.3s ease-in-out;
        }

        .hidden-field {
            opacity: 0;
            height: 0;
            overflow: hidden;
            margin: 0;
            padding: 0;
        }

        .visible-field {
            opacity: 1;
            height: auto;
            overflow: visible;
        }

        /* تنسيق رسائل الخطأ */
        .error-message {
            color: #dc3545;
            font-size: 0.875rem;
            margin-top: 0.25rem;
            display: none;
        }

        .form-control.is-invalid, .form-select.is-invalid {
            border-color: #dc3545;
        }
    </style>
</head>
<body>
<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="header-bar">تعديل تصريح</div>
        <div class="card-body">
                <form asp-action="EditMatirialPermint" asp-controller="MatirailPermit" method="post" id="permitForm">
                    @Html.AntiForgeryToken()

                    <!-- قالب للوحدات -->
                    <select id="unitTemplate" class="d-none">
                        <option value="">-- اختر الوحدة --</option>
                        @foreach (var unit in Enum.GetValues(typeof(UnitType)))
                        {
                            <option value="@unit">@unit</option>
                        }
                    </select>

                    <!-- قالب للجنسيات -->
                    <select id="nationalityTemplate" class="d-none">
                        <option value="">-- اختر الجنسية --</option>
                        @foreach (var nat in Enum.GetValues(typeof(Nationality)))
                        {
                            <option value="@nat">@nat</option>
                        }
                    </select>

                    <!-- مكان الرسائل في الـView -->
                    <div id="alertBox" class="alert d-none" role="alert">
                        <span id="alertMessage"></span>
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>


                    <div class="row g-4">
                        <!-- العمود الأول: البيانات الأساسية (1/3 من العرض) -->
                        <div class="col-md-4">
                            <div class="form-check form-switch mb-2">
                                <input asp-for="IsTemp" class="form-check-input" type="checkbox" />
                                <label class="form-check-label fw-bold" asp-for="IsTemp">تصريح مؤقت</label>
                                <span asp-validation-for="IsTemp" class="text-danger"></span>
                            </div>


                            <div class="mb-sm-3">
                                <input asp-for="No" class="form-control text-center" placeholder="رقم التصريح" readonly required
                                       style="font-size: 1.5rem; font-weight: bold; color: #fd7e14; background-color: #fff8f3; border: 2px solid #fd7e14;" />
                                <div class="error-message text-center">هذا الحقل مطلوب</div>
                            </div>

                            <div class="mb-sm-3">
                                <label asp-for="Date" class="form-label fw-bold">تاريخ التصريح</label>
                                <div class="row g-2">
                                    <div class="col-7">
                                        <input asp-for="Date" type="date" class="form-control" placeholder="التاريخ" />
                                        <div class="error-message">هذا الحقل مطلوب</div>
                                    </div>
                                    <div class="col-5">
                                        <input asp-for="HourOfEntry" type="time" class="form-control" placeholder="الوقت" />
                                    </div>
                                </div>
                            </div>
                            <div class="mb-sm-3">
                                <label asp-for="Type" class="form-label fw-bold">نوع التصريح</label>
                              
                                <select asp-for="Type" class="form-select">
                                    <option value="">-- اختر نوع التصريح --</option>
                                    @foreach (var type in Enum.GetValues(typeof(Core.Enums.BaseEnums.EnumPermitType)).Cast<Core.Enums.BaseEnums.EnumPermitType>())
                                    {
                                        <option value="@type">@type.GetDescription()</option>
                                    }
                                </select>
                               
                                <div class="error-message">هذا الحقل مطلوب</div>
                            </div>

                          

                            <div class="mb-sm-3">
                                <label class="form-label fw-bold">الجهة الطالبة</label>
                                <select asp-for="ReqDepartment" class="form-select"
                                        asp-items="@(new SelectList(Model.Departments, "RespCode", "DepartmentName", Model.ReqDepartment))">
                                </select>
                                <div class="error-message">هذا الحقل مطلوب</div>
                            </div>

                            <div class="mb-sm-3">
                                <label asp-for="OrgDescription" class="form-label fw-bold">وصف الجهة</label>
                                <input asp-for="OrgDescription" name="OrgDescription" id="OrgDescription" class="form-control" placeholder="وصف الجهة" />
                                <div class="error-message">هذا الحقل مطلوب</div>
                            </div>
                            <div class="mb-sm-3">
                                <label class="form-label fw-bold">رقم الهاتف</label>
                                <input asp-for="PhoneNo" class="form-control" placeholder="رقم الهاتف" />
                                <div class="error-message">هذا الحقل مطلوب</div>
                            </div>
                            <div class="mb-sm-3">
                                <label class="form-label fw-bold">قادم من</label>
                                <input asp-for="MoveFrom" class="form-control" placeholder="قادم من" />
                                <div class="error-message">هذا الحقل مطلوب</div>
                            </div>
                            <div class="mb-sm-3">
                                <label class="form-label fw-bold">ذاهب إلى</label>
                                <input asp-for="MoveTo" class="form-control" placeholder="ذاهب إلى" />
                                <div class="error-message">هذا الحقل مطلوب</div>
                            </div>

                            <!-- حقل الملاحظات الجديد -->
                            <div class="mb-sm-3">
                                <label class="form-label fw-bold">ملاحظات</label>
                                <textarea name="Notes" class="form-control notes-textarea" placeholder="أدخل الملاحظات هنا..."></textarea>
                            </div>
                        </div>

                    <!-- المواد + السيارات -->
                    <div class="col-md-8">
                        <!-- المواد -->
                        <h5 class="section-title">المواد والمعدات</h5>
                        <div class="table-responsive">
                            <table class="table table-bordered">
                                <thead class="table-light">
                                    <tr>
                                        <th>اسم المادة</th>
                                        <th>الكمية</th>
                                        <th>الوحدة</th>
                                        <th class="text-center">
                                            <button type="button" id="addEquipBtn" class="btn-icon btn-add">
                                                <i class="fas fa-plus"></i>
                                            </button>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody id="equipmentsTableBody">
                                    @for (int i = 0; i < Model.EquipmentsAndMaterials.Count; i++)
                                    {
                                        <tr>
                                            <td>
                                                <input name="EquipmentsAndMaterials[@i].ItemName"
                                                       value="@Model.EquipmentsAndMaterials[i].ItemName"
                                                       class="form-control" required />
                                            </td>
                                            <td>
                                                <input name="EquipmentsAndMaterials[@i].Quantity"
                                                       value="@Model.EquipmentsAndMaterials[i].Quantity"
                                                       type="number" class="form-control" required />
                                            </td>
                                            <td>
                                                    <select asp-for="EquipmentsAndMaterials[@i].Unit"
                                                            class="form-select"
                                                            asp-items="Html.GetEnumSelectList<UnitType>()">
                                                        <option value="">-- اختر الوحدة --</option>
                                                    </select>
                                             
                                            </td>
                                            <td class="text-center">
                                                <button type="button" class="btn-icon btn-delete removeRow">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <!-- السيارات -->
                        <h5 class="section-title">السيارات</h5>
                        <div class="table-responsive">
                            <table class="table table-bordered">
                                <thead class="table-light">
                                    <tr>
                                        <th>رقم السيارة</th>
                                        <th>نوع السيارة</th>
                                        <th>اسم السائق</th>
                                        <th>جنسية السائق</th>
                                        <th>رخصة القيادة</th>
                                        <th class="text-center">
                                            <button type="button" id="addCarBtn" class="btn-icon btn-add">
                                                <i class="fas fa-plus"></i>
                                            </button>
                                        </th>
                                    </tr>
                                </thead>
                                <tbody id="carsTableBody">
                                    @for (int i = 0; i < Model.Cars.Count; i++)
                                    {
                                        <tr>
                                            <td><input name="Cars[@i].CarNo" value="@Model.Cars[i].CarNo" class="form-control" /></td>
                                            <td><input name="Cars[@i].CarType" value="@Model.Cars[i].CarType" class="form-control" /></td>
                                            <td><input name="Cars[@i].DriverName" value="@Model.Cars[i].DriverName" class="form-control" /></td>
                                            <td>
                                                    <select asp-for="Cars[@i].driverNationality"
                                                            class="form-select"
                                                            asp-items="Html.GetEnumSelectList<Nationality>()">
                                                        <option value="">-- اختر الجنسية --</option>
                                                    </select>
                                                
                                            </td>
                                            <td><input name="Cars[@i].licenseNo" value="@Model.Cars[i].licenseNo" class="form-control" /></td>
                                            <td class="text-center">
                                                <button type="button" class="btn-icon btn-delete removeRow">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="mt-4 text-center">
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="fas fa-save"></i> حفظ
                    </button>
                    <a asp-action="Index" class="btn btn-secondary px-4">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    <script>
        $(document).ready(function () {

           

            // السماح فقط بالأرقام والنقطة العشرية
            function isNumberKey(evt) {
                var charCode = (evt.which) ? evt.which : evt.keyCode;
                if (charCode > 31 && (charCode < 48 || charCode > 57) && charCode !== 46) {
                    return false;
                }
                return true;
            }

            // تهيئة حقل الكمية لقبول أرقام موجبة مع نقطة واحدة فقط
            function formatQuantityField(input) {
                $(input).attr({
                    'type': 'text',
                    'min': '1',
                    'step': '0.01',
                    'pattern': '[0-9.]*',
                    'inputmode': 'decimal'
                }).on('keypress input', function (e) {
                    if (!isNumberKey(e)) {
                        e.preventDefault();
                        return false;
                    }
                    var value = $(this).val();
                    if (value.split('.').length > 2) {
                        $(this).val(value.replace(/\.+$/, ""));
                    }
                    if (value !== '' && (isNaN(value) || parseFloat(value) <= 0)) {
                        $(this).val('');
                    }
                });
            }

            // إظهار رسالة باستخدام alertBox جاهز في الـHTML
            function showAlert(message, type) {
                const alertBox = document.getElementById("alertBox");
                const alertMessage = document.getElementById("alertMessage");
                if (!alertBox || !alertMessage) return;
                alertMessage.textContent = message;
                alertBox.className = `alert alert-${type} alert-dismissible fade show`;
                alertBox.classList.remove("d-none");
                setTimeout(() => {
                    alertBox.classList.add("d-none");
                }, 5000);
            }

            // ================= منطق الفورم ===================

            // ملء وصف الجهة بناءً على اختيار الجهة الطالبة
            $('#reqDepartment').change(function () {
                var selectedOption = $(this).find('option:selected');
                var OrgDescription = selectedOption.data('description');
                $('#OrgDescription').val(OrgDescription);
            });

            // التحقق قبل الإرسال
                    $('#permitForm').submit(function (e) {
            var isValid = true;

            // تحقق من الحقول المطلوبة الموجودة فعلاً
            var requiredFields = [
                '#permitType', '#reqDepartment', '#OrgDescription', '#FromLocation', '#ToLocation'
            ];

            requiredFields.forEach(function (selector) {
                var $field = $(selector);
                if ($field.length && (!$field.val() || $field.val() === '')) {
                    $field.addClass('is-invalid');
                    isValid = false;
                } else {
                    $field.removeClass('is-invalid');
                }
            });

            // تحقق من وجود مادة واحدة على الأقل
            if ($('#equipmentsTableBody').length && $('#equipmentsTableBody tr').length === 0) {
                showAlert('يجب إضافة مادة واحدة على الأقل', 'warning');
                isValid = false;
            }

            if (!isValid) {
                e.preventDefault(); // يمنع الإرسال فقط إذا فيه خطأ
            }
        });


            // إزالة حالة الخطأ عند تعديل الحقول المطلوبة
            $('#permitType, #reqDepartment, #OrgDescription, #FromLocation, #ToLocation')
                .on('input change', function () {
                    if ($(this).val() && $(this).val() !== '') {
                        $(this).removeClass('is-invalid');
                    }
                });

            // ================= إضافة/حذف الصفوف ===================

            // إضافة صف مادة
            $("#addEquipBtn").click(function () {
                       var tbody = $("#equipmentsTableBody");
            var index = tbody.children("tr").length;

            var unitOptions = $("#unitTemplate").html();

            var newRow = `
                <tr>
                    <td><input name="EquipmentsAndMaterials[${index}].ItemName" class="form-control" /></td>
                    <td><input name="EquipmentsAndMaterials[${index}].Quantity" class="form-control" /></td>
                    <td>
                        <select name="EquipmentsAndMaterials[${index}].Unit" class="form-select">
                            ${unitOptions}
                        </select>
                    </td>
                    <td><button type="button" class="btn btn-danger removeRow">حذف</button></td>
                </tr>
            `;
            tbody.append(newRow);
        });

            // إضافة صف سيارة
            $("#addCarBtn").click(function () {
                        var tbody = $("#carsTableBody");
            var index = tbody.children("tr").length;

            var nationalityOptions = $("#nationalityTemplate").html();

            var newRow = `
                <tr>
                    <td><input name="Cars[${index}].CarNo" class="form-control" /></td>
                    <td><input name="Cars[${index}].CarType" class="form-control" /></td>
                    <td><input name="Cars[${index}].DriverName" class="form-control" /></td>
                    <td>
                        <select name="Cars[${index}].driverNationality" class="form-select">
                            ${nationalityOptions}
                        </select>
                    </td>
                    <td><input name="Cars[${index}].LicenseNo" class="form-control" /></td>
                    <td><button type="button" class="btn btn-danger removeRow">حذف</button></td>
                </tr>
            `;
            tbody.append(newRow);
        });

            // زر حذف الصف لأي جدول
            $(document).on("click", ".removeRow", function () {
                $(this).closest("tr").fadeOut(300, function () {
                    $(this).remove();
                });
            });

        });
    </script>
</body>
</html>

