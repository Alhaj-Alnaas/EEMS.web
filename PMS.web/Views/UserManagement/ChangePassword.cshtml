@model PMS.web.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "تغيير كلمة المرور";
}
<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <!-- ✅ عرض الرسائل -->
            @if (ViewBag.SuccessMessage != null)
            {
                <div class="alert alert-success alert-dismissible fade show text-center" role="alert">
                    @ViewBag.SuccessMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>

                <script>
                    // ⏳ إعادة التوجيه بعد 3 ثواني
                    setTimeout(function () {
                        window.location.href = '@Url.Action("Index", "Home")';
                    }, 3000);
                </script>
            }

            @if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger alert-dismissible fade show text-center" role="alert">
                    @ViewBag.ErrorMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card shadow-lg border-0 rounded-3">
                <div class="card-header text-white text-center" style="background-color:#343a40;">
                    <h4>🔑 تغيير كلمة المرور</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="ChangePassword" method="post">

                        <!-- كلمة المرور القديمة -->
                        <div class="mb-3 input-group input-group-sm">
                            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                            <input asp-for="OldPassword" class="form-control" type="password" placeholder="كلمة المرور الحالية" />
                            <span asp-validation-for="OldPassword" class="text-danger"></span>
                        </div>

                        <!-- كلمة المرور الجديدة -->
                        <div class="mb-3 input-group input-group-sm">
                            <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                            <input asp-for="NewPassword" id="Password" class="form-control" type="password" placeholder="كلمة المرور الجديدة" />
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>

                        <!-- تأكيد كلمة المرور -->
                        <div class="mb-3 input-group input-group-sm">
                            <span class="input-group-text"><i class="bi bi-key"></i></span>
                            <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="تأكيد كلمة المرور" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <!-- شريط القوة -->
                        <div class="progress mt-2" style="height: 8px;">
                            <div id="passwordStrengthBar" class="progress-bar" role="progressbar" style="width: 0%;"></div>
                        </div>
                        <small id="passwordStrengthText" class="form-text"></small>

                        <!-- زر الحفظ -->
                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-lg text-white"
                                    style="background-color:#fd7e14; border:none;">
                                💾 حفظ التغييرات
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/UserManagement/passwordStrength.js"></script>
    <script>
        // تهيئة فحص قوة كلمة المرور
        document.addEventListener("DOMContentLoaded", function () {
            initPasswordStrength();
        });
    </script>
}



