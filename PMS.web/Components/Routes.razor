@using PMS.web.Components.Layout
@using Microsoft.AspNetCore.Components.Authorization
@inject IConfiguration Configuration

<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        @if (DisableAuthentication)
        {
            <RouteView RouteData="routeData" DefaultLayout="typeof(MainShell)" />
        }
        else
        {
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(MainShell)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
        }
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(MainShell)">
            <div class="text-center p-5">
                <h1 class="display-4">404</h1>
                <p class="lead">الصفحة المطلوبة غير موجودة.</p>
                <a href="/dashboard" class="btn btn-dark">العودة للرئيسية</a>
            </div>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private bool DisableAuthentication =>
        Configuration.GetValue("DesignMode:DisableAuthentication", false);
}
