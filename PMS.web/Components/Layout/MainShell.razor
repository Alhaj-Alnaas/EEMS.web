@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Routing
@using System.Security.Claims
@using Core.Interfaces.Services.Workflow
@using Core.Security
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IServiceScopeFactory ScopeFactory
@inject AuthenticationStateProvider AuthProvider
@inject ILiveNoticeHub Notices
@inject IJSRuntime JS
@implements IDisposable

<div class="pms-main-shell @(_sidebarOpen ? "sidebar-open" : null)" dir="rtl">
    <aside class="sidebar @(_sidebarOpen ? "open" : null)" id="pms-sidebar">
        <div class="logo-details">
            <button type="button" class="sidebar-toggle" @onclick="ToggleSidebar" aria-label="طي/فتح القائمة">
                <i class="fas fa-bars" aria-hidden="true"></i>
            </button>
            <div class="logo-brand">
                <i class="fas fa-id-card icon" aria-hidden="true"></i>
                <div class="logo_name">نظام إدارة التصاريح</div>
            </div>
            <div class="logo-divider" aria-hidden="true"></div>
        </div>

        <ul class="nav-list">
            @foreach (var link in VisibleTopLinks)
            {
                <li>
                    <NavLink href="@MenuHref(link)" class="nav-link-item" Match="@(link.ExactMatch ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                        <i class="@link.Icon" aria-hidden="true"></i>
                        <span class="links_name">@link.NameAr</span>
                    </NavLink>
                    <span class="tooltip">@link.NameAr</span>
                </li>
            }

            @foreach (var group in VisibleGroups)
            {
                <li class="nav-group @(_openGroups.Contains(group.Key) ? "expanded" : null)">
                    <button type="button" class="nav-link-item nav-group-toggle" @onclick="() => ToggleGroup(group.Key)">
                        <i class="@group.Icon" aria-hidden="true"></i>
                        <span class="links_name">@group.Title</span>
                        <i class="fas fa-chevron-down nav-group-chevron" aria-hidden="true"></i>
                    </button>
                    <span class="tooltip">@group.Title</span>
                    <ul class="nav-sublist">
                        @foreach (var item in group.Items)
                        {
                            <li>
                                <NavLink href="@MenuHref(item)" class="nav-link-item sub" Match="@(item.ExactMatch ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                                    <i class="@item.Icon" aria-hidden="true"></i>
                                    <span class="links_name">@item.NameAr</span>
                                </NavLink>
                            </li>
                        }
                    </ul>
                </li>
            }
        </ul>

        <div class="pms-profile-dock">
            <div class="pms-profile-name" title="@_userDisplayName">@_userDisplayName</div>
            <div class="pms-profile-role" title="@_userRoleLine">@_userRoleLine</div>
            @if (!string.IsNullOrWhiteSpace(_selectedGateLabel))
            {
                <div class="pms-profile-gate" title="@_selectedGateLabel">
                    <i class="fas fa-door-open" aria-hidden="true"></i> @_selectedGateLabel
                </div>
            }
            <div class="pms-profile-actions-bar">
                @if (!_designMode)
                {
                    <a href="@ReturnUrl.Go(Navigation, "/account/change-password")" class="pms-action-btn" title="تغيير كلمة المرور">
                        <i class="fa fa-key" aria-hidden="true"></i>
                    </a>
                    <a href="/logout" data-enhance-nav="false" class="pms-action-btn pms-action-btn-danger" title="تسجيل خروج">
                        <i class="fa fa-power-off" aria-hidden="true"></i>
                    </a>
                }
                else
                {
                    <span class="pms-design-badge" title="وضع التصميم — تسجيل الدخول معطّل">تصميم</span>
                }
            </div>
        </div>
    </aside>

    <section class="home-section">
        <div class="home-section-content">
            <AppTitleBar LogoUrl="/images/lisco-logo.png"
                         UnreadCount="@_unreadNotifications"
                         OnNotificationsClick="OpenNotifications" />
            <div class="pms-home-body">
                @Body
            </div>
        </div>
    </section>
</div>

@code {
    private bool _sidebarOpen = true;
    private bool _designMode;
    private string _userDisplayName = "زائر";
    private string _userRoleLine = "";
    private string _selectedGateLabel = "";

    private readonly HashSet<string> _openGroups = new(StringComparer.OrdinalIgnoreCase);
    private HashSet<string> _allowedTasks = new(StringComparer.OrdinalIgnoreCase);
    private int _unreadNotifications;
    private string? _userId;
    private readonly CancellationTokenSource _noticesStop = new();

    protected override void OnInitialized()
    {
        _designMode = Configuration.GetValue("DesignMode:DisableAuthentication", false);
        if (_designMode)
        {
            _userDisplayName = "وضع التصميم";
            _userRoleLine = "بدون مصادقة";
        }

        Navigation.LocationChanged += OnLocationChanged;
        ExpandGroupForCurrentPath(Navigation.ToBaseRelativePath(Navigation.Uri));
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        Notices.Published += OnNotice;
        await LoadProfileAsync();
        await RefreshUnreadAsync();
        _ = WatchNoticesAsync(_noticesStop.Token);
    }

    private void OnNotice(LiveNotice notice)
    {
        if (string.IsNullOrEmpty(_userId) || !string.Equals(notice.UserId, _userId, StringComparison.Ordinal))
            return;

        _ = InvokeAsync(async () =>
        {
            await RefreshUnreadAsync();
            var text = string.IsNullOrWhiteSpace(notice.Body) ? notice.Title : notice.Body;
            var kind = notice.Title.Contains("رفض") ? "danger"
                : notice.Title.Contains("إرجاع") || notice.Title.Contains("إغلاق") || notice.Title.Contains("إلغاء")
                    ? "warning"
                    : "info";
            try
            {
                await JS.InvokeVoidAsync("pmsToast.show", text, kind, 8000);
            }
            catch
            {
                // The screen closed before the toast could appear.
            }

            StateHasChanged();
        });
    }

    private async Task WatchNoticesAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(async () =>
                {
                    await RefreshUnreadAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task LoadProfileAsync()
    {
        if (_designMode) return;

        try
        {
            var auth = await AuthProvider.GetAuthenticationStateAsync();
            var user = auth.User;
            if (user.Identity?.IsAuthenticated != true)
            {
                _userDisplayName = "زائر";
                _userRoleLine = "";
                _selectedGateLabel = "";
                _allowedTasks = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
                return;
            }

            var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (!string.IsNullOrEmpty(userId))
            {
                using var scope = ScopeFactory.CreateScope();
                var access = scope.ServiceProvider.GetRequiredService<IUserAccessService>();
                var codes = await access.GetTaskCodesForUserAsync(userId);
                _allowedTasks = new HashSet<string>(codes, StringComparer.OrdinalIgnoreCase);
            }

            _userDisplayName =
                user.FindFirst(SystemTaskCodes.FullNameClaimType)?.Value
                ?? user.FindFirst(ClaimTypes.Name)?.Value
                ?? user.Identity?.Name
                ?? "مستخدم";

            var accessLevel = user.FindFirst(SystemTaskCodes.AccessLevelNameClaimType)?.Value;
            var jobTitle = user.FindFirst(SystemTaskCodes.JobTitleClaimType)?.Value;
            _userRoleLine = !string.IsNullOrWhiteSpace(accessLevel)
                ? accessLevel!
                : (!string.IsNullOrWhiteSpace(jobTitle) ? jobTitle! : "مستخدم النظام");

            _selectedGateLabel = user.FindFirst(SystemTaskCodes.SelectedGateNameClaimType)?.Value ?? "";
        }
        catch
        {
            _userDisplayName = "مستخدم";
            _userRoleLine = "";
            _selectedGateLabel = "";
            _allowedTasks = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        }
    }

    private bool CanSee(SystemTaskDefinition item) =>
        _designMode || _allowedTasks.Contains(item.Code);

    private IEnumerable<SystemTaskDefinition> VisibleTopLinks =>
        SystemTaskCatalog.TopLinks.Where(CanSee);

    private IEnumerable<SystemMenuGroup> VisibleGroups =>
        SystemTaskCatalog.Groups
            .Select(group => group with { Items = group.Items.Where(CanSee).ToList() })
            .Where(group => group.Items.Count > 0);

    private void OpenNotifications() => Navigation.NavigateTo("/notifications");

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ExpandGroupForCurrentPath(Navigation.ToBaseRelativePath(e.Location));
        _ = InvokeAsync(async () =>
        {
            await LoadProfileAsync();
            await RefreshUnreadAsync();
            StateHasChanged();
        });
    }

    private async Task RefreshUnreadAsync()
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var notifications = scope.ServiceProvider.GetRequiredService<INotificationService>();
            var auth = await AuthProvider.GetAuthenticationStateAsync();
            var userId = auth.User.Identity?.IsAuthenticated == true
                ? auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value
                : null;

            if (!string.IsNullOrEmpty(userId))
                _unreadNotifications = await notifications.GetUnreadCountAsync(userId);
            else
                _unreadNotifications = (await notifications.GetRecentAsync(50, unreadOnly: true)).Count;
        }
        catch
        {
            _unreadNotifications = 0;
        }
    }

    private void ExpandGroupForCurrentPath(string path)
    {
        var current = NormalizePath(path);
        foreach (var group in SystemTaskCatalog.Groups)
        {
            if (group.Items.Any(item => RouteMatches(item.Route, current)))
                _openGroups.Add(group.Key);
        }
    }

    private static string NormalizePath(string path)
    {
        var query = path.IndexOf('?');
        if (query >= 0)
            path = path[..query];
        path = "/" + path.Trim().TrimStart('/');
        return path.Length > 1 ? path.TrimEnd('/') : path;
    }

    private static bool RouteMatches(string? route, string path)
    {
        if (string.IsNullOrWhiteSpace(route))
            return false;
        return string.Equals(path, route, StringComparison.OrdinalIgnoreCase)
            || path.StartsWith(route + "/", StringComparison.OrdinalIgnoreCase);
    }

    private string MenuHref(SystemTaskDefinition item)
    {
        var route = item.Route ?? "/";
        return route.Contains("/create", StringComparison.OrdinalIgnoreCase)
            ? ReturnUrl.Go(Navigation, route)
            : route;
    }

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;

    private void ToggleGroup(string key)
    {
        EnsureSidebarOpen();
        if (!_openGroups.Add(key))
            _openGroups.Remove(key);
    }

    private void EnsureSidebarOpen()
    {
        if (!_sidebarOpen)
            _sidebarOpen = true;
    }

    public void Dispose()
    {
        Notices.Published -= OnNotice;
        _noticesStop.Cancel();
        _noticesStop.Dispose();
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
