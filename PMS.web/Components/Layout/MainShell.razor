@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Routing
@using System.Security.Claims
@using Core.Interfaces.Services.Workflow
@using Core.Security
@inject NavigationManager Navigation
@inject IConfiguration Configuration
@inject IServiceScopeFactory ScopeFactory
@inject AuthenticationStateProvider AuthProvider
@inject ILiveNoticeHub Notices
@inject IJSRuntime JS
@implements IDisposable

<div class="pms-main-shell @(_sidebarOpen ? "sidebar-open" : null)" dir="rtl">
    <aside class="sidebar @(_sidebarOpen ? "open" : null)" id="pms-sidebar">
        <div class="logo-details">
            <button type="button" class="sidebar-toggle" @onclick="ToggleSidebar" aria-label="طي/فتح القائمة">
                <i class="fas fa-bars" aria-hidden="true"></i>
            </button>
            <div class="logo-brand">
                <i class="fas fa-id-card icon" aria-hidden="true"></i>
                <div class="logo_name">نظام إدارة التصاريح</div>
            </div>
            <div class="logo-divider" aria-hidden="true"></div>
        </div>

        <ul class="nav-list">
            @* —— 1. الرئيسية —— *@
            <li>
                <NavLink href="/dashboard" class="nav-link-item" Match="NavLinkMatch.All">
                    <i class="fas fa-home" aria-hidden="true"></i>
                    <span class="links_name">الرئيسية</span>
                </NavLink>
                <span class="tooltip">الرئيسية</span>
            </li>

            @* —— 2. التصاريح —— *@
            <li class="nav-group @(_openPermits ? "expanded" : null)">
                <button type="button" class="nav-link-item nav-group-toggle" @onclick="TogglePermits">
                    <i class="fas fa-file-signature" aria-hidden="true"></i>
                    <span class="links_name">التصاريح</span>
                    <i class="fas fa-chevron-down nav-group-chevron" aria-hidden="true"></i>
                </button>
                <span class="tooltip">التصاريح</span>
                <ul class="nav-sublist">
                    <li>
                        <NavLink href="/permits" class="nav-link-item sub" Match="NavLinkMatch.All">
                            <i class="fas fa-list" aria-hidden="true"></i>
                            <span class="links_name">قائمة التصاريح</span>
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="@ReturnUrl.Go(Navigation, "/permits/employee/create")" class="nav-link-item sub" Match="NavLinkMatch.Prefix">
                            <i class="fas fa-user-check" aria-hidden="true"></i>
                            <span class="links_name">إصدار تصريح موظف</span>
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="/permits/labor" class="nav-link-item sub" Match="NavLinkMatch.Prefix">
                            <i class="fas fa-helmet-safety" aria-hidden="true"></i>
                            <span class="links_name">تصاريح العمالة</span>
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="@ReturnUrl.Go(Navigation, "/permits/visitors/create")" class="nav-link-item sub" Match="NavLinkMatch.Prefix">
                            <i class="fas fa-user-tag" aria-hidden="true"></i>
                            <span class="links_name">تصريح زوار</span>
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="@ReturnUrl.Go(Navigation, "/permits/materials/create")" class="nav-link-item sub" Match="NavLinkMatch.Prefix">
                            <i class="fas fa-boxes" aria-hidden="true"></i>
                            <span class="links_name">تصريح مواد</span>
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="@ReturnUrl.Go(Navigation, "/permits/vehicles/create")" class="nav-link-item sub" Match="NavLinkMatch.Prefix">
                            <i class="fas fa-truck" aria-hidden="true"></i>
                            <span class="links_name">تصريح مركبات</span>
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="/permits/approve" class="nav-link-item sub" Match="NavLinkMatch.Prefix">
                            <i class="fas fa-stamp" aria-hidden="true"></i>
                            <span class="links_name">اعتماد تصريح</span>
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="/permits/execute" class="nav-link-item sub" Match="NavLinkMatch.Prefix">
                            <i class="fas fa-qrcode" aria-hidden="true"></i>
                            <span class="links_name">تنفيذ تصريح</span>
                        </NavLink>
                    </li>
                </ul>
            </li>

            @* —— 3. التقارير والمتابعة —— *@
            <li class="nav-group @(_openReports ? "expanded" : null)">
                <button type="button" class="nav-link-item nav-group-toggle" @onclick="ToggleReports">
                    <i class="fas fa-chart-line" aria-hidden="true"></i>
                    <span class="links_name">التقارير والمتابعة</span>
                    <i class="fas fa-chevron-down nav-group-chevron" aria-hidden="true"></i>
                </button>
                <span class="tooltip">التقارير والمتابعة</span>
                <ul class="nav-sublist">
                    <li>
                        <NavLink href="/reports/active-permits" class="nav-link-item sub" Match="NavLinkMatch.Prefix">
                            <i class="fas fa-bolt" aria-hidden="true"></i>
                            <span class="links_name">التصاريح النشطة</span>
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="/reports/open-permits" class="nav-link-item sub" Match="NavLinkMatch.Prefix">
                            <i class="fas fa-hourglass-split" aria-hidden="true"></i>
                            <span class="links_name">تصاريح مفتوحة</span>
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="/movements" class="nav-link-item sub" Match="NavLinkMatch.Prefix">
                            <i class="fas fa-exchange-alt" aria-hidden="true"></i>
                            <span class="links_name">سجل الحركة</span>
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="/devices/monitor" class="nav-link-item sub" Match="NavLinkMatch.Prefix">
                            <i class="fas fa-heartbeat" aria-hidden="true"></i>
                            <span class="links_name">حالة الأجهزة</span>
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="/reports/attendance" class="nav-link-item sub" Match="NavLinkMatch.Prefix">
                            <i class="fas fa-user-clock" aria-hidden="true"></i>
                            <span class="links_name">تقارير الحضور</span>
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="/reports/audit-log" class="nav-link-item sub" Match="NavLinkMatch.Prefix">
                            <i class="fas fa-clipboard-list" aria-hidden="true"></i>
                            <span class="links_name">سجل التدقيق</span>
                        </NavLink>
                    </li>
                </ul>
            </li>

            @* —— 4. الإدارة —— *@
            <li class="nav-group @(_openAdmin ? "expanded" : null)">
                <button type="button" class="nav-link-item nav-group-toggle" @onclick="ToggleAdmin">
                    <i class="fas fa-cogs" aria-hidden="true"></i>
                    <span class="links_name">الإدارة</span>
                    <i class="fas fa-chevron-down nav-group-chevron" aria-hidden="true"></i>
                </button>
                <span class="tooltip">الإدارة</span>
                <ul class="nav-sublist">
                    <li>
                        <NavLink href="/devices/readers" class="nav-link-item sub" Match="NavLinkMatch.Prefix">
                            <i class="fas fa-fingerprint" aria-hidden="true"></i>
                            <span class="links_name">إدارة القارئات</span>
                        </NavLink>
                    </li>
                    @* مؤقتاً: إخفاء استيراد البصمات من القائمة
                    <li>
                        <NavLink href="/devices/biometrics" class="nav-link-item sub" Match="NavLinkMatch.Prefix">
                            <i class="fas fa-id-badge" aria-hidden="true"></i>
                            <span class="links_name">استيراد البصمات</span>
                        </NavLink>
                    </li>
                    *@
                    <li>
                        <NavLink href="/employees" class="nav-link-item sub" Match="NavLinkMatch.Prefix">
                            <i class="fas fa-users" aria-hidden="true"></i>
                            <span class="links_name">الموظفون</span>
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="/admin/gates" class="nav-link-item sub" Match="NavLinkMatch.Prefix">
                            <i class="fas fa-door-open" aria-hidden="true"></i>
                            <span class="links_name">إدارة البوابات</span>
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="/access/permissions" class="nav-link-item sub" Match="NavLinkMatch.Prefix">
                            <i class="fas fa-key" aria-hidden="true"></i>
                            <span class="links_name">إدارة صلاحيات الدخول</span>
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="/admin/workflows" class="nav-link-item sub" Match="NavLinkMatch.Prefix">
                            <i class="fas fa-project-diagram" aria-hidden="true"></i>
                            <span class="links_name">إعدادات التصريح</span>
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="/admin/access-levels" class="nav-link-item sub" Match="NavLinkMatch.Prefix">
                            <i class="fas fa-shield-alt" aria-hidden="true"></i>
                            <span class="links_name">مستويات الدخول</span>
                        </NavLink>
                    </li>
                    <li>
                        <NavLink href="/admin/users" class="nav-link-item sub" Match="NavLinkMatch.Prefix">
                            <i class="fas fa-user-cog" aria-hidden="true"></i>
                            <span class="links_name">إدارة المستخدمين</span>
                        </NavLink>
                    </li>
                </ul>
            </li>
        </ul>

        <div class="pms-profile-dock">
            <div class="pms-profile-name" title="@_userDisplayName">@_userDisplayName</div>
            <div class="pms-profile-role" title="@_userRoleLine">@_userRoleLine</div>
            @if (!string.IsNullOrWhiteSpace(_selectedGateLabel))
            {
                <div class="pms-profile-gate" title="@_selectedGateLabel">
                    <i class="fas fa-door-open" aria-hidden="true"></i> @_selectedGateLabel
                </div>
            }
            <div class="pms-profile-actions-bar">
                @if (!_designMode)
                {
                    <a href="@ReturnUrl.Go(Navigation, "/account/change-password")" class="pms-action-btn" title="تغيير كلمة المرور">
                        <i class="fa fa-key" aria-hidden="true"></i>
                    </a>
                    <a href="/logout" data-enhance-nav="false" class="pms-action-btn pms-action-btn-danger" title="تسجيل خروج">
                        <i class="fa fa-power-off" aria-hidden="true"></i>
                    </a>
                }
                else
                {
                    <span class="pms-design-badge" title="وضع التصميم — تسجيل الدخول معطّل">تصميم</span>
                }
            </div>
        </div>
    </aside>

    <section class="home-section">
        <div class="home-section-content">
            <AppTitleBar LogoUrl="/images/lisco-logo.png"
                         UnreadCount="@_unreadNotifications"
                         OnNotificationsClick="OpenNotifications" />
            <div class="pms-home-body">
                @Body
            </div>
        </div>
    </section>
</div>

@code {
    private bool _sidebarOpen = true;
    private bool _designMode;
    private string _userDisplayName = "زائر";
    private string _userRoleLine = "";
    private string _selectedGateLabel = "";

    private bool _openPermits;
    private bool _openReports;
    private bool _openAdmin;
    private int _unreadNotifications;
    private string? _userId;
    private readonly CancellationTokenSource _noticesStop = new();

    protected override void OnInitialized()
    {
        _designMode = Configuration.GetValue("DesignMode:DisableAuthentication", false);
        if (_designMode)
        {
            _userDisplayName = "وضع التصميم";
            _userRoleLine = "بدون مصادقة";
        }

        Navigation.LocationChanged += OnLocationChanged;
        ExpandGroupForCurrentPath(Navigation.ToBaseRelativePath(Navigation.Uri));
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        Notices.Published += OnNotice;
        await LoadProfileAsync();
        await RefreshUnreadAsync();
        _ = WatchNoticesAsync(_noticesStop.Token);
    }

    private void OnNotice(LiveNotice notice)
    {
        if (string.IsNullOrEmpty(_userId) || !string.Equals(notice.UserId, _userId, StringComparison.Ordinal))
            return;

        _ = InvokeAsync(async () =>
        {
            await RefreshUnreadAsync();
            var text = string.IsNullOrWhiteSpace(notice.Body) ? notice.Title : notice.Body;
            var kind = notice.Title.Contains("رفض") ? "danger"
                : notice.Title.Contains("إرجاع") || notice.Title.Contains("إغلاق") || notice.Title.Contains("إلغاء")
                    ? "warning"
                    : "info";
            try
            {
                await JS.InvokeVoidAsync("pmsToast.show", text, kind, 8000);
            }
            catch
            {
                // The screen closed before the toast could appear.
            }

            StateHasChanged();
        });
    }

    private async Task WatchNoticesAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(15));
        try
        {
            while (await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(async () =>
                {
                    await RefreshUnreadAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task LoadProfileAsync()
    {
        if (_designMode) return;

        try
        {
            var auth = await AuthProvider.GetAuthenticationStateAsync();
            var user = auth.User;
            if (user.Identity?.IsAuthenticated != true)
            {
                _userDisplayName = "زائر";
                _userRoleLine = "";
                _selectedGateLabel = "";
                return;
            }

            _userDisplayName =
                user.FindFirst(SystemTaskCodes.FullNameClaimType)?.Value
                ?? user.FindFirst(ClaimTypes.Name)?.Value
                ?? user.Identity?.Name
                ?? "مستخدم";

            var accessLevel = user.FindFirst(SystemTaskCodes.AccessLevelNameClaimType)?.Value;
            var jobTitle = user.FindFirst(SystemTaskCodes.JobTitleClaimType)?.Value;
            _userRoleLine = !string.IsNullOrWhiteSpace(accessLevel)
                ? accessLevel!
                : (!string.IsNullOrWhiteSpace(jobTitle) ? jobTitle! : "مستخدم النظام");

            _selectedGateLabel = user.FindFirst(SystemTaskCodes.SelectedGateNameClaimType)?.Value ?? "";
        }
        catch
        {
            _userDisplayName = "مستخدم";
            _userRoleLine = "";
            _selectedGateLabel = "";
        }
    }

    private void OpenNotifications() => Navigation.NavigateTo("/notifications");

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ExpandGroupForCurrentPath(Navigation.ToBaseRelativePath(e.Location));
        _ = InvokeAsync(async () =>
        {
            await LoadProfileAsync();
            await RefreshUnreadAsync();
            StateHasChanged();
        });
    }

    private async Task RefreshUnreadAsync()
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var notifications = scope.ServiceProvider.GetRequiredService<INotificationService>();
            var auth = await AuthProvider.GetAuthenticationStateAsync();
            var userId = auth.User.Identity?.IsAuthenticated == true
                ? auth.User.FindFirst(ClaimTypes.NameIdentifier)?.Value
                : null;

            if (!string.IsNullOrEmpty(userId))
                _unreadNotifications = await notifications.GetUnreadCountAsync(userId);
            else
                _unreadNotifications = (await notifications.GetRecentAsync(50, unreadOnly: true)).Count;
        }
        catch
        {
            _unreadNotifications = 0;
        }
    }

    private void ExpandGroupForCurrentPath(string path)
    {
        path = path.TrimStart('/');
        if (path.StartsWith("permits", StringComparison.OrdinalIgnoreCase))
            _openPermits = true;
        else if (path.StartsWith("reports", StringComparison.OrdinalIgnoreCase)
                 || path.StartsWith("movements", StringComparison.OrdinalIgnoreCase)
                 || path.StartsWith("devices/monitor", StringComparison.OrdinalIgnoreCase))
            _openReports = true;
        else if (path.StartsWith("admin", StringComparison.OrdinalIgnoreCase)
                 || path.StartsWith("devices/readers", StringComparison.OrdinalIgnoreCase)
                 || path.StartsWith("devices/biometrics", StringComparison.OrdinalIgnoreCase)
                 || path.StartsWith("employees", StringComparison.OrdinalIgnoreCase)
                 || path.StartsWith("access", StringComparison.OrdinalIgnoreCase))
            _openAdmin = true;
    }

    private void ToggleSidebar() => _sidebarOpen = !_sidebarOpen;

    private void TogglePermits()
    {
        EnsureSidebarOpen();
        _openPermits = !_openPermits;
    }

    private void ToggleReports()
    {
        EnsureSidebarOpen();
        _openReports = !_openReports;
    }

    private void ToggleAdmin()
    {
        EnsureSidebarOpen();
        _openAdmin = !_openAdmin;
    }

    private void EnsureSidebarOpen()
    {
        if (!_sidebarOpen)
            _sidebarOpen = true;
    }

    public void Dispose()
    {
        Notices.Published -= OnNotice;
        _noticesStop.Cancel();
        _noticesStop.Dispose();
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
