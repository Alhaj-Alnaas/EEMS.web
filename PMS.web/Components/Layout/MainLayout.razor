@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization

<CascadingAuthenticationState>
    <header>
        <NavMenu />
    </header>

    <div class="container-fluid pms-content">
        <main role="main" class="pb-5">
            @Body
        </main>
    </div>

    <footer class="border-top footer text-muted mt-auto py-3">
        <div class="container text-center small">
            &copy; @DateTime.Now.Year - نظام إدارة التصاريح الموحد (PMS) - المرحلة الأولى والثانية
        </div>
    </footer>

    <div class="bottom-bar">
        <div class="user-info-bottom">
            <AuthorizeView>
                <Authorized>
                    <i class="bi bi-person-circle"></i>
                    <span>نظام إدارة التصاريح الموحد :: @context.User.Identity?.Name</span>
                </Authorized>
                <NotAuthorized>
                    <span>نظام إدارة التصاريح الموحد</span>
                </NotAuthorized>
            </AuthorizeView>
        </div>
    </div>
</CascadingAuthenticationState>
