@page "/reports/active-permits"
@rendermode InteractiveServer
@inject IPermitExecutionService Execution
@inject IDepartmentService DepartmentService
@inject NavigationManager Navigation
@using Core.Common

<PageTitle>التصاريح النشطة - PMS</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h3 class="mb-0"><i class="bi bi-bolt text-warning"></i> التصاريح النشطة</h3>
</div>

<p class="text-muted">التصاريح المعتمدة الظاهرة للمتابعة على كل البوابات.</p>

@if (!string.IsNullOrEmpty(loadError))
{
    <div class="alert alert-danger">@loadError</div>
}

@if (loading)
{
    <div class="text-center p-5"><div class="spinner-border text-warning"></div></div>
}
else if (rows.Count == 0)
{
    <div class="pms-placeholder">
        <i class="bi bi-inbox"></i>
        <h5>لا توجد تصاريح نشطة</h5>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>رقم التصريح</th>
                        <th>نوع التصريح</th>
                        <th>الغرض</th>
                        <th>الجهة الطالبة</th>
                        <th>التاريخ</th>
                        <th>نطاق التنفيذ</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in rows)
                    {
                        <tr>
                            <td class="fw-bold">@row.Permit.no</td>
                            <td>@TypeLabel(row.Permit.classification)</td>
                            <td>@(string.IsNullOrWhiteSpace(PermitText.Purpose(row.Permit)) ? "—" : PermitText.Purpose(row.Permit))</td>
                            <td>@DepartmentName(row.Permit.reqDepartment)</td>
                            <td>@row.Permit.date.ToString("yyyy/MM/dd")</td>
                            <td>@row.ExecutionScope</td>
                            <td>
                                <a class="btn btn-sm btn-info" href="@ReturnUrl.Go(Navigation, $"/permits/materials/view/{row.Permit.Id}")">عرض</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private bool loading = true;
    private string? loadError;
    private List<PermitExecutionRow> rows = new();
    private Dictionary<string, string> departmentNames = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            rows = await Execution.GetActivePermitsAsync();
            foreach (var code in rows
                .Select(r => r.Permit.reqDepartment)
                .Where(code => !string.IsNullOrWhiteSpace(code))
                .Select(code => code!.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase))
            {
                var department = await DepartmentService.GetSingleDepartmentByResponsibilityAsync(code);
                departmentNames[code] = string.IsNullOrWhiteSpace(department?.DepartmentName) ? code : department!.DepartmentName;
            }
        }
        catch (Exception ex)
        {
            loadError = "تعذر تحميل التصاريح النشطة: " + ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private string DepartmentName(string? code)
    {
        if (string.IsNullOrWhiteSpace(code))
            return "—";
        return departmentNames.TryGetValue(code.Trim(), out var name) && !string.IsNullOrWhiteSpace(name)
            ? name
            : code;
    }

    private static string TypeLabel(string? classification)
    {
        if (Enum.TryParse<PermitClassification>(classification, out var kind))
            return ApprovalPathCatalog.ClassificationTitle(kind);
        return string.IsNullOrWhiteSpace(classification) ? "—" : classification;
    }
}
