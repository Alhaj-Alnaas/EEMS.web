@page "/reports/open-permits"
@rendermode InteractiveServer
@inject IPermitExecutionService Execution

<PageTitle>تصاريح مفتوحة - PMS</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h3 class="mb-0"><i class="bi bi-hourglass-split text-warning"></i> تصاريح مفتوحة تجاوزت 24 ساعة</h3>
</div>

<p class="text-muted">
    زوار سُجّل دخولهم ولم يُسجل خروجهم، ومركبات الاستخدام الداخلي التي سُجّل خروجها ولم تُسجل عودتها.
</p>

@if (!string.IsNullOrEmpty(loadError))
{
    <div class="alert alert-danger">@loadError</div>
}

@if (loading)
{
    <div class="text-center p-5"><div class="spinner-border text-warning"></div></div>
}
else if (rows.Count == 0)
{
    <div class="pms-placeholder">
        <i class="bi bi-check2-circle"></i>
        <h5>لا توجد تصاريح مفتوحة تجاوزت 24 ساعة</h5>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>رقم التصريح</th>
                        <th>النوع</th>
                        <th>بانتظار</th>
                        <th>منذ</th>
                        <th>المدة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in rows)
                    {
                        <tr>
                            <td class="fw-bold">@row.Number</td>
                            <td>@row.Kind</td>
                            <td>@row.Waiting</td>
                            <td>@row.Since.ToString("yyyy/MM/dd HH:mm")</td>
                            <td>@row.HoursOpen ساعة</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private bool loading = true;
    private string? loadError;
    private List<OpenPermitAlert> rows = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            rows = await Execution.GetOverdueAsync();
        }
        catch (Exception ex)
        {
            loadError = "تعذر تحميل التصاريح المفتوحة: " + ex.Message;
        }
        finally
        {
            loading = false;
        }
    }
}
