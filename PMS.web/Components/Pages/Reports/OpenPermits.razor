@page "/reports/open-permits"
@rendermode InteractiveServer
@inject IPermitExecutionService Execution
@inject IJSRuntime JS

<PageTitle>تصاريح مفتوحة - PMS</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h3 class="mb-0"><i class="bi bi-hourglass-split text-warning"></i> تصاريح مفتوحة</h3>
    <button type="button" class="btn btn-sm pms-permit-view-btn" @onclick="ExportExcelAsync" disabled="@(loading || exporting || rows.Count == 0)">
        <i class="bi bi-file-earmark-excel"></i> ترحيل إلى إكسل
    </button>
</div>

<p class="text-muted">
    زائر دخل ولم يخرج، أو مركبة سجلت خروجاً ولم تسجل دخولها. تظهر هنا إذا تجاوزت 24 ساعة، أو إذا انتهى تاريخ السريان وما زالت معلقة في التنفيذ حتى يعالجها مراقب الأمن.
</p>

@if (!string.IsNullOrEmpty(loadError))
{
    <div class="alert alert-danger">@loadError</div>
}
@if (!string.IsNullOrEmpty(exportError))
{
    <div class="alert alert-danger">@exportError</div>
}

@if (loading)
{
    <div class="text-center p-5"><div class="spinner-border text-warning"></div></div>
}
else if (rows.Count == 0)
{
    <div class="pms-placeholder">
        <i class="bi bi-check2-circle"></i>
            <h5>لا توجد تصاريح مفتوحة معلّقة</h5>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>رقم التصريح</th>
                        <th>النوع</th>
                        <th>بانتظار</th>
                        <th>منذ</th>
                        <th>المدة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in rows)
                    {
                        <tr>
                            <td class="fw-bold">@row.Number</td>
                            <td>@row.Kind</td>
                            <td>@row.Waiting</td>
                            <td>@row.Since.ToString("yyyy/MM/dd HH:mm")</td>
                            <td>@row.HoursOpen ساعة</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private bool loading = true;
    private bool exporting;
    private string? loadError;
    private string? exportError;
    private List<OpenPermitAlert> rows = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            rows = await Execution.GetOverdueAsync();
        }
        catch (Exception ex)
        {
            loadError = "تعذر تحميل التصاريح المفتوحة: " + ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task ExportExcelAsync()
    {
        exportError = null;
        exporting = true;
        try
        {
            var bytes = ExcelSheet.Build(
                "تصاريح مفتوحة",
                new[] { "رقم التصريح", "النوع", "بانتظار", "منذ", "المدة" },
                rows.Select(row => new string?[]
                {
                    row.Number,
                    row.Kind,
                    row.Waiting,
                    row.Since.ToString("yyyy/MM/dd HH:mm"),
                    row.HoursOpen + " ساعة"
                }));
            await FileDownload.SaveAsync(JS, "تصاريح-مفتوحة.xls", bytes);
        }
        catch (Exception ex)
        {
            exportError = "تعذر ترحيل التصاريح المفتوحة إلى إكسل: " + ex.Message;
        }
        finally
        {
            exporting = false;
        }
    }
}
