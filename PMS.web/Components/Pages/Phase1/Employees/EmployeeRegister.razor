    private async Task OnPhotoFileAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        if (file.Size > 5 * 1024 * 1024)
        {
            SetMessage(false, "حجم الصورة يجب ألا يتجاوز 5 ميجابايت.");
            return;
        }

        await using var stream = file.OpenReadStream(5 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        photoBytes = ms.ToArray();
        photoContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType;
        if (cameraOn) await StopCameraAsync();
        await StorePhotoFileAsync();
    }

    private async Task StorePhotoFileAsync()
    {
        if (photoBytes is not { Length: > 0 })
            return;

        var pin = string.IsNullOrWhiteSpace(fileNumber) ? model.FileNumber : fileNumber;
        if (string.IsNullOrWhiteSpace(pin))
        {
            SetMessage(false, "رقم الملف غير متوفر لحفظ الصورة.");
            return;
        }

        var previous = model.PhotoPath;
        var path = await PhotoService.SavePhotoAsync(pin.Trim(), photoBytes, photoContentType);
        if (!string.IsNullOrWhiteSpace(previous)
            && !string.Equals(previous.Split('?', 2)[0], path, StringComparison.OrdinalIgnoreCase))
        {
            PhotoService.TryDeletePhoto(previous);
        }

        model.PhotoPath = path;
        photoPreviewUrl = path + "?t=" + DateTime.Now.Ticks;
        photoRemoved = false;
    }

    private void ApplyDataUrl(string dataUrl)
    {
        var comma = dataUrl.IndexOf(',');
        if (comma < 0) throw new InvalidOperationException("تنسيق الصورة غير صالح");
        var meta = dataUrl[..comma];
        var b64 = dataUrl[(comma + 1)..];
        photoContentType = meta.Contains("image/png") ? "image/png" : "image/jpeg";
        photoBytes = Convert.FromBase64String(b64);
    }

    private async Task SaveRegistrationAsync()
    {
        if (!personnelReady)
            return;

        saving = true;
        try
        {
            model.FileNumber = fileNumber.Trim();
            model.FullName = displayFullName.Trim();
            model.JobTitle = displayJobTitle;
            model.DepartmentName = string.IsNullOrWhiteSpace(displayDepartment) ? model.DepartmentName : displayDepartment;
            model.Phone = displayPhone;
            model.Email = displayEmail;

            if (string.IsNullOrWhiteSpace(model.FileNumber) || string.IsNullOrWhiteSpace(model.FullName))
            {
                SetMessage(false, "بيانات شؤون الأفراد غير مكتملة.");
                return;
            }

            if (photoBytes is { Length: > 0 })
            {
                model.PhotoPath = await PhotoService.SavePhotoAsync(model.FileNumber, photoBytes, photoContentType);
                photoPreviewUrl = model.PhotoPath + "?t=" + DateTime.Now.Ticks;
            }

            if (savedEmployeeId != Guid.Empty)
                model.Id = savedEmployeeId;

            await EmployeeService.UpsertByFileNumberAsync(
                model,
                clearPhoto: photoRemoved && string.IsNullOrWhiteSpace(model.PhotoPath));
            savedEmployeeId = model.Id;

            if (linkMode == "division")
            {
                await DivisionGates.ReplaceAsync(responsibilityCode, selectedGateIds.ToList());
                var people = await EmployeeService.GetAllAsync();
                foreach (var person in people.Where(e => BelongsToDivision(e, responsibilityCode)))
                    await GrantGatesAsync(person.Id, selectedGateIds);
            }
            else
            {
                await GrantGatesAsync(savedEmployeeId, selectedGateIds);
            }

            var readerIds = readers
                .Where(r => selectedGateIds.Contains(r.GateId) && r.IsActive && !r.isDeleted)
                .Select(r => r.Id)
                .Distinct()
                .ToList();
            var queued = readerIds.Count == 0 ? 0 : await DeviceSync.EnrollEmployeeOnReadersAsync(model, readerIds);
            var linkText = linkMode == "division" ? "ورُبط التقسيم بالبوابات المختارة" : "ورُبط الموظف بالبوابات المختارة";
            await NotifyAsync(true, $"تم حفظ البيانات {linkText}. أوامر المزامنة: {queued}.");
        }
        catch (Exception ex)
        {
            SetMessage(false, "فشل الحفظ: " + (ex.InnerException?.Message ?? ex.Message));
        }
        finally
        {
            saving = false;
        }
    }

    private static bool BelongsToDivision(Employee employee, string code)
    {
        if (string.IsNullOrWhiteSpace(code))
            return false;
        var name = employee.DepartmentName ?? employee.Department?.NameAr ?? "";
        return name.Contains(code, StringComparison.Ordinal);
    }

    private async Task GrantGatesAsync(Guid employeeId, IEnumerable<Guid> gateIds)
    {
        var existing = await PermissionService.GetByEmployeeAsync(employeeId);
        foreach (var gateId in gateIds.Distinct())
        {
            var already = existing.Any(p => p.GateId == gateId && p.IsActive && !p.isDeleted);
            if (already)
                continue;
            await PermissionService.GrantAsync(new EmployeePermission
            {
                Id = Guid.NewGuid(),
                EmployeeId = employeeId,
                GateId = gateId,
                IsActive = true,
                ValidFrom = DateTime.Today,
                createdOn = DateTime.Now
            });
        }
    }

