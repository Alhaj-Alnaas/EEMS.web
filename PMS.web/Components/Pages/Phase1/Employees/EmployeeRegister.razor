    private async Task OnPhotoFileAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;
        if (file.Size > 5 * 1024 * 1024)
        {
            SetMessage(false, "حجم الصورة يجب ألا يتجاوز 5 ميجابايت.");
            return;
        }

        await using var stream = file.OpenReadStream(5 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        photoBytes = ms.ToArray();
        photoContentType = string.IsNullOrWhiteSpace(file.ContentType) ? "image/jpeg" : file.ContentType;
        photoPreviewUrl = $"data:{photoContentType};base64,{Convert.ToBase64String(photoBytes)}";
        if (cameraOn) await StopCameraAsync();
    }

    private void ApplyDataUrl(string dataUrl)
    {
        var comma = dataUrl.IndexOf(',');
        if (comma < 0) throw new InvalidOperationException("تنسيق الصورة غير صالح");
        var meta = dataUrl[..comma];
        var b64 = dataUrl[(comma + 1)..];
        photoContentType = meta.Contains("image/png") ? "image/png" : "image/jpeg";
        photoBytes = Convert.FromBase64String(b64);
        photoPreviewUrl = dataUrl;
    }

    private async Task SavePhase1Async()
    {
        saving = true;
        try
        {
            try
            {
                fileNumber = await JS.InvokeAsync<string>("pmsEmpReg.getVal", "regEmpFileNo");
                displayFullName = await JS.InvokeAsync<string>("pmsEmpReg.getVal", "regEmpName");
                displayJobTitle = await JS.InvokeAsync<string>("pmsEmpReg.getVal", "regJobTypeName");
                displayDepartment = await JS.InvokeAsync<string>("pmsEmpReg.getVal", "regDepartment");
                displayJobStatus = await JS.InvokeAsync<string>("pmsEmpReg.getVal", "regJobStatus");
                displayPhone = await JS.InvokeAsync<string>("pmsEmpReg.getVal", "regEmpPhone");
                displayEmail = await JS.InvokeAsync<string>("pmsEmpReg.getVal", "regEmpEmail");

                var addr = await JS.InvokeAsync<string>("pmsEmpReg.getVal", "regAddress");
                var card = await JS.InvokeAsync<string>("pmsEmpReg.getVal", "regCardNumber");
                var nat = await JS.InvokeAsync<string>("pmsEmpReg.getVal", "regNationality");
                var blood = await JS.InvokeAsync<string>("pmsEmpReg.getVal", "regBloodType");
                if (!string.IsNullOrWhiteSpace(addr)) model.Address = addr;
                if (!string.IsNullOrWhiteSpace(card)) model.CardNumber = card;
                if (!string.IsNullOrWhiteSpace(nat)) model.Nationality = nat;
                if (!string.IsNullOrWhiteSpace(blood)) model.BloodType = blood;
            }
            catch (Exception ex)
            {
                SetMessage(false, "تعذر قراءة حقول الشاشة: " + ex.Message);
                return;
            }

            model.FileNumber = fileNumber?.Trim() ?? "";
            model.FullName = displayFullName?.Trim() ?? "";
            model.JobTitle = displayJobTitle;
            model.DepartmentName = displayDepartment;
            model.JobStatus = displayJobStatus;
            model.Phone = displayPhone;
            model.Email = displayEmail;

            if (string.IsNullOrWhiteSpace(model.FileNumber) || string.IsNullOrWhiteSpace(model.FullName))
            {
                SetMessage(false, "اضغط «عرض» أولاً لجلب الاسم والرقم الوظيفي من HR.");
                return;
            }

            // بوابة الجهاز: إلزامية للتسجيل الجديد — التعديل لمكتمل مسبقاً مسموح
            if (!credentialOk && !IsExistingCompleteEdit)
            {
                if (!await EnsureDeviceCredentialAsync(model.FileNumber))
                {
                    SetMessage(false, "لا يمكن حفظ موظف جديد بدون بصمة/كرت على القارئة أولاً.");
                    return;
                }
            }

            if (awaitingCredentialBlock && !IsExistingCompleteEdit)
            {
                SetMessage(false, "أكمل التسجيل على القارئة ثم زامن قبل الحفظ.");
                return;
            }

            // الصورة اختيارية
            if (photoBytes is { Length: > 0 })
            {
                model.PhotoPath = await PhotoService.SavePhotoAsync(model.FileNumber, photoBytes, photoContentType);
                photoPreviewUrl = model.PhotoPath + "?t=" + DateTime.Now.Ticks;
            }

            model.DepartmentId = Guid.TryParse(selectedDepartmentId, out var depId) ? depId : null;

            // التسجيل على الجهاز يتم مسبقاً على القارئة — لا نُرسل أمر تسجيل عند الحفظ
            if (savedEmployeeId != Guid.Empty)
                model.Id = savedEmployeeId;

            var (_, wasUpdate) = await EmployeeService.UpsertByFileNumberAsync(model);

            savedEmployeeId = model.Id;
            hrLoaded = true;
            phase1Saved = true;
            wasCompleteOnLoad = true;

            var action = wasUpdate ? "تعديل" : "حفظ";
            var photoNote = string.IsNullOrWhiteSpace(model.PhotoPath) ? "بدون صورة" : "مع صورة";

            await NotifyAsync(true,
                $"تم {action} البيانات ({photoNote}). الخطوة التالية: اختر البوابات واضغط حفظ ومزامنة");
        }
        catch (Exception ex)
        {
            SetMessage(false, "فشل الحفظ: " + ex.Message);
        }
        finally
        {
            saving = false;
        }
    }

    private async Task SaveActiveStatusAsync()
    {
        if (savedEmployeeId == Guid.Empty)
        {
            SetMessage(false, "احفظ بيانات الموظف أولاً.");
            return;
        }

        saving = true;
        try
        {
            var queued = await EmployeeService.UpdateActiveStatusAsync(savedEmployeeId, model.IsActive);
            var statusText = model.IsActive ? "نشط" : "غير نشط";
            var syncNote = queued > 0
                ? $" وتم إرسال أوامر التحديث إلى {queued} قارئة."
                : " (لا توجد قارئات مسجّلة للمزامنة بعد).";
            SetMessage(true, $"تم تحديث حالة الموظف إلى «{statusText}».{syncNote}");
            await NotifyAsync(true, $"حالة الموظف: {statusText}");
        }
        catch (Exception ex)
        {
            SetMessage(false, "فشل تحديث الحالة: " + ex.Message);
        }
        finally
        {
            saving = false;
        }
    }

    private async Task PrintCardAsync()
    {
        if (!CanPrintFromRegister)
        {
            SetMessage(false, "لا يمكن طباعة الكرت — أكمل وحفظ البيانات الأساسية أولاً.");
            return;
        }

        printing = true;
        try
        {
            await CardService.RecordPrintAsync(savedEmployeeId, null);

            string? photoSrc = null;
            if (photoBytes is { Length: > 0 })
            {
                photoSrc = $"data:{photoContentType};base64,{Convert.ToBase64String(photoBytes)}";
            }
            else if (!string.IsNullOrWhiteSpace(model.PhotoPath))
            {
                photoSrc = PhotoService.TryGetPhotoDataUrl(model.PhotoPath)
                           ?? TryReadPhotoDataUrlFromWebRoot(model.PhotoPath);
            }

            var jobTitle = !string.IsNullOrWhiteSpace(model.JobTitle)
                ? model.JobTitle
                : displayJobTitle;

            var organization = !string.IsNullOrWhiteSpace(model.DepartmentName)
                ? model.DepartmentName
                : displayDepartment;
            if (string.IsNullOrWhiteSpace(organization) && model.DepartmentId is Guid did)
                organization = departments.FirstOrDefault(d => d.Id == did)?.NameAr;

            var html = PMS.web.Helpers.EmployeeCardPrintHtml.Build(
                model.FileNumber,
                model.FullName,
                model.Nationality,
                model.Address,
                jobTitle,
                organization,
                photoSrc,
                bloodType: model.BloodType);

            await JS.InvokeVoidAsync("employeeCamera.printHtml", html);

            if (string.IsNullOrWhiteSpace(photoSrc))
                SetMessage(false, "تم فتح الطباعة بدون صورة. أضف صورة ثم احفظ قبل الطباعة.");
        }
        catch (Exception ex)
        {
            SetMessage(false, "فشل طباعة الكرت: " + ex.Message);
        }
        finally
        {
            printing = false;
        }
    }

    private async Task SaveGatesAsync()
    {
        if (!phase1Saved || savedEmployeeId == Guid.Empty)
        {
            SetMessage(false, "احفظ بيانات الموظف أولاً قبل تحديد البوابات.");
            return;
        }
        if (selectedGateIds.Count == 0)
        {
            SetMessage(false, "اختر بوابة واحدة على الأقل.");
            return;
        }

        syncingGates = true;
        try
        {
            var existing = await PermissionService.GetByEmployeeAsync(savedEmployeeId);
            foreach (var gateId in selectedGateIds)
            {
                var already = existing.Any(p => p.GateId == gateId && p.IsActive && !p.isDeleted);
                if (already) continue;

                await PermissionService.GrantAsync(new EmployeePermission
                {
                    Id = Guid.NewGuid(),
                    EmployeeId = savedEmployeeId,
                    GateId = gateId,
                    IsActive = true,
                    ValidFrom = DateTime.Today,
                    createdOn = DateTime.Now
                });
            }

            var readerIds = readers
                .Where(r => selectedGateIds.Contains(r.GateId) && r.IsActive && !r.isDeleted)
                .Select(r => r.Id)
                .Distinct()
                .ToList();

            var queued = 0;
            if (readerIds.Count > 0)
                queued = await DeviceSync.EnrollEmployeeOnReadersAsync(model, readerIds);

            SetMessage(true,
                $"تم حفظ صلاحيات {selectedGateIds.Count} بوابة. أُرسلت أوامر مزامنة السجل والكرت وقوالب الوجه واليد: {queued}.");
        }
        catch (Exception ex)
        {
            SetMessage(false, "فشل حفظ البوابات: " + ex.Message);
        }
        finally
        {
            syncingGates = false;
        }
    }

    private string? TryReadAssetDataUrl(string relativeUnderWwwRoot)
    {
        try
        {
            var relative = relativeUnderWwwRoot.Replace('\\', '/').TrimStart('/');
            var candidates = new[]
            {
                Path.Combine(HostEnvironment.WebRootPath, relative.Replace('/', Path.DirectorySeparatorChar)),
                Path.Combine(AppContext.BaseDirectory, "wwwroot", relative.Replace('/', Path.DirectorySeparatorChar))
            };

            foreach (var physical in candidates)
            {
                if (!File.Exists(physical)) continue;
                var bytes = File.ReadAllBytes(physical);
                if (bytes.Length == 0) continue;
                var ext = Path.GetExtension(physical).ToLowerInvariant();
                var mime = ext switch
                {
                    ".png" => "image/png",
                    ".webp" => "image/webp",
                    ".gif" => "image/gif",
                    ".svg" => "image/svg+xml",
                    _ => "image/jpeg"
                };
                return $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
            }
            return null;
        }
        catch
        {
            return null;
        }
    }

    private string? TryReadPhotoDataUrlFromWebRoot(string? photoPath)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(photoPath)) return null;
            var relative = photoPath.Split('?', 2)[0].Replace('\\', '/').TrimStart('/');
            if (!relative.StartsWith("uploads/employees/", StringComparison.OrdinalIgnoreCase))
                return null;

            var physical = Path.Combine(HostEnvironment.WebRootPath, relative.Replace('/', Path.DirectorySeparatorChar));
            if (!File.Exists(physical))
            {
                var alt = Path.Combine(AppContext.BaseDirectory, "wwwroot", relative.Replace('/', Path.DirectorySeparatorChar));
                if (File.Exists(alt)) physical = alt;
                else return null;
            }

            var bytes = File.ReadAllBytes(physical);
            if (bytes.Length == 0) return null;
            var ext = Path.GetExtension(physical).ToLowerInvariant();
            var mime = ext switch
            {
                ".png" => "image/png",
                ".webp" => "image/webp",
                ".gif" => "image/gif",
                _ => "image/jpeg"
            };
            return $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
        }
        catch
        {
            return null;
        }
    }

    private void SetMessage(bool ok, string text)
        => _ = NotifyAsync(ok, text);

    private Task NotifyAsync(bool ok, string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return Task.CompletedTask;
        return ok ? Toast.SuccessAsync(text) : Toast.ErrorAsync(text);
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("pmsEmpReg.detach"); } catch { }
        try { await JS.InvokeVoidAsync("employeeCamera.stop"); } catch { }
        dotNetRef?.Dispose();
        dotNetRef = null;
    }
