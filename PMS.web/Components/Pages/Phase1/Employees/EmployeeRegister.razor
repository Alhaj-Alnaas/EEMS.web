    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!jsAttached)
        {
            try
            {
                dotNetRef ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("pmsEmpReg.attach", dotNetRef);
                jsAttached = true;
            }
            catch (JSException) { }
            catch (JSDisconnectedException) { }
        }

        if (jsAttached && pinAutoPending)
        {
            pinAutoPending = false;
            await VerifyAndShowAsync();
        }

        if (!cameraStartPending)
            return;

        cameraStartPending = false;
        try
        {
            var started = await JS.InvokeAsync<bool>("employeeCamera.start", "emp-cam-video");
            if (!cameraOn)
            {
                try { await JS.InvokeVoidAsync("employeeCamera.stop"); } catch { }
                return;
            }
            if (!started)
                throw new InvalidOperationException("لم تُفتح الكاميرا.");
        }
        catch (Exception ex)
        {
            if (cameraOn && ex is not JSDisconnectedException)
            {
                cameraOn = false;
                if (string.IsNullOrEmpty(photoPreviewUrl))
                    photoPreviewUrl = photoBeforeCamera;
                photoBeforeCamera = null;
                SetMessage(false, "تعذر تشغيل الكاميرا: " + CameraErrorText(ex));
            }
        }
        finally
        {
            cameraBusy = false;
            await InvokeAsync(StateHasChanged);
        }
    }

