            }

            model.DepartmentId = Guid.TryParse(selectedDepartmentId, out var depId) ? depId : null;

            // التسجيل على الجهاز يتم مسبقاً على القارئة — لا نُرسل أمر تسجيل عند الحفظ
            if (savedEmployeeId != Guid.Empty)
