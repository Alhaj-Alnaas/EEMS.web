    private async Task SaveGatesAsync()
    {
        if (!phase1Saved || savedEmployeeId == Guid.Empty)
        {
            SetMessage(false, "احفظ بيانات الموظف أولاً قبل تحديد البوابات.");
            return;
        }
        if (selectedGateIds.Count == 0)
        {
            SetMessage(false, "اختر بوابة واحدة على الأقل.");
            return;
        }

        syncingGates = true;
        try
        {
            var existing = await PermissionService.GetByEmployeeAsync(savedEmployeeId);
            foreach (var gateId in selectedGateIds)
            {
                var already = existing.Any(p => p.GateId == gateId && p.IsActive && !p.isDeleted);
                if (already) continue;

                await PermissionService.GrantAsync(new EmployeePermission
                {
                    Id = Guid.NewGuid(),
                    EmployeeId = savedEmployeeId,
                    GateId = gateId,
                    IsActive = true,
                    ValidFrom = DateTime.Today,
                    createdOn = DateTime.Now
                });
            }

            var readerIds = readers
                .Where(r => selectedGateIds.Contains(r.GateId) && r.IsActive && !r.isDeleted)
                .Select(r => r.Id)
                .Distinct()
                .ToList();

            var queued = 0;
            if (readerIds.Count > 0)
                queued = await DeviceSync.EnrollEmployeeOnReadersAsync(model, readerIds);

            SetMessage(true,
                $"تم حفظ صلاحيات {selectedGateIds.Count} بوابة. أُرسلت أوامر مزامنة السجل والكرت وقوالب الوجه واليد: {queued}.");
        }
        catch (Exception ex)
        {
            SetMessage(false, "فشل حفظ البوابات: " + ex.Message);
        }
        finally
        {
            syncingGates = false;
        }
    }

    private string? TryReadAssetDataUrl(string relativeUnderWwwRoot)
    {
        try
        {
            var relative = relativeUnderWwwRoot.Replace('\\', '/').TrimStart('/');
            var candidates = new[]
            {
                Path.Combine(HostEnvironment.WebRootPath, relative.Replace('/', Path.DirectorySeparatorChar)),
                Path.Combine(AppContext.BaseDirectory, "wwwroot", relative.Replace('/', Path.DirectorySeparatorChar))
            };

            foreach (var physical in candidates)
            {
                if (!File.Exists(physical)) continue;
                var bytes = File.ReadAllBytes(physical);
                if (bytes.Length == 0) continue;
                var ext = Path.GetExtension(physical).ToLowerInvariant();
                var mime = ext switch
                {
                    ".png" => "image/png",
                    ".webp" => "image/webp",
                    ".gif" => "image/gif",
                    ".svg" => "image/svg+xml",
                    _ => "image/jpeg"
                };
                return $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
            }
            return null;
        }
        catch
        {
            return null;
        }
    }

    private static bool IsImagesFolderPhoto(string relative)
    {
        var parts = relative.Split('/');
        if (parts.Length != 3 || !parts[0].Equals("images", StringComparison.OrdinalIgnoreCase))
            return false;
        if (parts[1].Length == 0 || parts[2].Length == 0 || relative.Contains("..", StringComparison.Ordinal))
            return false;
        return parts[1].All(c => char.IsLetterOrDigit(c) || c is '-' or '_');
    }

    private string? TryReadPhotoDataUrlFromWebRoot(string? photoPath)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(photoPath)) return null;
            var relative = photoPath.Split('?', 2)[0].Replace('\\', '/').TrimStart('/');
            if (!relative.StartsWith("uploads/employees/", StringComparison.OrdinalIgnoreCase)
                && !IsImagesFolderPhoto(relative))
                return null;

            var physical = Path.Combine(HostEnvironment.WebRootPath, relative.Replace('/', Path.DirectorySeparatorChar));
            if (!File.Exists(physical))
            {
                var alt = Path.Combine(AppContext.BaseDirectory, "wwwroot", relative.Replace('/', Path.DirectorySeparatorChar));
                if (File.Exists(alt)) physical = alt;
                else return null;
            }

            var bytes = File.ReadAllBytes(physical);
            if (bytes.Length == 0) return null;
            var ext = Path.GetExtension(physical).ToLowerInvariant();
            var mime = ext switch
            {
                ".png" => "image/png",
                ".webp" => "image/webp",
                ".gif" => "image/gif",
                _ => "image/jpeg"
            };
            return $"data:{mime};base64,{Convert.ToBase64String(bytes)}";
        }
        catch
        {
            return null;
        }
    }

    private void SetMessage(bool ok, string text)
    {
        _ = NotifyAsync(ok, text);
    }

    private Task NotifyAsync(bool ok, string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return Task.CompletedTask;
        return ok ? Toast.SuccessAsync(text) : Toast.ErrorAsync(text);
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("pmsEmpReg.detach"); } catch { }
        try { await JS.InvokeVoidAsync("employeeCamera.stop"); } catch { }
        dotNetRef?.Dispose();
        dotNetRef = null;
    }
}
