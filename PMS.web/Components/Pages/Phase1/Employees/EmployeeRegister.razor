    private async Task LoadSelectedGatesAsync(Guid employeeId)
    {
        try
        {
            var perms = await PermissionService.GetByEmployeeAsync(employeeId);
            selectedGateIds = perms
                .Where(p => p.IsActive && !p.isDeleted)
                .Select(p => p.GateId)
                .ToHashSet();
        }
        catch
        {
            selectedGateIds = new();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!jsAttached)
        {
            try
            {
                dotNetRef ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("pmsEmpReg.attach", dotNetRef);
                jsAttached = true;
            }
            catch (JSException) { }
            catch (JSDisconnectedException) { }
        }

        if (jsAttached && pinAutoPending)
        {
            pinAutoPending = false;
            await VerifyAndShowAsync();
        }
    }

