            if (string.IsNullOrWhiteSpace(model.FileNumber) || string.IsNullOrWhiteSpace(model.FullName))
            {
                SetMessage(false, "اضغط «عرض» أولاً لجلب الاسم والرقم الوظيفي من HR.");
                return;
            }

            // بوابة الجهاز: إلزامية للتسجيل الجديد — التعديل لمكتمل مسبقاً مسموح
            if (!credentialOk && !IsExistingCompleteEdit)
            {
                if (!await EnsureDeviceCredentialAsync(model.FileNumber))
