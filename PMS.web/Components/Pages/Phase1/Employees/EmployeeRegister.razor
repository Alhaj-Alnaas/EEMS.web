    private static string CameraErrorText(Exception ex)
    {
        if (ex is TaskCanceledException or OperationCanceledException)
            return "انتهت مهلة تشغيل الكاميرا. اسمح للمتصفح باستخدام الكاميرا ثم أعد المحاولة.";

        var msg = ex.Message ?? "";
        if (msg.Contains("canceled", StringComparison.OrdinalIgnoreCase))
            return "انتهت مهلة تشغيل الكاميرا. اسمح للمتصفح باستخدام الكاميرا ثم أعد المحاولة.";
        if (msg.Contains("NotAllowed", StringComparison.OrdinalIgnoreCase) || msg.Contains("Permission", StringComparison.OrdinalIgnoreCase))
            return "رُفض استخدام الكاميرا. اسمح للموقع بالكاميرا من شريط المتصفح.";
        if (msg.Contains("NotFound", StringComparison.OrdinalIgnoreCase))
            return "لم يُعثر على كاميرا متصلة بالجهاز.";
        if (msg.Contains("NotReadable", StringComparison.OrdinalIgnoreCase) || msg.Contains("TrackStart", StringComparison.OrdinalIgnoreCase))
            return "الكاميرا مستخدمة في برنامج آخر. أغلقه ثم أعد المحاولة.";
        return msg;
    }

