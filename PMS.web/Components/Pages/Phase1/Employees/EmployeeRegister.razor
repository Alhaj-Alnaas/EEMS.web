    private void TryMatchDepartment(string? departmentName, string? responsibilityCode)
    {
        if (string.IsNullOrWhiteSpace(departmentName) && string.IsNullOrWhiteSpace(responsibilityCode))
            return;

        var match = departments.FirstOrDefault(d =>
            (!string.IsNullOrWhiteSpace(departmentName) && (
                string.Equals(d.NameAr?.Trim(), departmentName.Trim(), StringComparison.OrdinalIgnoreCase)
                || string.Equals(d.NameEn?.Trim(), departmentName.Trim(), StringComparison.OrdinalIgnoreCase)
                || (!string.IsNullOrEmpty(d.NameAr) && departmentName.Contains(d.NameAr, StringComparison.OrdinalIgnoreCase))))
            || (!string.IsNullOrWhiteSpace(responsibilityCode) &&
                string.Equals(d.Code?.Trim(), responsibilityCode.Trim(), StringComparison.OrdinalIgnoreCase)));

        if (match != null && string.IsNullOrWhiteSpace(selectedDepartmentId))
            selectedDepartmentId = match.Id.ToString();
    }

