@page "/employees/register"
@page "/employees/register/{Id:guid}"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IEmployeeService EmployeeService
@inject IDepartmentMasterService DepartmentService
@inject IEmployeePhotoService PhotoService
@inject IEmployeeCardService CardService
@inject IGates GateService
@inject IReaderService ReaderService
@inject IEmployeePermissionService PermissionService
@inject IEmployeeDeviceSyncService DeviceSync
@inject IHrEmployeeLookupService HrLookup
@inject ICerpsPersonnelLookup CerpsPersonnel
@inject IDivisionGateService DivisionGates
@inject IEmployeeEnrollmentService EnrollmentService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IWebHostEnvironment HostEnvironment
@inject PMS.web.Notifications.IUiToast Toast
@using Microsoft.AspNetCore.Hosting
@using Core.Interfaces.Services.Organization
@using Core.Interfaces.Services.AccessControl
@using Services.Organization
@using Core.Models

<PageTitle>تسجيل موظف - PMS</PageTitle>

<div class="pms-create-page emp-reg">
    <h3 class="mb-1">
        <i class="bi bi-person-badge text-warning"></i>
        تسجيل بيانات الموظف
    </h3>
    <p class="text-muted small mb-2">التحقق من شؤون الأفراد، ثم استكمال البيانات وربط البوابات.</p>

    @if (screenLoading)
    {
        <div class="text-center p-5"><div class="spinner-border text-warning"></div></div>
    }
    else if (personnelMissing)
    {
        <div class="alert alert-warning mb-3">@personnelMessage</div>
        <BackLink Fallback="/employees" Css="btn btn-outline-secondary px-4">رجوع</BackLink>
    }
    else if (personnelReady)
    {
        <div class="emp-reg-tabs mb-3" role="tablist">
            <button type="button" class="@(activeTab == 1 ? "is-on" : "")" @onclick="() => activeTab = 1">
                <i class="bi bi-person-vcard"></i> بيانات الموظف
            </button>
            <button type="button" class="@(activeTab == 2 ? "is-on" : "")" @onclick="() => activeTab = 2">
                <i class="bi bi-door-open"></i> البوابات
            </button>
        </div>

        @if (activeTab == 1)
        {
            <div class="row g-2 align-items-start">
                <div class="col-lg-8">
                    <div class="card pms-basic-card emp-reg-card">
                        <div class="card-header pms-header">البيانات الأساسية</div>
                        <div class="card-body">
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <div class="mb-2">
                                        <label class="form-label">رقم الملف</label>
                                        <input class="form-control" value="@fileNumber" readonly />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label">الجنسية</label>
                                        <input class="form-control" value="@model.Nationality" readonly />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label">الحالة</label>
                                        <input class="form-control" value="@personnelStatusName" readonly />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label">فصيلة الدم</label>
                                        <input class="form-control" value="@model.BloodType" readonly />
                                    </div>
                                    <div class="mb-0">
                                        <label class="form-label">رقم الهاتف</label>
                                        <input class="form-control" value="@displayPhone" readonly />
                                    </div>
                                </div>
                                <div class="col-md-8">
                                    <div class="mb-2">
                                        <label class="form-label">الاسم</label>
                                        <input class="form-control" value="@displayFullName" readonly />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label">التقسيم</label>
                                        <input class="form-control" value="@displayDepartment" readonly />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label">الإدارة</label>
                                        <input class="form-control" value="@administrationName" readonly />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label">الوظيفة</label>
                                        <input class="form-control" value="@displayJobTitle" readonly />
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label">العنوان</label>
                                        <input class="form-control" value="@model.Address" readonly />
                                    </div>
                                    <div class="mb-0">
                                        <label class="form-label">البريد</label>
                                        <input class="form-control" value="@displayEmail" readonly />
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card pms-basic-card emp-reg-card">
                        <div class="card-header pms-header">بيانات تُضاف في النظام</div>
                        <div class="card-body">
                            <div class="mb-2">
                                <label class="form-label">رقم الكرت</label>
                                <InputText class="form-control" inputmode="numeric" @bind-Value="model.CardNumber" @bind-Value:after="NormalizeCard" />
                            </div>
                            <div class="form-check form-switch mb-2">
                                <InputCheckbox class="form-check-input" @bind-Value="model.IsActive" id="empActive" />
                                <label class="form-check-label fw-bold" for="empActive">@(model.IsActive ? "موظف نشط" : "موظف غير نشط")</label>
                            </div>
                            <div class="emp-reg-photo-panel">
                                <div class="emp-reg-photo-frame">
                                    <video id="emp-cam-video" class="@(cameraOn ? "is-live" : "")" autoplay muted playsinline></video>
                                    @if (!string.IsNullOrEmpty(photoPreviewUrl))
                                    {
                                        <img src="@photoPreviewUrl" alt="صورة الموظف" />
                                    }
                                    else if (!cameraOn)
                                    {
                                        <div class="emp-reg-photo-empty">
                                            <i class="bi bi-person-bounding-box"></i>
                                            <span>بدون صورة</span>
                                        </div>
                                    }
                                </div>
                                <div class="d-flex flex-wrap justify-content-center gap-2">
                                    @if (!cameraOn)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="StartCamera" disabled="@cameraBusy">
                                            <i class="bi bi-camera-video"></i> كاميرا
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-secondary" @onclick="CapturePhotoAsync" disabled="@cameraBusy">
                                            <i class="bi bi-camera-fill"></i> @(cameraBusy ? "جاري تشغيل الكاميرا..." : "التقاط")
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="StopCameraAsync">إيقاف</button>
                                        <div class="form-text w-100 text-center mb-0">المعاينة لضبط الوجه، والتقاط يحفظ صورة ثابتة فقط.</div>
                                    }
                                    @if (!string.IsNullOrEmpty(photoPreviewUrl))
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="ClearPhotoAsync">حذف</button>
                                    }
                                </div>
                                <InputFile class="form-control form-control-sm mt-2" OnChange="OnPhotoFileAsync" accept="image/*" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card pms-basic-card">
                <div class="card-header pms-header">البوابات المتاحة</div>
                <div class="card-body">
                    <div class="d-flex flex-column gap-2 mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="linkMode" id="linkEmployee" checked="@(linkMode == "employee")" @onchange='() => linkMode = "employee"' />
                            <label class="form-check-label" for="linkEmployee">ربط برقم الموظف @fileNumber</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="linkMode" id="linkDivision" checked="@(linkMode == "division")" @onchange='() => linkMode = "division"' disabled="@string.IsNullOrWhiteSpace(responsibilityCode)" />
                            <label class="form-check-label" for="linkDivision">
                                ربط التقسيم بالكامل
                                @if (!string.IsNullOrWhiteSpace(displayDepartment))
                                {
                                    <span class="text-muted">— @displayDepartment</span>
                                }
                            </label>
                            <div class="form-text">عند إضافة أي موظف من هذا التقسيم تُربط هذه البوابات به تلقائياً.</div>
                        </div>
                    </div>
                    @if (gates.Count == 0)
                    {
                        <div class="text-muted">لا توجد بوابات مسجّلة.</div>
                    }
                    else
                    {
                        <div class="border rounded p-2 emp-reg-gate-list">
                            @foreach (var g in gates)
                            {
                                var gid = g.Id;
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="gate-@gid"
                                           checked="@selectedGateIds.Contains(gid)"
                                           @onchange="e => ToggleGate(gid, ToBool(e.Value))" />
                                    <label class="form-check-label" for="gate-@gid">
                                        @g.no — @g.description
                                    </label>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }

        <div class="pms-create-actions">
            <button type="button" class="btn btn-warning px-4" @onclick="SaveRegistrationAsync" disabled="@saving">
                <i class="bi bi-save"></i> @(saving ? "جاري الحفظ..." : "حفظ")
            </button>
            <BackLink Fallback="/employees" Css="btn btn-outline-secondary px-4">رجوع</BackLink>
        </div>
    }
    else
    {
        <div class="alert alert-warning mb-3">افتح التسجيل من قائمة الموظفين بعد مزامنة القارئة.</div>
        <BackLink Fallback="/employees" Css="btn btn-outline-secondary px-4">رجوع</BackLink>
    }
</div>


<style>
    .emp-reg-steps {
        display: flex; align-items: center; gap: .35rem; flex-wrap: wrap;
        background: #fff; border: 1px solid #e8ecf0; border-radius: .75rem; padding: .65rem .85rem;
    }
    .emp-reg-step {
        display: flex; align-items: center; gap: .35rem; font-size: .78rem; color: #6c757d; font-weight: 500;
        white-space: nowrap;
    }
    .emp-reg-step.active { color: #212529; }
    .emp-reg-step.done { color: #198754; }
    .emp-reg-step-num {
        width: 1.35rem; height: 1.35rem; border-radius: 50%;
        display: inline-flex; align-items: center; justify-content: center;
        font-size: .72rem; font-weight: 700; background: #e9ecef; color: #495057;
    }
    .emp-reg-step.active .emp-reg-step-num { background: #ffc107; color: #212529; }
    .emp-reg-step.done .emp-reg-step-num { background: #198754; color: #fff; }
    .emp-reg-step-line { flex: 1; min-width: 1rem; height: 2px; background: #dee2e6; }
    .emp-reg-step-line.done { background: #198754; }
    .emp-reg-card { border: 1px solid #e8ecf0; border-radius: .75rem; overflow: hidden; }
    .emp-reg-card-head { background: linear-gradient(180deg, #fff8e6, #fff); font-weight: 600; }
    .emp-reg-locked { opacity: .72; }
    .emp-reg-section-title {
        font-size: .78rem; font-weight: 700; letter-spacing: .02em; text-transform: uppercase;
        color: #6c757d; margin-bottom: .75rem; padding-bottom: .35rem; border-bottom: 1px solid #eef1f4;
    }
    .emp-reg.pms-create-page {
        height: auto; flex: none;
        padding-inline: 0.65rem;
    }
    .emp-reg .pms-basic-card { height: auto; }
    .emp-reg .card-header.pms-header { padding: 0.4rem 0.75rem; font-size: 0.95rem; }
    .emp-reg .card-body { padding: 0.7rem 0.85rem; }
    .emp-reg .form-label { margin-bottom: 0.15rem; font-size: 0.82rem; font-weight: 700; color: #495057; }
    .emp-reg .form-control { padding: 0.32rem 0.55rem; font-size: 0.92rem; }
    .emp-reg .form-control[readonly] { background: #f4f6f8; }
    .emp-reg-photo-panel {
        background: #f7f8fa; border: 1px dashed #ced4da; border-radius: .65rem;
        padding: 0.85rem 1rem 0.75rem; margin-top: 0.35rem;
    }
    .emp-reg-photo-frame {
        width: 136px; height: 170px; margin: 0.25rem auto 0.75rem;
        border: 1px solid #343a40; border-radius: .45rem; overflow: hidden;
        background: #212529; position: relative;
    }
    .emp-reg-photo-frame img,
    .emp-reg-photo-frame video {
        width: 100%; height: 100%; object-fit: cover;
    }
    .emp-reg-photo-frame img { display: block; }
    .emp-reg-photo-frame video { display: none; }
    .emp-reg-photo-frame video.is-live { display: block; }
    .emp-reg-photo-empty {
        height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center;
        color: rgba(255,255,255,.55); gap: .2rem; font-size: .75rem;
    }
    .emp-reg-photo-empty i { font-size: 1.45rem; }
    .emp-reg-action-box {
        border: 1px solid #e8ecf0; border-radius: .75rem; padding: 1.1rem; background: #fff;
    }
    .emp-reg-action-icon { font-size: 1.5rem; margin-bottom: .35rem; }
    .emp-reg-gate-list {
        max-height: 240px; overflow: auto;
        display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: .15rem .75rem;
    }
    .emp-reg-tabs {
        display: inline-flex; gap: .35rem; padding: .28rem;
        background: #e7eaee; border-radius: .7rem;
    }
    .emp-reg-tabs button {
        border: 0; background: transparent; color: #5c6570;
        border-radius: .5rem; padding: .42rem .95rem; font-weight: 700;
    }
    .emp-reg-tabs button.is-on {
        background: #fff; color: #11101d;
        box-shadow: 0 1px 3px rgba(17, 16, 29, .08);
        border-bottom: 3px solid #fd7e14;
    }
</style>

@code {
    [Parameter] public Guid? Id { get; set; }

    [SupplyParameterFromQuery(Name = "pin")]
    public string? PinQuery { get; set; }

    private Employee model = new() { IsActive = true };
    private string fileNumber = "";
    private string selectedDepartmentId = "";
    private List<Department> departments = new();
    private List<Reader> readers = new();
    private List<Gate> gates = new();
    private HashSet<Guid> selectedGateIds = new();

    private string displayFullName = "";
    private string displayJobTitle = "";
    private string displayDepartment = "";
    private string displayJobStatus = "";
    private string displayPhone = "";
    private string displayEmail = "";

    private bool hrLoaded;
    private bool screenLoading = true;
    private bool personnelReady;
    private bool personnelMissing;
    private string? personnelMessage;
    private string personnelStatusName = "";
    private string administrationName = "";
    private string responsibilityCode = "";
    private string linkMode = "employee";
    private int activeTab = 1;
    private bool saving;
    private bool phase1Saved;
    private bool printing;
    private bool syncingGates;
    private bool cameraOn;
    private bool cameraBusy;
    private bool cameraStartPending;
    private bool verifying;
    private string? photoPreviewUrl;
    private byte[]? photoBytes;
    private string photoContentType = "image/jpeg";
    private bool photoRemoved;
    private string? photoBeforeCamera;
    private Guid savedEmployeeId;

    private bool credentialChecked;
    private bool credentialOk;
    private string credentialMessage = "";
    private int credentialTemplates;
    private bool credentialHasCard;
    private bool awaitingCredentialBlock;
    private bool pinAutoPending;
    private bool wasCompleteOnLoad;

    private DotNetObjectReference<EmployeeRegister>? dotNetRef;
    private bool jsAttached;

    private bool HasGatesSelected => selectedGateIds.Count > 0;

    private string StepClass(int step)
    {
        var registrationDone = phase1Saved && HasGatesSelected;
        return step switch
        {
            1 => !credentialOk ? "active" : "done",
            2 => !credentialOk ? "active" : "done",
            3 => credentialOk && !registrationDone ? "active"
                : registrationDone ? "done" : "",
            4 => registrationDone ? "active" : "",
            _ => ""
        };
    }

    private string StepLineClass(int afterStep)
    {
        return afterStep switch
        {
            1 or 2 => credentialOk ? "done" : "",
            3 => phase1Saved && HasGatesSelected ? "done" : "",
            _ => ""
        };
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            departments = await DepartmentService.GetAllAsync();
            readers = (await ReaderService.GetAllAsync())
                .Where(r => !r.isDeleted)
                .OrderBy(r => r.Name ?? r.DeviceSerial)
                .ToList();
            gates = (await GateService.GetAllAsync())
                .Where(g => !g.isDeleted)
                .OrderBy(g => g.description ?? g.no)
                .ToList();

            if (Id is Guid empId && empId != Guid.Empty)
            {
                await LoadExistingForEditAsync(empId);
            }
            else if (!string.IsNullOrWhiteSpace(PinQuery))
            {
                fileNumber = PinQuery.Trim();
                pinAutoPending = true;
            }
        }
        catch (Exception ex)
        {
            SetMessage(false, "تعذر تحميل قوائم الشاشة: " + ex.Message);
        }
        finally
        {
            screenLoading = false;
        }
    }

    private static bool HasBasicRegistration(Employee e)
        => !string.IsNullOrWhiteSpace(e.FullName)
           && (
               !string.IsNullOrWhiteSpace(e.JobTitle)
               || !string.IsNullOrWhiteSpace(e.DepartmentName)
               || !string.IsNullOrWhiteSpace(e.Address)
               || !string.IsNullOrWhiteSpace(e.Nationality)
               || !string.IsNullOrWhiteSpace(e.BloodType)
           );

    private static bool NeedsHrExtras(Employee e)
        => string.IsNullOrWhiteSpace(e.Address)
           || string.IsNullOrWhiteSpace(e.Nationality)
           || string.IsNullOrWhiteSpace(e.BloodType);

    private bool CanPrintFromRegister
        => phase1Saved
           && savedEmployeeId != Guid.Empty
           && HasBasicRegistration(model);

    private bool IsExistingCompleteEdit
        => savedEmployeeId != Guid.Empty
           && (wasCompleteOnLoad || HasBasicRegistration(model));

    private async Task LoadExistingForEditAsync(Guid empId)
    {
        var existing = await EmployeeService.GetByIdAsync(empId);
        if (existing == null)
        {
            personnelMissing = true;
            personnelMessage = "الموظف غير موجود.";
            return;
        }

        ApplyEmployeeToForm(existing);
        var info = await EnrollmentService.GetEnrollmentInfoAsync(empId);
        if (info != null)
            ApplyEnrollmentCredential(info);

        if (string.IsNullOrWhiteSpace(existing.FileNumber))
        {
            personnelMissing = true;
            personnelMessage = CerpsPersonnelLookup.NotRegisteredMessage;
            return;
        }

        var hr = await CerpsPersonnel.LookupAsync(existing.FileNumber);
        if (!hr.Success)
        {
            personnelMissing = true;
            personnelMessage = hr.Error ?? CerpsPersonnelLookup.NotRegisteredMessage;
            return;
        }

        ApplyHrResult(hr, keepLocalExtras: true);
        personnelStatusName = string.IsNullOrWhiteSpace(hr.JobStatusName) ? (hr.JobStatus ?? "") : hr.JobStatusName;
        administrationName = hr.AdministrationName ?? "";
        responsibilityCode = new string((hr.ResponsibilityCode ?? "").Where(char.IsDigit).ToArray());
        if (responsibilityCode.Length > 5)
            responsibilityCode = responsibilityCode[..5];
        if (string.IsNullOrWhiteSpace(displayDepartment))
            displayDepartment = hr.DepartmentName ?? "";
        model.DepartmentName = string.IsNullOrWhiteSpace(hr.DepartmentName) ? model.DepartmentName : hr.DepartmentName;

        await LoadSelectedGatesAsync(existing.Id);
        var divisionGates = await DivisionGates.GetGateIdsAsync(responsibilityCode);
        foreach (var gateId in divisionGates)
            selectedGateIds.Add(gateId);
        if (divisionGates.Count > 0)
        {
            linkMode = "division";
            await GrantGatesAsync(existing.Id, divisionGates);
        }

        personnelReady = true;
        hrLoaded = true;
        phase1Saved = true;
        credentialOk = true;
    }

    private void ApplyEnrollmentCredential(EmployeeEnrollmentInfo info)
    {
        credentialChecked = true;
        credentialTemplates = info.TemplateCount;
        credentialHasCard = info.HasCard;
        credentialOk = info.TemplateCount > 0 || info.HasCard;
        credentialMessage = credentialOk
            ? $"قوالب: {info.TemplateCount}" + (info.HasCard ? " + كرت" : "")
            : "لا توجد بصمة/كرت بعد";
    }

    private void ApplyCredentialStatus(DeviceCredentialStatus status)
    {
        credentialChecked = true;
        credentialOk = status.Found;
        credentialTemplates = status.TemplateCount;
        credentialHasCard = status.HasCard;
        credentialMessage = status.Message ?? "";
        if (status.EmployeeId is Guid eid && eid != Guid.Empty)
            savedEmployeeId = eid;
    }

    private void ClearCredentialState()
    {
        credentialChecked = true;
        credentialOk = false;
        credentialTemplates = 0;
        credentialHasCard = false;
        credentialMessage = "";
    }

    private async Task<bool> EnsureDeviceCredentialAsync(string pin)
    {
        var status = await EnrollmentService.CheckDeviceCredentialAsync(pin);
        ApplyCredentialStatus(status);
        if (!status.Found)
        {
            awaitingCredentialBlock = true;
            await NotifyAsync(false, status.Message);
            return false;
        }

        awaitingCredentialBlock = false;
        return true;
    }

    private async Task VerifyAndShowAsync()
    {
        if (phase1Saved || verifying) return;

        verifying = true;
        try
        {
            string pin;
            try
            {
                pin = await JS.InvokeAsync<string>("pmsEmpReg.getVal", "regEmpFileNo");
            }
            catch
            {
                pin = fileNumber;
            }

            pin = (pin ?? "").Trim();
            fileNumber = pin;

            if (string.IsNullOrWhiteSpace(pin))
            {
                await NotifyAsync(false, "أدخل الرقم الوظيفي أولاً.");
                return;
            }

            if (!await EnsureDeviceCredentialAsync(pin))
                return;

            await JS.InvokeVoidAsync("pmsEmpReg.show");
        }
        catch (Exception ex)
        {
            await NotifyAsync(false, "تعذر التحقق من بيانات الجهاز: " + ex.Message);
        }
        finally
        {
            verifying = false;
        }
    }

    private void ApplyEmployeeToForm(Employee existing)
    {
        model = existing;
        savedEmployeeId = existing.Id;
        fileNumber = existing.FileNumber ?? "";
        displayFullName = existing.FullName ?? "";
        displayJobTitle = existing.JobTitle ?? "";
        displayDepartment = existing.DepartmentName ?? existing.Department?.NameAr ?? "";
        displayJobStatus = existing.JobStatus ?? "";
        displayPhone = existing.Phone ?? "";
        displayEmail = existing.Email ?? "";
        selectedDepartmentId = existing.DepartmentId?.ToString() ?? "";
        photoPreviewUrl = string.IsNullOrWhiteSpace(existing.PhotoPath) ? null : existing.PhotoPath;
        photoBytes = null;
    }

    private void ApplyHrResult(Core.Models.HrEmployeeLookupResult hr, bool keepLocalExtras)
    {
        fileNumber = hr.FileNumber ?? fileNumber;
        displayFullName = hr.FullName ?? "";
        displayJobTitle = hr.JobTitle ?? "";
        displayDepartment = hr.DepartmentName ?? "";
        displayJobStatus = hr.JobStatus ?? "";
        displayPhone = hr.Phone ?? "";
        displayEmail = hr.Email ?? "";

        model.FileNumber = fileNumber;
        model.FullName = displayFullName;
        model.JobTitle = displayJobTitle;
        model.DepartmentName = displayDepartment;
        model.JobStatus = displayJobStatus;
        model.Phone = displayPhone;
        model.Email = displayEmail;

        if (!string.IsNullOrWhiteSpace(hr.Address))
            model.Address = hr.Address;
        else if (!keepLocalExtras)
            model.Address = model.Address;

        if (!string.IsNullOrWhiteSpace(hr.Nationality))
            model.Nationality = hr.Nationality;

        if (!string.IsNullOrWhiteSpace(hr.BloodType))
            model.BloodType = hr.BloodType;

        hrLoaded = true;
    }

    private async Task<bool> TryMergeHrExtrasAsync(string empFileNo)
    {
        var hr = await HrLookup.LookupAsync(empFileNo.Trim());
        if (!hr.Success)
            return false;

        ApplyHrResult(hr, keepLocalExtras: true);
        TryMatchDepartment(displayDepartment, hr.ResponsibilityCode);
        await SyncExtraFieldsToDomAsync();
        return true;
    }

