            {
                photoSrc = PhotoService.TryGetPhotoDataUrl(model.PhotoPath)
                           ?? TryReadPhotoDataUrlFromWebRoot(model.PhotoPath);
            }

            var jobTitle = !string.IsNullOrWhiteSpace(model.JobTitle)
                ? model.JobTitle
