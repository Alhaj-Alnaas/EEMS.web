    [JSInvokable]
    public async Task OnHrLoaded(string json)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;

            fileNumber = GetJsonString(root, "empFileNo") ?? fileNumber;

            // حماية: لا تُقبل بيانات HR بدون تحقق جهاز (إلا تعديل مكتمل مسبقاً)
            if (!credentialOk && !IsExistingCompleteEdit)
            {
                var pin = (fileNumber ?? "").Trim();
                if (string.IsNullOrWhiteSpace(pin) || !await EnsureDeviceCredentialAsync(pin))
                {
                    ClearHrDisplay();
                    hrLoaded = false;
                    model = new Employee { IsActive = true };
                    await InvokeAsync(StateHasChanged);
                    return;
                }
            }

            displayFullName = GetJsonString(root, "empName") ?? "";
            displayJobTitle = GetJsonString(root, "jobtypeName") ?? "";
            displayDepartment = GetJsonString(root, "perRespCodeNoName") ?? "";
            displayJobStatus = GetJsonString(root, "jobStatus") ?? "";
            displayPhone = GetJsonString(root, "empPhone") ?? "";
            displayEmail = GetJsonString(root, "empEmail") ?? "";

            var keepId = savedEmployeeId;
            var keepActive = model.IsActive;
            var keepHost = model.HostCapable;

            model = new Employee
            {
                IsActive = keepActive,
                HostCapable = keepHost,
                FileNumber = fileNumber,
                FullName = displayFullName,
                JobTitle = displayJobTitle,
                DepartmentName = displayDepartment,
                JobStatus = displayJobStatus,
                Phone = displayPhone,
                Email = displayEmail,
                Address = GetJsonString(root, "empAddress") ?? GetJsonString(root, "address"),
                Nationality = GetJsonString(root, "nationality") ?? GetJsonString(root, "empNationality"),
                BloodType = GetJsonString(root, "bloodType") ?? GetJsonString(root, "bloodGroup")
            };

            // لا تُقفل الشاشة تلقائياً — الحفظ الصريح يفعّل المرحلة الثانية
            phase1Saved = false;
            savedEmployeeId = keepId;
            if (keepId != Guid.Empty)
                model.Id = keepId;
            photoBytes = null;
            photoPreviewUrl = null;
            hrLoaded = true;
            TryMatchDepartment(displayDepartment, GetJsonString(root, "empResponsibilitycode"));

            try
            {
                var existing = await EmployeeService.GetByFileNumberAsync(fileNumber);
                if (existing != null)
                {
                    savedEmployeeId = existing.Id;
                    model.Id = existing.Id;
                    if (string.IsNullOrWhiteSpace(model.Address))
                        model.Address = existing.Address;
                    model.CardNumber = existing.CardNumber;
                    if (string.IsNullOrWhiteSpace(model.Nationality))
                        model.Nationality = existing.Nationality;
                    if (string.IsNullOrWhiteSpace(model.BloodType))
                        model.BloodType = existing.BloodType;
                    model.PhotoPath = existing.PhotoPath;
                    model.HostCapable = existing.HostCapable;
                    model.IsActive = existing.IsActive;
                    if (existing.DepartmentId.HasValue)
                        selectedDepartmentId = existing.DepartmentId.Value.ToString();
                    photoPreviewUrl = string.IsNullOrWhiteSpace(existing.PhotoPath) ? null : existing.PhotoPath;
                }
            }
            catch
            {
                // غير حرج
            }

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            await NotifyAsync(false, "تعذر مزامنة بيانات العرض: " + ex.Message);
            await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public Task OnHrFailed(string error)
    {
        hrLoaded = false;
        ClearHrDisplay();
        // لا نكرر الرسالة — عُرضت مرة واحدة من pmsToast في JS
        return InvokeAsync(StateHasChanged);
    }

    private static string? GetJsonString(System.Text.Json.JsonElement root, string name)
    {
        if (!root.TryGetProperty(name, out var p) || p.ValueKind == System.Text.Json.JsonValueKind.Null)
            return null;
        return p.GetString()?.Trim();
    }

    private void ClearHrDisplay()
    {
        displayFullName = "";
        displayJobTitle = "";
        displayDepartment = "";
        displayJobStatus = "";
        displayPhone = "";
        displayEmail = "";
    }

    private void TryMatchDepartment(string? departmentName, string? responsibilityCode)
    {
        if (string.IsNullOrWhiteSpace(departmentName) && string.IsNullOrWhiteSpace(responsibilityCode))
            return;

        var match = departments.FirstOrDefault(d =>
            (!string.IsNullOrWhiteSpace(departmentName) && (
                string.Equals(d.NameAr?.Trim(), departmentName.Trim(), StringComparison.OrdinalIgnoreCase)
                || string.Equals(d.NameEn?.Trim(), departmentName.Trim(), StringComparison.OrdinalIgnoreCase)
                || (!string.IsNullOrEmpty(d.NameAr) && departmentName.Contains(d.NameAr, StringComparison.OrdinalIgnoreCase))))
            || (!string.IsNullOrWhiteSpace(responsibilityCode) &&
                string.Equals(d.Code?.Trim(), responsibilityCode.Trim(), StringComparison.OrdinalIgnoreCase)));

        if (match != null && string.IsNullOrWhiteSpace(selectedDepartmentId))
            selectedDepartmentId = match.Id.ToString();
    }

