@page "/employees/{Id:guid}"
@rendermode InteractiveServer
@inject IEmployeeService EmployeeService
@inject IDepartmentMasterService DepartmentService
@inject IReaderService ReaderService
@inject NavigationManager Navigation

<PageTitle>بيانات الموظف - PMS</PageTitle>

<h3 class="mb-4">
    <i class="bi bi-person-badge-fill text-warning"></i>
    @(IsNew ? "إضافة موظف جديد" : "تعديل بيانات موظف")
</h3>

@if (loading)
{
    <div class="text-center p-5"><div class="spinner-border text-warning"></div></div>
}
else
{
    @if (!string.IsNullOrEmpty(saveMessage))
    {
        <div class="alert @(saveOk ? "alert-success" : "alert-warning") alert-dismissible fade show">
            @saveMessage
            <button type="button" class="btn-close" @onclick="() => saveMessage = null"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <EditForm Model="model" OnValidSubmit="SaveAsync">
                <DataAnnotationsValidator />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">الرقم الوظيفي</label>
                        <InputText class="form-control" @bind-Value="model.FileNumber" />
                        <div class="form-text">يجب أن يطابق PIN على القارئة</div>
                    </div>
                    <div class="col-md-8">
                        <label class="form-label">الاسم الكامل</label>
                        <InputText class="form-control" @bind-Value="model.FullName" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">الإدارة</label>
                        <InputSelect class="form-select" @bind-Value="selectedDepartmentId">
                            <option value="">-- بدون --</option>
                            @foreach (var d in departments)
                            {
                                <option value="@d.Id">@d.NameAr</option>
                            }
                        </InputSelect>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">الحالة الوظيفية</label>
                        <InputText class="form-control" @bind-Value="model.JobStatus" placeholder="AE" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">الجنسية</label>
                        <InputText class="form-control" @bind-Value="model.Nationality" />
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="model.IsActive" id="isActive" />
                            <label class="form-check-label" for="isActive">موظف نشط</label>
                        </div>
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <div class="form-check">
                            <InputCheckbox class="form-check-input" @bind-Value="model.HostCapable" id="hostCapable" />
                            <label class="form-check-label" for="hostCapable">يمكنه استضافة زوار</label>
                        </div>
                    </div>

                    <div class="col-12">
                            <label class="form-label fw-semibold">القارئات المستهدفة (تسجيل على الجهاز)</label>
                            @if (readers.Count == 0)
                            {
                                <div class="text-muted small">لا توجد قارئات مسجّلة.</div>
                            }
                            else
                            {
                                <div class="border rounded p-3 bg-light">
                                    @foreach (var r in readers)
                                    {
                                        var rid = r.Id;
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   id="reader-@rid"
                                                   checked="@selectedReaderIds.Contains(rid)"
                                                   @onchange="e => ToggleReader(rid, ToBool(e.Value))" />
                                            <label class="form-check-label" for="reader-@rid">
                                                @(string.IsNullOrWhiteSpace(r.Name) ? r.DeviceSerial : r.Name)
                                                <code class="small text-muted">@r.DeviceSerial</code>
                                                @if (!r.IsActive)
                                                {
                                                    <span class="badge bg-secondary">غير نشطة</span>
                                                }
                                            </label>
                                        </div>
                                    }
                                </div>
                                <div class="form-text">
                                    على SpeedFace M4: Access Control Role = Access Group + Time Period (Time Rule 1–24).
                                    نشط: Access Group = enable و Time Rule [1] محدّد.
                                    غير نشط: Access Group = disable و Time Rule [1] غير محدّد. البصمة لا تُحذف.
                                </div>
                            }
                        </div>
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-warning"><i class="bi bi-save"></i> حفظ</button>
                    <BackLink Fallback="/employees">إلغاء</BackLink>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private bool IsNew => Id == Guid.Empty;
    private bool loading = true;
    private string? saveMessage;
    private bool saveOk;
    private Employee model = new();
    private List<Department> departments = new();
    private List<Reader> readers = new();
    private HashSet<Guid> selectedReaderIds = new();
    private string selectedDepartmentId = "";

    protected override async Task OnInitializedAsync()
    {
        departments = await DepartmentService.GetAllAsync();
        readers = (await ReaderService.GetAllAsync())
            .Where(r => !r.isDeleted)
            .OrderBy(r => r.Name ?? r.DeviceSerial)
            .ToList();

        if (!IsNew)
        {
            var existing = await EmployeeService.GetByIdAsync(Id);
            if (existing != null)
            {
                model = existing;
                selectedDepartmentId = existing.DepartmentId?.ToString() ?? "";
                foreach (var sn in Services.AccessControl.ZkTecoAccUserCommand.TryGetEnrolledSerials(existing.remarks))
                {
                    var match = readers.FirstOrDefault(r =>
                        string.Equals(r.DeviceSerial, sn, StringComparison.OrdinalIgnoreCase));
                    if (match != null)
                        selectedReaderIds.Add(match.Id);
                }
            }
        }
        else if (readers.Count(r => r.IsActive) == 1)
        {
            selectedReaderIds.Add(readers.First(r => r.IsActive).Id);
        }

        loading = false;
    }

    private static bool ToBool(object? value)
        => value is bool b ? b : string.Equals(value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);

    private void ToggleReader(Guid readerId, bool on)
    {
        if (on) selectedReaderIds.Add(readerId);
        else selectedReaderIds.Remove(readerId);
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(model.FileNumber))
        {
            saveOk = false;
            saveMessage = "الرقم الوظيفي مطلوب (PIN على القارئة).";
            return;
        }

        model.DepartmentId = Guid.TryParse(selectedDepartmentId, out var depId) ? depId : null;
        saveMessage = null;
        var readerList = selectedReaderIds.ToList();

        try
        {
            int queued;
            if (IsNew)
            {
                model.Id = Guid.NewGuid();
                model.createdOn = DateTime.Now;
                queued = await EmployeeService.InsertAsync(model, readerList);
            }
            else
            {
                model.updatedOn = DateTime.Now;
                queued = await EmployeeService.UpdateAsync(model, readerList.Count > 0 ? readerList : null);
            }

            saveOk = queued > 0 || readerList.Count == 0;
            if (readerList.Count == 0)
                saveMessage = "تم الحفظ في النظام فقط (لم تُحدَّد قارئات).";
            else if (queued > 0)
                saveMessage = model.IsActive
                    ? "تم الحفظ. أُرسل تمكين: Access Group=1 (ضمن توليفة فتح الباب)."
                    : "تم الحفظ. أُرسل تعطيل: Access Group=99 (خارج توليفة الباب الافتراضية). لا يُحذف المستخدم أو البصمة.";
            else
                saveMessage = "تم الحفظ في النظام، لكن لم يُدرج أمر للقارئة (القارئة غير موجودة أو غير نشطة).";
        }
        catch (Exception ex)
        {
            saveOk = false;
            saveMessage = "فشل إرسال الأمر للقارئة: " + ex.Message;
        }
    }
}
