@page "/permits"
@rendermode InteractiveServer
@inject IMaterialPermitService MaterialPermits
@inject IPermitExecutionService Execution
@inject IDepartmentService DepartmentService
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Identity
@using Core.Extensions
@using Core.Security
@using Services.Permits

<PageTitle>قائمة التصاريح - PMS</PageTitle>

<section class="pms-permit-list">
<div class="pms-permit-list-head">
    <h3><i class="bi bi-list-check"></i> قائمة التصاريح</h3>
    <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-sm pms-permit-view-btn" @onclick="ExportExcelAsync" disabled="@(loading || exporting || FilteredPermits.Count == 0)">
            <i class="bi bi-file-earmark-excel"></i> ترحيل إلى إكسل
        </button>
        @if (!loading && string.IsNullOrEmpty(loadError))
        {
            <span class="pms-permit-count">@FilteredPermits.Count من @permits.Count</span>
        }
    </div>
</div>

@if (!string.IsNullOrEmpty(loadError))
{
    <div class="alert alert-danger">@loadError</div>
}
@if (!string.IsNullOrEmpty(exportError))
{
    <div class="alert alert-danger">@exportError</div>
}

@if (loading)
{
    <div class="text-center p-5"><div class="spinner-border text-warning"></div></div>
}
else if (permits.Count == 0)
{
    <div class="pms-placeholder">
        <i class="bi bi-inbox"></i>
        <h5>لا توجد تصاريح مرتبطة بحسابك</h5>
    </div>
}
else
{
    <div class="card shadow-sm mb-3">
        <div class="card-body py-3">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label mb-1">نوع التصريح</label>
                    <select class="form-select form-select-sm" @bind="typeFilter">
                        <option value="">الكل</option>
                        <option value="Materials">مواد</option>
                        <option value="Cars">مركبات</option>
                        <option value="Visitors">زوار</option>
                        <option value="EmployeeAccess">دخول موظفين</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label mb-1">حالة التصريح</label>
                    <select class="form-select form-select-sm" @bind="statusFilter">
                        <option value="">الكل</option>
                        <option value="مسودة">مسودة</option>
                        <option value="تحت الاعتماد">تحت الاعتماد</option>
                        <option value="مرجع">مرجع</option>
                        <option value="تحت التنفيذ">تحت التنفيذ</option>
                        <option value="منفذ">منفذ</option>
                        <option value="مغلق">مغلق</option>
                        <option value="مرفوض">مرفوض</option>
                        <option value="ملغي">ملغي</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label mb-1">بحث</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input class="form-control" placeholder="بحث برقم التصريح أو الجهة أو الغرض..." @bind="quickSearch" @bind:event="oninput" />
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (FilteredPermits.Count == 0)
    {
        <div class="pms-placeholder">
            <i class="bi bi-search"></i>
            <h5>لا توجد نتائج مطابقة للبحث</h5>
        </div>
    }
    else
    {
        <div class="card pms-permit-sheet">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 pms-permit-grid">
                    <thead>
                        <tr>
                            <th>رقم التصريح</th>
                            <th>نوع التصريح</th>
                            <th>الغرض من التصريح</th>
                            <th>تاريخ التصريح</th>
                            <th>الجهة الطالبة</th>
                            <th>بوابة التنفيذ</th>
                            <th>حالة التصريح</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var permit in FilteredPermits)
                        {
                            var status = StatusMapper.ListStatus(permit);
                            <tr>
                                <td class="pms-permit-no"><bdi>@permit.no</bdi></td>
                                <td>@ClassificationLabel(permit.classification)</td>
                                <td class="pms-permit-purpose">@(string.IsNullOrWhiteSpace(PermitText.Purpose(permit)) ? "—" : PermitText.Purpose(permit))</td>
                                <td class="text-nowrap">@permit.date.ToString("yyyy/MM/dd")</td>
                                <td>@DepartmentName(permit.reqDepartment)</td>
                                <td>@GateText(permit)</td>
                                <td><span class="badge @status.Css">@status.Label</span></td>
                                <td class="text-nowrap">
                                    <a class="btn btn-sm pms-permit-view-btn" href="@ReturnUrl.Go(Navigation, $"/permits/materials/view/{permit.Id}")">
                                        <i class="bi bi-eye"></i> عرض التفاصيل
                                    </a>
                                    @if (MaterialPermitService.CanEdit(permit, currentUser!))
                                    {
                                        <a class="btn btn-sm pms-permit-edit-btn" href="@ReturnUrl.Go(Navigation, EditHref(permit))">
                                            <i class="bi bi-pencil"></i> تعديل
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}
</section>

@code {
    private bool loading = true;
    private bool exporting;
    private string? loadError;
    private string? exportError;
    private string quickSearch = "";
    private string typeFilter = "";
    private string statusFilter = "";
    private User? currentUser;
    private List<Permit> permits = new();
    private Dictionary<Guid, string> gateLabels = new();

    [SupplyParameterFromQuery(Name = "status")]
    private string? StatusQuery { get; set; }
    private Dictionary<string, string> departmentNames = new(StringComparer.OrdinalIgnoreCase);

    private List<Permit> FilteredPermits
    {
        get
        {
            IEnumerable<Permit> query = permits;
            if (!string.IsNullOrWhiteSpace(typeFilter))
                query = query.Where(p => string.Equals(ClassificationKey(p.classification), typeFilter, StringComparison.OrdinalIgnoreCase));

            if (!string.IsNullOrWhiteSpace(statusFilter))
                query = query.Where(p => StatusMapper.ListStatus(p).Label == statusFilter);

            if (string.IsNullOrWhiteSpace(quickSearch))
                return query.ToList();

            var term = quickSearch.Trim();
            return query.Where(p =>
                Contains(p.no, term)
                || Contains(DepartmentName(p.reqDepartment), term)
                || Contains(PermitText.Purpose(p), term)
                || Contains(ClassificationLabel(p.classification), term)
                || Contains(p.type, term)).ToList();
        }
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrWhiteSpace(StatusQuery))
            statusFilter = StatusQuery;
    }

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(StatusQuery))
            statusFilter = StatusQuery;

        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userName = authState.User.Identity?.Name;
            currentUser = userName != null ? await UserManager.FindByNameAsync(userName) : null;
            if (currentUser == null)
            {
                loadError = "تعذر تحديد المستخدم الحالي.";
                return;
            }

            if (!string.IsNullOrWhiteSpace(currentUser.ResponsibilityCode))
            {
                var departments = await DepartmentService.GetDepartmentsByResponsibilityAsync(currentUser.ResponsibilityCode);
                foreach (var department in departments)
                {
                    if (!string.IsNullOrWhiteSpace(department.RespCode))
                        departmentNames[department.RespCode.Trim()] = department.DepartmentName ?? department.RespCode;
                }
            }

            Guid? gateId = null;
            var gateClaim = authState.User.FindFirst(SystemTaskCodes.SelectedGateIdClaimType)?.Value;
            if (Guid.TryParse(gateClaim, out var parsedGate))
                gateId = parsedGate;
            permits = await MaterialPermits.GetForResponsibilityCenterAsync(currentUser, gateId);
            gateLabels = await Execution.ExecutionGateLabelsAsync(permits);

            foreach (var code in permits
                .Select(p => p.reqDepartment)
                .Where(code => !string.IsNullOrWhiteSpace(code))
                .Select(code => code!.Trim())
                .Distinct(StringComparer.OrdinalIgnoreCase))
            {
                if (departmentNames.ContainsKey(code))
                    continue;

                var department = await DepartmentService.GetSingleDepartmentByResponsibilityAsync(code);
                departmentNames[code] = string.IsNullOrWhiteSpace(department?.DepartmentName)
                    ? code
                    : department!.DepartmentName;
            }
        }
        catch (Exception ex)
        {
            loadError = "تعذر تحميل قائمة التصاريح: " + ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private string GateText(Permit permit)
    {
        var label = StatusMapper.ListStatus(permit).Label;
        if (label is not ("تحت التنفيذ" or "منفذ"))
            return "—";
        return gateLabels.TryGetValue(permit.Id, out var text) && !string.IsNullOrWhiteSpace(text)
            ? text
            : "—";
    }

    private string DepartmentName(string? code)
    {
        if (string.IsNullOrWhiteSpace(code))
            return "—";
        return departmentNames.TryGetValue(code.Trim(), out var name) && !string.IsNullOrWhiteSpace(name)
            ? name
            : code;
    }

    private static string EditHref(Permit permit) => ClassificationKey(permit.classification) switch
    {
        nameof(PermitClassification.Cars) => $"/permits/vehicles/edit/{permit.Id}",
        nameof(PermitClassification.Visitors) => $"/permits/visitors/edit/{permit.Id}",
        _ => $"/permits/materials/edit/{permit.Id}"
    };

    private static string ClassificationKey(string? classification) => classification?.Trim() switch
    {
        "مواد" or "تصريح مواد" => nameof(PermitClassification.Materials),
        "زوار" or "تصريح زوار" => nameof(PermitClassification.Visitors),
        "سيارات" or "مركبات" or "تصريح سيارات" => nameof(PermitClassification.Cars),
        "دخول موظفين" => nameof(PermitClassification.EmployeeAccess),
        _ => classification?.Trim() ?? ""
    };

    private static string ClassificationLabel(string? classification) => ClassificationKey(classification) switch
    {
        nameof(PermitClassification.Materials) => "مواد",
        nameof(PermitClassification.Visitors) => "زوار",
        nameof(PermitClassification.Cars) => "مركبات",
        nameof(PermitClassification.EmployeeAccess) => "دخول موظفين",
        "" => "—",
        var other => other.ToEnumDescription<PermitClassification>()
    };

    private static bool Contains(string? value, string term) =>
        !string.IsNullOrEmpty(value) && value.Contains(term, StringComparison.OrdinalIgnoreCase);

    private async Task ExportExcelAsync()
    {
        exportError = null;
        exporting = true;
        try
        {
            var bytes = ExcelSheet.Build(
                "قائمة التصاريح",
                new[] { "رقم التصريح", "نوع التصريح", "الغرض من التصريح", "تاريخ التصريح", "الجهة الطالبة", "بوابة التنفيذ", "حالة التصريح" },
                FilteredPermits.Select(permit => new string?[]
                {
                    permit.no,
                    ClassificationLabel(permit.classification),
                    string.IsNullOrWhiteSpace(PermitText.Purpose(permit)) ? "—" : PermitText.Purpose(permit),
                    permit.date.ToString("yyyy/MM/dd"),
                    DepartmentName(permit.reqDepartment),
                    GateText(permit),
                    StatusMapper.ListStatus(permit).Label
                }));
            await FileDownload.SaveAsync(JS, "قائمة-التصاريح.xls", bytes);
        }
        catch (Exception ex)
        {
            exportError = "تعذر ترحيل قائمة التصاريح إلى إكسل: " + ex.Message;
        }
        finally
        {
            exporting = false;
        }
    }
}
