@page "/permits/materials/view/{Id:guid}"
@rendermode InteractiveServer
@inject IPermit PermitService
@inject IMaterialPermitService MaterialPermits
@inject IPermitExecutionService Execution
@inject IWorkflowEngine Workflow
@inject IProcedureMovment ProcedureMovmentService
@inject IDepartmentService DepartmentService
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Identity
@using Core.Extensions
@using Services.Permits
@using static Core.Enums.BaseEnums

<PageTitle>عرض تصريح - PMS</PageTitle>

@if (loading)
{
    <div class="text-center p-5"><div class="spinner-border text-warning"></div></div>
}
else if (permit == null)
{
    <div class="alert alert-danger">لم يتم العثور على التصريح.</div>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h3><i class="bi bi-eye-fill text-warning"></i> تصريح رقم: <bdi dir="ltr">@permit.no</bdi></h3>
        <div class="d-flex gap-2 flex-wrap">
            <BackLink Fallback="/permits">العودة للقائمة</BackLink>
            <a class="btn btn-outline-secondary" href="/legacy/Permit/PrintPermitPdf?permitId=@permit.Id" target="_blank">
                <i class="bi bi-printer"></i> طباعة PDF
            </a>
            @if (canSubmit)
            {
                <button class="btn btn-warning" @onclick="SubmitForApprovalAsync">
                    <i class="bi bi-send"></i> إحالة للاعتماد
                </button>
            }
            @if (canCancel)
            {
                <button class="btn btn-outline-danger" @onclick="CancelAsync">
                    <i class="bi bi-x-circle"></i> إلغاء التصريح
                </button>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(actionMessage))
    {
        <div class="alert @(actionOk ? "alert-success" : "alert-danger")">@actionMessage</div>
    }

    @if (visibility.CanApprove || visibility.CanReject || visibility.CanReturn || visibility.CanClose || visibility.CanDelete)
    {
        <div class="card mb-3">
            <div class="card-body d-flex flex-wrap gap-2 align-items-end">
                @if (visibility.CanApprove && currentStep?.StepType == WorkflowStepType.GuardSection)
                {
                    <div style="min-width: 220px;">
                        <label class="form-label mb-1">بوابة التنفيذ</label>
                        <select class="form-select" @bind="executionGateId">
                            <option value="">اختر البوابة</option>
                            @foreach (var gate in gates)
                            {
                                <option value="@gate.Id">@GateText(gate)</option>
                            }
                        </select>
                    </div>
                }
                @if (visibility.CanApprove || visibility.CanReject || visibility.CanReturn)
                {
                    <div class="flex-grow-1">
                        <label class="form-label mb-1">ملاحظة القرار</label>
                        <input class="form-control" @bind="decisionComment" placeholder="إلزامية عند الرفض" />
                    </div>
                }
                @if (visibility.CanApprove)
                {
                    <button class="btn btn-success" @onclick='() => DoActionAsync("approve")'><i class="bi bi-check-circle"></i> اعتماد</button>
                }
                @if (visibility.CanReturn)
                {
                    <button class="btn btn-secondary" @onclick='() => DoActionAsync("return")'><i class="bi bi-arrow-counterclockwise"></i> ترجيع</button>
                }
                @if (visibility.CanReject)
                {
                    <button class="btn btn-danger" @onclick='() => DoActionAsync("reject")'><i class="bi bi-x-circle"></i> رفض</button>
                }
                @if (visibility.CanClose)
                {
                    <button class="btn btn-dark" @onclick='() => DoActionAsync("close")'><i class="bi bi-lock"></i> إغلاق</button>
                }
            </div>
        </div>
    }

    <div class="row g-3">
        <div class="col-md-4">
            <div class="card pms-facts-card">
                <div class="card-header pms-header">البيانات الأساسية</div>
                <div class="pms-facts">
                    <div class="pms-fact"><div class="pms-fact-label">التصنيف</div><div class="pms-fact-value">@ClassificationTitle(permit.classification)</div></div>
                    @if (IsMaterials(permit))
                    {
                        <div class="pms-fact"><div class="pms-fact-label">نوع التصريح</div><div class="pms-fact-value">@Show(permit.type?.ToEnumDescription<EnumPermitType>())</div></div>
                    }
                    <div class="pms-fact"><div class="pms-fact-label">الجهة الطالبة</div><div class="pms-fact-value">@Show(departmentName)</div></div>
                    @if (!IsVisitors(permit))
                    {
                        <div class="pms-fact"><div class="pms-fact-label">الجهة المصرح لها</div><div class="pms-fact-value">@Show(permit.OrgDescription)</div></div>
                    }
                    <div class="pms-fact"><div class="pms-fact-label">تصريح مؤقت</div><div class="pms-fact-value">@(permit.IsTemp ? "نعم" : "لا")</div></div>
                    <div class="pms-fact"><div class="pms-fact-label">التاريخ</div><div class="pms-fact-value">@permit.date.ToString("yyyy/MM/dd")</div></div>
                    @if (!IsVisitors(permit))
                    {
                        <div class="pms-fact"><div class="pms-fact-label">الوقت</div><div class="pms-fact-value">@Show(permit.hourOfEntry)</div></div>
                        <div class="pms-fact"><div class="pms-fact-label">قادم من</div><div class="pms-fact-value">@Show(permit.moveFrom)</div></div>
                        <div class="pms-fact"><div class="pms-fact-label">ذاهب إلى</div><div class="pms-fact-value">@Show(permit.moveTo)</div></div>
                    }
                    <div class="pms-fact"><div class="pms-fact-label">الهاتف</div><div class="pms-fact-value">@Show(permit.phoneNo)</div></div>
                    <div class="pms-fact">
                        <div class="pms-fact-label">الحالة</div>
                        <div class="pms-fact-value"><span class="badge @ListCss()">@StatusText()</span></div>
                    </div>
                    <div class="pms-fact"><div class="pms-fact-label">بداية السريان</div><div class="pms-fact-value">@ShowDate(permit.ValidFrom)</div></div>
                    <div class="pms-fact"><div class="pms-fact-label">نهاية السريان</div><div class="pms-fact-value">@ShowDate(permit.ValidTo)</div></div>
                    @if (!IsVisitors(permit))
                    {
                        <div class="pms-fact"><div class="pms-fact-label">الوقت المتوقع للتنفيذ</div><div class="pms-fact-value">@Show(permit.ExpectedExecutionTime)</div></div>
                    }
                    <div class="pms-fact"><div class="pms-fact-label">اعتماد مناوب</div><div class="pms-fact-value">@(permit.ShiftApproval ? "نعم" : "لا")</div></div>
                    <div class="pms-fact"><div class="pms-fact-label">بوابة التنفيذ</div><div class="pms-fact-value">@GateText(permit.Gate)</div></div>
                    <div class="pms-fact"><div class="pms-fact-label">الغرض من التصريح</div><div class="pms-fact-value">@Show(PermitText.Purpose(permit))</div></div>
                    @if (IsCars(permit))
                    {
                        <div class="pms-fact"><div class="pms-fact-label">الاستخدام</div><div class="pms-fact-value">@(permit.VehicleDetail?.InternalUse == false ? "حركة واحدة" : "استخدام داخلي")</div></div>
                        @if (permit.VehicleDetail?.InternalUse != false)
                        {
                            <div class="pms-fact"><div class="pms-fact-label">عدد الرحلات</div><div class="pms-fact-value">@Math.Max(1, permit.VehicleDetail?.TripCount ?? 1)</div></div>
                        }
                    }
                    @if (IsVisitors(permit))
                    {
                        <div class="pms-fact"><div class="pms-fact-label">الداعي</div><div class="pms-fact-value">@Show(permit.VisitorDetail?.HostName)</div></div>
                        <div class="pms-fact"><div class="pms-fact-label">رقم الملف</div><div class="pms-fact-value">@Show(permit.VisitorDetail?.HostFileNumber)</div></div>
                        <div class="pms-fact"><div class="pms-fact-label">جهة الداعي</div><div class="pms-fact-value">@Show(permit.VisitorDetail?.HostDepartment)</div></div>
                        <div class="pms-fact"><div class="pms-fact-label">جهة الزائر</div><div class="pms-fact-value">@Show(permit.OrgDescription)</div></div>
                        <div class="pms-fact"><div class="pms-fact-label">ساعة الزيارة</div><div class="pms-fact-value">@Show(permit.VisitorDetail?.ExpectedVisitTime)</div></div>
                        <div class="pms-fact"><div class="pms-fact-label">ساعة المغادرة</div><div class="pms-fact-value">@Show(permit.VisitorDetail?.ExpectedDepartureTime)</div></div>
                    }
                    <div class="pms-fact"><div class="pms-fact-label">خطوة الاعتماد</div><div class="pms-fact-value">@StepText()</div></div>
                    <div class="pms-fact"><div class="pms-fact-label">ملاحظات</div><div class="pms-fact-value">@Show(permit.remarks)</div></div>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            @if (!IsCars(permit) && !IsVisitors(permit))
            {
            <div class="card mb-3">
                <div class="card-header pms-header">المواد والمعدات</div>
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead><tr><th>البيان</th><th>الكمية</th><th>الوحدة</th></tr></thead>
                        <tbody>
                            @foreach (var e in permit.EquipmentsAndMatirials)
                            {
                                <tr><td>@e.description</td><td>@e.qty</td><td>@Readable(e.unit)</td></tr>
                            }
                            @if (!permit.EquipmentsAndMatirials.Any())
                            {
                                <tr><td colspan="3" class="text-center text-muted">لا توجد مواد</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            }

            @if (IsVisitors(permit))
            {
            <div class="card mb-3">
                <div class="card-header pms-header">الزوار</div>
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead><tr><th>الاسم</th><th>رقم الهوية</th><th>الجنسية</th></tr></thead>
                        <tbody>
                            @foreach (var visitor in (permit.Visitors ?? new List<PermitVisitor>()).Where(v => !v.isDeleted))
                            {
                                <tr><td>@visitor.Name</td><td>@visitor.IdNumber</td><td>@Readable(visitor.Nationality)</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            }

            @if (IsCars(permit) || permit.Cars.Any(c => !c.isDeleted))
            {
            <div class="card mb-3">
                <div class="card-header pms-header">المركبات</div>
                <div class="table-responsive">
                    <table class="table mb-0">
                        <thead><tr><th>النوع</th><th>رقم اللوحة</th><th>السائق</th><th>الجنسية</th><th>الرخصة</th></tr></thead>
                        <tbody>
                            @foreach (var c in permit.Cars.Where(c => !c.isDeleted))
                            {
                                <tr><td>@c.carType</td><td>@c.carNo</td><td>@c.name</td><td>@Readable(c.nattiunality)</td><td>@c.licenseNo</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            }

            <div class="card">
                <div class="card-header pms-header">سجل الإجراءات</div>
                <div class="table-responsive">
                    <table class="table table-sm mb-0 pms-actions">
                        <thead><tr><th>الإجراء</th><th>بواسطة</th><th>التاريخ</th><th>ملاحظة</th></tr></thead>
                        <tbody>
                            @foreach (var row in actionRows)
                            {
                                <tr>
                                    <td>@row.Action</td>
                                    <td>@row.Who</td>
                                    <td>@row.When</td>
                                    <td>@row.Note</td>
                                </tr>
                            }
                            @if (actionRows.Count == 0)
                            {
                                <tr><td colspan="4" class="text-center text-muted">لا توجد إجراءات بعد</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private bool loading = true;
    private Permit? permit;
    private PermitActionsVisibility visibility = new();
    private User? currentUser;
    private string departmentName = "غير معروف";
    private string? actionMessage;
    private bool actionOk;
    private string decisionComment = "";
    private string executionGateId = "";
    private List<Gate> gates = new();
    private WorkflowStep? currentStep;
    private bool canCancel;
    private bool canSubmit;
    private List<ActionRow> actionRows = new();

    private sealed record ActionRow(DateTime SortOn, string Action, string Who, string When, string Note);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userName = authState.User.Identity?.Name;
        currentUser = userName != null ? await UserManager.FindByNameAsync(userName) : null;

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        permit = await PermitService.GetPermitByIdAsync(Id);
        if (permit != null)
        {
            var dept = await DepartmentService.GetSingleDepartmentByResponsibilityAsync(permit.reqDepartment ?? "");
            departmentName = dept?.DepartmentName ?? "غير معروف";

            if (currentUser != null)
            {
                var sameCenter = await MaterialPermits.GetSameCenterUserNamesAsync(currentUser);
                var ownCenter = !string.IsNullOrWhiteSpace(permit.createdBy) && sameCenter.Contains(permit.createdBy);
                var followOnly = !ownCenter && await MaterialPermits.WasApprovedByAsync(permit.Id, currentUser.Id);

                if (followOnly)
                {
                    visibility = new PermitActionsVisibility();
                    canSubmit = false;
                    canCancel = false;
                }
                else
                {
                    visibility = PermitService.GetVisibility(currentUser, permit);
                    if (permit.UnifiedStatus == nameof(UnifiedPermitStatus.Draft))
                    {
                        visibility.CanApprove = false;
                        visibility.CanReject = false;
                        visibility.CanReturn = false;
                        visibility.CanClose = false;
                    }
                    else if (ShiftDuty.IsPending(permit))
                    {
                        var canDecide = ShiftDuty.IsOfficer(currentUser);
                        visibility.CanApprove = canDecide;
                        visibility.CanReject = canDecide;
                        visibility.CanReturn = canDecide;
                    }
                    else if (permit.WorkflowDefinitionId != null)
                    {
                        var canDecide = await Workflow.UserCanDecideAsync(permit.Id, currentUser);
                        visibility.CanApprove = canDecide;
                        visibility.CanReject = canDecide;
                        visibility.CanReturn = canDecide;
                    }

                    canSubmit = MaterialPermitService.CanEdit(permit, currentUser, sameCenter);
                    canCancel = !StatusMapper.IsApprovedOrExecuted(permit)
                        && permit.UnifiedStatus != nameof(UnifiedPermitStatus.Cancelled)
                        && permit.status != 'D'
                        && ownCenter;
                }
            }

            actionRows = await BuildActionRowsAsync();
            currentStep = await Workflow.GetCurrentStepAsync(permit.Id);
            if (gates.Count == 0)
                gates = await Execution.GetActiveGatesAsync();
        }
        loading = false;
    }

    private async Task DoActionAsync(string actionType)
    {
        if (permit == null || currentUser == null) return;
        actionMessage = null;
        actionOk = false;

        try
        {
            if (actionType is "approve" or "reject" or "return")
            {
                var decision = actionType switch
                {
                    "reject" => ApprovalDecision.Rejected,
                    "return" => ApprovalDecision.Returned,
                    _ => ApprovalDecision.Approved
                };
                Guid? gateId = null;
                if (decision == ApprovalDecision.Approved && currentStep?.StepType == WorkflowStepType.GuardSection)
                {
                    if (!Guid.TryParse(executionGateId, out var parsed))
                        throw new InvalidOperationException("حدد بوابة التنفيذ قبل الاعتماد.");
                    gateId = parsed;
                }

                await MaterialPermits.DecideAsync(permit.Id, currentUser, decision, decisionComment, gateId);
                decisionComment = "";
            }
            else
            {
                var movement = new ProcedureMovment
                {
                    permitId = permit.Id,
                    donedBy = currentUser.FullName,
                    doneAs = currentUser.JobtypeName,
                    shift = "A",
                    doneOn = DateTime.Now,
                    procedureType = actionType
                };

                await ProcedureMovmentService.InsertProcedureMovment(movement);

                switch (actionType)
                {
                    case "close":
                        permit.status = 'C';
                        permit.statusDescription = "مغلق / تم التنفيذ";
                        permit.isClosed = true;
                        permit.closeOn = DateTime.Now;
                        break;
                    case "delete":
                        permit.status = 'D';
                        permit.UnifiedStatus = nameof(UnifiedPermitStatus.Cancelled);
                        permit.isDeleted = true;
                        permit.deletedBy = currentUser.FullName;
                        permit.deletedOn = DateTime.Now;
                        break;
                }

                await PermitService.UpdatePermitAsync(permit);
            }

            actionOk = true;
            actionMessage = actionType switch
            {
                "approve" => "تم اعتماد التصريح.",
                "reject" => "تم رفض التصريح.",
                "return" => "تم ترجيع التصريح.",
                "close" => "تم إغلاق التصريح.",
                "delete" => "تم حذف التصريح.",
                _ => "تم تنفيذ العملية."
            };
        }
        catch (Exception ex)
        {
            actionOk = false;
            actionMessage = ex.Message;
        }

        await LoadAsync();
    }

    private async Task SubmitForApprovalAsync()
    {
        if (permit == null || currentUser == null) return;
        actionMessage = null;
        try
        {
            await MaterialPermits.SubmitDraftAsync(permit.Id, currentUser);
            actionOk = true;
        }
        catch (Exception ex)
        {
            actionOk = false;
            actionMessage = ex.Message;
        }

        await LoadAsync();
        if (actionOk)
        {
            var label = permit == null ? "" : StatusMapper.ListStatus(permit).Label;
            actionMessage = label == "معتمد"
                ? "أُحيل التصريح وأصبح معتمداً لأن مساره لا يحتاج اعتماداً."
                : "تمت إحالة التصريح للاعتماد.";
        }
    }

    private string StatusText()
    {
        if (permit == null) return "";
        return StatusMapper.ListStatus(permit).Label;
    }

    private string ListCss() => permit == null ? "" : StatusMapper.ListStatus(permit).Css;

    private static string Show(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value.Trim();

    private static string ShowDate(DateTime? value) => value?.ToString("yyyy/MM/dd") ?? "—";

    private async Task CancelAsync()
    {
        if (permit == null || currentUser == null) return;
        actionMessage = null;
        try
        {
            await MaterialPermits.CancelAsync(permit.Id, currentUser);
            actionOk = true;
            actionMessage = "تم إلغاء التصريح.";
        }
        catch (Exception ex)
        {
            actionOk = false;
            actionMessage = ex.Message;
        }

        await LoadAsync();
    }

    private string StepText()
    {
        if (permit != null && ShiftDuty.IsPending(permit))
            return ShiftDuty.StepLabel;
        return currentStep == null ? "—" : currentStep.StepType.GetDescription();
    }

    private static bool IsMaterials(Permit item)
    {
        var classification = item.classification?.Trim() ?? "";
        return classification.Equals(nameof(PermitClassification.Materials), StringComparison.OrdinalIgnoreCase)
            || classification is "مواد" or "تصريح مواد";
    }

    private static bool IsVisitors(Permit item) =>
        string.Equals(item.classification, nameof(PermitClassification.Visitors), StringComparison.OrdinalIgnoreCase)
        || item.classification is "زوار" or "تصريح زوار";

    private static bool IsCars(Permit item) =>
        string.Equals(item.classification, nameof(PermitClassification.Cars), StringComparison.OrdinalIgnoreCase)
        || item.classification is "سيارات" or "مركبات" or "تصريح سيارات";

    private static string ClassificationTitle(string? classification) => classification?.Trim() switch
    {
        nameof(PermitClassification.Cars) or "سيارات" or "مركبات" or "تصريح سيارات" => "تصريح مركبات",
        nameof(PermitClassification.Visitors) or "زوار" or "تصريح زوار" => "تصريح زوار",
        nameof(PermitClassification.EmployeeAccess) or "دخول موظفين" => "دخول موظفين",
        _ => "تصريح مواد"
    };

    private async Task<List<ActionRow>> BuildActionRowsAsync()
    {
        var rows = new List<ActionRow>();
        if (permit == null)
            return rows;

        foreach (var step in permit.Procedures)
        {
            rows.Add(new ActionRow(
                step.doneOn ?? DateTime.MinValue,
                ActionLabel(step.procedureType),
                Actor(step.donedBy, step.doneAs),
                step.doneOn?.ToString("yyyy/MM/dd HH:mm") ?? "",
                step.remarks ?? ""));
        }

        foreach (var approval in permit.Approvals)
        {
            var verb = approval.Decision switch
            {
                ApprovalDecision.Approved => "اعتمده",
                ApprovalDecision.Rejected => "رفضه",
                ApprovalDecision.Returned => "أرجعه",
                _ => approval.Decision.GetDescription()
            };
            var when = approval.DecidedOn.ToString("yyyy/MM/dd HH:mm");
            if (rows.Any(r => r.Action == verb && Math.Abs((r.SortOn - approval.DecidedOn).TotalMinutes) < 2))
                continue;

            var who = "—";
            if (!string.IsNullOrWhiteSpace(approval.ApproverUserId))
            {
                var approver = await UserManager.FindByIdAsync(approval.ApproverUserId);
                who = approver == null
                    ? approval.ApproverUserId
                    : Actor(approver.FullName, approver.JobtypeName);
            }

            rows.Add(new ActionRow(approval.DecidedOn, verb, who, when, approval.Comment ?? ""));
        }

        return rows.OrderBy(r => r.SortOn).ToList();
    }

    private static string ActionLabel(string? procedureType) => (procedureType ?? "").ToLowerInvariant() switch
    {
        "insert" => "أدخله",
        "submit" => "أحاله للاعتماد",
        "update" => "عدله",
        "approve" => "اعتمده",
        "reject" => "رفضه",
        "return" => "أرجعه",
        "delete" => "ألغاه",
        "close" => "نفّذه",
        "expire" => "أغلقه",
        "entry" => "سجّل دخوله",
        "exit" => "سجّل خروجه",
        _ => string.IsNullOrWhiteSpace(procedureType) ? "—" : procedureType
    };

    private static string Actor(string? fullName, string? role)
    {
        var name = ShortName(fullName);
        var title = role?.Trim();
        if (name == "—" || string.IsNullOrWhiteSpace(title) || title == name)
            return name;
        return name + " — " + title;
    }

    private static string ShortName(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName))
            return "—";
        var parts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length <= 2)
            return string.Join(' ', parts);
        return parts[0] + " " + parts[^1];
    }

    private static string Readable(string? value) =>
        string.IsNullOrWhiteSpace(value) ? "—" : value.Replace('_', ' ');

    private static string GateText(Gate? gate)
    {
        if (gate == null)
            return "—";
        var number = gate.no?.Trim() ?? "";
        var description = gate.description?.Trim() ?? "";
        if (number.Length == 0 && description.Length == 0)
            return "—";
        if (number.Length == 0)
            return description;
        return description.Length == 0 ? number : number + " - " + description;
    }
}
