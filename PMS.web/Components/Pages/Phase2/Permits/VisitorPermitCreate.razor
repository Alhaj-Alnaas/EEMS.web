@page "/permits/visitors/create"
@rendermode InteractiveServer
@inject IPermit PermitService
@inject IMaterialPermitService MaterialPermits
@inject IDepartmentService DepartmentService
@inject IEmployeeService Employees
@inject IHrEmployeeLookupService HrLookup
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Identity

<PageTitle>تصريح زوار جديد - PMS</PageTitle>

<div class="pms-create-page">
<h3 class="mb-1"><i class="bi bi-person-badge text-warning"></i> إضافة تصريح زوار</h3>
<p class="text-muted small mb-2">يُحفظ كمسودة أو يُحال لمسار اعتماد الزوار، أو لاعتماد المناوب إذا كانت علامته مفعّلة. التنفيذ يسجّل الدخول ثم المغادرة.</p>

@if (loading)
{
    <div class="text-center p-5"><div class="spinner-border text-warning"></div></div>
}
else
{
    <EditForm Model="request" class="pms-create-form" OnSubmit="PreventSubmit">
        <div class="pms-create-body">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card pms-basic-card">
                    <div class="card-header pms-header">البيانات الأساسية</div>
                    <div class="card-body pms-basic-scroll">
                        <div class="form-check form-switch mb-3">
                            <InputCheckbox class="form-check-input" @bind-Value="request.IsTemp" id="isTemp" />
                            <label class="form-check-label fw-bold" for="isTemp">تصريح مؤقت</label>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">رقم التصريح</label>
                            <input class="form-control text-center pms-permit-no" value="@request.PermitNumber" readonly />
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-7">
                                <label class="form-label">تاريخ التصريح</label>
                                <InputDate class="form-control" @bind-Value="request.PermitDate" @bind-Value:after="ApplyShiftApproval" />
                            </div>
                            <div class="col-5">
                                <label class="form-label">الوقت</label>
                                <InputText type="time" class="form-control" @bind-Value="request.HourOfEntry" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">ساري حتى</label>
                            <InputDate class="form-control" @bind-Value="request.ValidTo" />
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6">
                                <label class="form-label fw-bold">ساعة الزيارة</label>
                                <InputText type="time" class="form-control" @bind-Value="request.ExpectedVisitTime" @bind-Value:after="ApplyShiftApproval" />
                            </div>
                            <div class="col-6">
                                <label class="form-label fw-bold">ساعة المغادرة</label>
                                <InputText type="time" class="form-control" @bind-Value="request.ExpectedDepartureTime" />
                            </div>
                        </div>
                        <div class="form-check form-switch mb-3">
                            <InputCheckbox class="form-check-input" @bind-Value="request.ShiftApproval" id="shiftApproval" />
                            <label class="form-check-label fw-bold" for="shiftApproval">اعتماد مناوب</label>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">الغرض من الزيارة <span class="text-warning">*</span></label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="request.Purpose" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">الجهة الطالبة</label>
                            <InputSelect class="form-select" @bind-Value="request.RequestingDepartmentCode">
                                <option value="">-- اختر الجهة الطالبة --</option>
                                @foreach (var dep in departments)
                                {
                                    <option value="@dep.RespCode">@dep.DepartmentName</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">جهة الزائر</label>
                            <InputText class="form-control" @bind-Value="request.VisitorOrganization" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">رقم الهاتف</label>
                            <InputText class="form-control" @bind-Value="request.Phone" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">رقم ملف الداعي</label>
                            <div class="input-group">
                                <InputText class="form-control" @bind-Value="request.HostFileNumber" />
                                <button type="button" class="btn btn-outline-secondary" @onclick="LookupHostAsync">عرض</button>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">اسم الداعي</label>
                            <input class="form-control pms-readonly" value="@request.HostName" readonly />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">جهة الداعي</label>
                            <input class="form-control pms-readonly" value="@request.HostDepartment" readonly />
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-8 pms-side-scroll">
                <div class="card mb-3">
                    <div class="card-header pms-header d-flex justify-content-between align-items-center">
                        <span>الزوار <span class="text-warning">*</span></span>
                        <button type="button" class="btn btn-sm btn-light" @onclick="AddVisitor"><i class="bi bi-plus-circle"></i> إضافة زائر</button>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-bordered mb-0">
                                <thead>
                                    <tr>
                                        <th>الاسم</th>
                                        <th>رقم الهوية</th>
                                        <th>الجنسية</th>
                                        <th style="width:50px"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var visitor in request.Visitors)
                                    {
                                        <tr @key="visitor">
                                            <td><input class="form-control" @bind="visitor.Name" /></td>
                                            <td><input class="form-control" @bind="visitor.IdNumber" /></td>
                                            <td>
                                                <select class="form-select" @bind="visitor.Nationality">
                                                    @foreach (var nationality in Enum.GetValues<Nationality>())
                                                    {
                                                        <option value="@nationality">@nationality.ToString().Replace('_', ' ')</option>
                                                    }
                                                </select>
                                            </td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => request.Visitors.Remove(visitor)"><i class="bi bi-trash"></i></button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header pms-header d-flex justify-content-between align-items-center">
                        <span>المركبة إن وجدت</span>
                        <button type="button" class="btn btn-sm btn-light" @onclick="AddVehicle"><i class="bi bi-plus-circle"></i> إضافة مركبة</button>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-bordered mb-0">
                                <thead>
                                    <tr>
                                        <th>رقم اللوحة</th>
                                        <th>نوع المركبة</th>
                                        <th>السائق</th>
                                        <th>رخصة القيادة</th>
                                        <th style="width:50px"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var vehicle in request.Vehicles)
                                    {
                                        <tr @key="vehicle">
                                            <td><input class="form-control" @bind="vehicle.CarNo" /></td>
                                            <td><input class="form-control" @bind="vehicle.CarType" /></td>
                                            <td><input class="form-control" @bind="vehicle.DriverName" /></td>
                                            <td><input class="form-control" @bind="vehicle.licenseNo" /></td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => request.Vehicles.Remove(vehicle)"><i class="bi bi-trash"></i></button>
                                            </td>
                                        </tr>
                                    }
                                    @if (request.Vehicles.Count == 0)
                                    {
                                        <tr><td colspan="5" class="text-center text-muted py-3">لا توجد مركبة</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">ملاحظات</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="request.Notes" />
                </div>
            </div>
        </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-2 mb-0">@errorMessage</div>
        }

        <div class="pms-create-actions">
            <button type="button" class="btn btn-outline-secondary px-4" @onclick="() => SaveAsync(false)" disabled="@saving">
                <i class="bi bi-save"></i> حفظ مسودة
            </button>
            <button type="button" class="btn btn-warning px-4" @onclick="() => SaveAsync(true)" disabled="@saving">
                <i class="bi bi-send"></i> إرسال للاعتماد
            </button>
            <BackLink Fallback="/permits" Css="btn btn-outline-secondary px-4">إلغاء</BackLink>
        </div>
    </EditForm>
}
</div>

@code {
    private bool loading = true;
    private bool saving;
    private string? errorMessage;
    private VisitorPermitRequest request = new();
    private List<DepartmentDto> departments = new();
    private User? currentUser;

    protected override async Task OnInitializedAsync()
    {
        request.PermitDate = DateTime.Now;
        request.ValidTo = DateTime.Today;
        request.HourOfEntry = DateTime.Now.ToString("HH:mm");
        request.Visitors.Add(new VisitorLineViewModel());
        ApplyShiftApproval();

        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userName = authState.User.Identity?.Name;
            currentUser = userName != null ? await UserManager.FindByNameAsync(userName) : null;
            request.PermitNumber = await PermitService.GeneratePermitSerialNumberAsync(nameof(PermitClassification.Visitors));

            if (currentUser != null && !string.IsNullOrWhiteSpace(currentUser.ResponsibilityCode))
            {
                departments = await DepartmentService.GetDepartmentsByResponsibilityAsync(currentUser.ResponsibilityCode);
                if (departments.Count == 0)
                {
                    departments.Add(new DepartmentDto
                    {
                        RespCode = currentUser.ResponsibilityCode,
                        DepartmentName = string.IsNullOrWhiteSpace(currentUser.Department) ? currentUser.ResponsibilityCode : currentUser.Department
                    });
                }

                if (departments.Count == 1)
                    request.RequestingDepartmentCode = departments[0].RespCode ?? "";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "تعذر تحميل بيانات التصريح: " + ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private void ApplyShiftApproval()
    {
        if (NeedsShiftApproval(request.PermitDate, request.ExpectedVisitTime))
            request.ShiftApproval = true;
    }

    private static bool NeedsShiftApproval(DateTime permitDate, string? expectedTime)
    {
        if (permitDate.DayOfWeek is DayOfWeek.Friday or DayOfWeek.Saturday)
            return true;
        if (!TimeSpan.TryParse(expectedTime, out var time))
            return false;
        return time >= TimeSpan.FromHours(15) || time <= TimeSpan.FromHours(8);
    }

    private async Task LookupHostAsync()
    {
        errorMessage = null;
        var file = request.HostFileNumber?.Trim();
        if (string.IsNullOrWhiteSpace(file))
        {
            errorMessage = "أدخل رقم ملف الداعي.";
            return;
        }

        try
        {
            var employee = await Employees.GetByFileNumberAsync(file);
            if (employee != null)
            {
                request.HostEmployeeId = employee.Id;
                request.HostName = employee.FullName;
                request.HostDepartment = !string.IsNullOrWhiteSpace(employee.DepartmentName)
                    ? employee.DepartmentName
                    : employee.Department?.NameAr;
                return;
            }

            var hr = await HrLookup.LookupAsync(file);
            if (!hr.Success || string.IsNullOrWhiteSpace(hr.FullName))
            {
                request.HostEmployeeId = null;
                request.HostName = "";
                request.HostDepartment = "";
                errorMessage = string.IsNullOrWhiteSpace(hr.Error) ? "لم يتم العثور على الموظف." : hr.Error;
                return;
            }

            request.HostEmployeeId = null;
            request.HostName = hr.FullName;
            request.HostDepartment = hr.DepartmentName;
        }
        catch (Exception ex)
        {
            errorMessage = "تعذر جلب بيانات الموظف: " + ex.Message;
        }
    }

    private void AddVisitor() => request.Visitors.Add(new VisitorLineViewModel());
    private void AddVehicle() => request.Vehicles.Add(new CarMovmentViewModel());
    private Task PreventSubmit(EditContext _) => SaveAsync(true);

    private async Task SaveAsync(bool submit)
    {
        if (saving) return;
        errorMessage = null;
        saving = true;
        try
        {
            if (currentUser == null)
                throw new InvalidOperationException("المستخدم غير معروف.");
            await MaterialPermits.SaveVisitorAsync(request, currentUser, submit);
            Navigation.NavigateTo(ReturnUrl.Read(Navigation) ?? "/permits");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }
}
