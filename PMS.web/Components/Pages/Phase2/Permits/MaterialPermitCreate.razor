@page "/permits/materials/create"
@rendermode InteractiveServer
@inject IPermit PermitService
@inject IMaterialPermitService MaterialPermits
@inject IDepartmentService DepartmentService
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Identity
@using Core.Entities.DTOs
@using static Core.Enums.BaseEnums

<PageTitle>تصريح مواد جديد - PMS</PageTitle>

<h3 class="mb-1"><i class="bi bi-box-arrow-in-down-right text-warning"></i> إضافة تصريح مواد جديد</h3>
<p class="text-muted small mb-4">  بعد اكتمال الاعتماد يصبح التصريح نشطاً</p>

@if (loading)
{
    <div class="text-center p-5"><div class="spinner-border text-warning"></div></div>
}
else
{
    <EditForm Model="model" OnSubmit="PreventSubmit">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header pms-header">البيانات الأساسية</div>
                    <div class="card-body">
                        <div class="form-check form-switch mb-3">
                            <InputCheckbox class="form-check-input" @bind-Value="model.IsTemp" id="isTemp" />
                            <label class="form-check-label fw-bold" for="isTemp">تصريح مؤقت</label>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">رقم التصريح</label>
                            <input class="form-control text-center fw-bold text-warning" value="@model.No" readonly />
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-7">
                                <label class="form-label">تاريخ التصريح</label>
                                <InputDate class="form-control" @bind-Value="model.Date" @bind-Value:after="ApplyShiftApproval" />
                            </div>
                            <div class="col-5">
                                <label class="form-label">الوقت</label>
                                <InputText type="time" class="form-control" @bind-Value="model.HourOfEntry" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">نوع التصريح</label>
                            <InputSelect class="form-select" @bind-Value="model.Type">
                                <option value="@EnumPermitType.Export">استخراج</option>
                                <option value="@EnumPermitType.Import">إدخال</option>
                                <option value="@EnumPermitType.ExtractAndInsert">إستخراج وإدخال</option>
                            </InputSelect>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">ساري حتى</label>
                            <InputDate class="form-control" @bind-Value="validTo" />
                        </div>

                        <div class="row g-2 mb-3 align-items-center">
                            <div class="col-7">
                                <label class="form-label fw-bold">الوقت المتوقع للتنفيذ</label>
                                <InputText type="time" class="form-control" @bind-Value="expectedExecutionTime" @bind-Value:after="ApplyShiftApproval" />
                            </div>
                            <div class="col-5">
                                <div class="form-check form-switch mt-4">
                                    <InputCheckbox class="form-check-input" @bind-Value="shiftApproval" id="shiftApproval" />
                                    <label class="form-check-label fw-bold" for="shiftApproval">اعتماد مناوب</label>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">الغرض</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="purpose" placeholder="الغرض من الإخراج أو الإدخال" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">الجهة الطالبة</label>
                            <InputSelect class="form-select" @bind-Value="selectedRespCode">
                                <option value="">-- اختر الجهة الطالبة --</option>
                                @foreach (var dep in departments)
                                {
                                    <option value="@dep.RespCode">@dep.DepartmentName</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">الجهة المصرح لها</label>
                            <InputText class="form-control" @bind-Value="model.OrgDescription" placeholder="وصف الجهة" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">رقم الهاتف</label>
                            <InputText class="form-control" @bind-Value="model.PhoneNo" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">قادم من</label>
                            <InputText class="form-control" @bind-Value="model.MoveFrom" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">ذاهب إلى</label>
                            <InputText class="form-control" @bind-Value="model.MoveTo" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-8">
                <div class="card mb-3">
                    <div class="card-header pms-header d-flex justify-content-between align-items-center">
                        <span>المواد والمعدات <span class="text-warning">*</span></span>
                        <button type="button" class="btn btn-sm btn-light" @onclick="AddEquipmentRow">
                            <i class="bi bi-plus-circle"></i> إضافة مادة
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-bordered mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>اسم المادة/المعدة</th>
                                        <th style="width:120px">الكمية</th>
                                        <th style="width:160px">الوحدة</th>
                                        <th style="width:50px"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < model.EquipmentsAndMaterials.Count; i++)
                                    {
                                        var idx = i;
                                        <tr>
                                            <td><input class="form-control" @bind="model.EquipmentsAndMaterials[idx].ItemName" /></td>
                                            <td><input type="number" class="form-control" @bind="model.EquipmentsAndMaterials[idx].Quantity" /></td>
                                            <td>
                                                <select class="form-select" @bind="model.EquipmentsAndMaterials[idx].Unit">
                                                    @foreach (var u in Enum.GetValues<UnitType>())
                                                    {
                                                        <option value="@u">@u.ToString().Replace('_', ' ')</option>
                                                    }
                                                </select>
                                            </td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => model.EquipmentsAndMaterials.RemoveAt(idx)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                    @if (model.EquipmentsAndMaterials.Count == 0)
                                    {
                                        <tr><td colspan="4" class="text-center text-muted py-3">لا توجد مواد مضافة</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header pms-header d-flex justify-content-between align-items-center">
                        <span>السيارات</span>
                        <button type="button" class="btn btn-sm btn-light" @onclick="AddCarRow">
                            <i class="bi bi-plus-circle"></i> إضافة سيارة
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-bordered mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>رقم السيارة</th>
                                        <th>نوع السيارة</th>
                                        <th>اسم السائق</th>
                                        <th>جنسية السائق</th>
                                        <th>رخصة القيادة</th>
                                        <th style="width:50px"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < model.Cars.Count; i++)
                                    {
                                        var idx = i;
                                        <tr>
                                            <td><input class="form-control" @bind="model.Cars[idx].CarNo" /></td>
                                            <td><input class="form-control" @bind="model.Cars[idx].CarType" /></td>
                                            <td><input class="form-control" @bind="model.Cars[idx].DriverName" /></td>
                                            <td>
                                                <select class="form-select" @bind="model.Cars[idx].driverNationality">
                                                    @foreach (var n in Enum.GetValues<Nationality>())
                                                    {
                                                        <option value="@n">@n.ToString().Replace('_', ' ')</option>
                                                    }
                                                </select>
                                            </td>
                                            <td><input class="form-control" @bind="model.Cars[idx].licenseNo" /></td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => model.Cars.RemoveAt(idx)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                    @if (model.Cars.Count == 0)
                                    {
                                        <tr><td colspan="6" class="text-center text-muted py-3">لا توجد سيارات مضافة</td></tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">ملاحظات</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="model.Notes" />
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-3">@errorMessage</div>
        }

        <div class="mt-4 text-center">
            <button type="button" class="btn btn-outline-secondary px-4" @onclick="() => SaveAsync(false)" disabled="@saving">
                <i class="bi bi-save"></i> حفظ مسودة
            </button>
            <button type="button" class="btn btn-warning px-4" @onclick="() => SaveAsync(true)" disabled="@saving">
                <i class="bi bi-send"></i> إرسال للاعتماد
            </button>
            <BackLink Fallback="/permits" Css="btn btn-outline-secondary px-4">إلغاء</BackLink>
        </div>
    </EditForm>
}

@code {
    private bool loading = true;
    private bool saving;
    private string? errorMessage;
    private PermitViewModel model = new();
    private List<DepartmentDto> departments = new();
    private string selectedRespCode = "";
    private string purpose = "";
    private DateTime validTo = DateTime.Today;
    private string expectedExecutionTime = "";
    private bool shiftApproval;
    private User? currentUser;

    protected override async Task OnInitializedAsync()
    {
        model.Date = DateTime.Now;
        validTo = DateTime.Today;
        model.HourOfEntry = DateTime.Now.ToString("HH:mm");
        ApplyShiftApproval();
        if (model.EquipmentsAndMaterials.Count == 0)
            model.EquipmentsAndMaterials.Add(new EquipMatiMovmentViewModel());

        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userName = authState.User.Identity?.Name;
            currentUser = userName != null ? await UserManager.FindByNameAsync(userName) : null;

            model.No = await PermitService.GeneratePermitSerialNumberAsync("Materials");

            if (currentUser != null && !string.IsNullOrWhiteSpace(currentUser.ResponsibilityCode))
            {
                departments = await DepartmentService.GetDepartmentsByResponsibilityAsync(currentUser.ResponsibilityCode);
                if (departments.Count == 0)
                {
                    departments.Add(new DepartmentDto
                    {
                        RespCode = currentUser.ResponsibilityCode,
                        DepartmentName = string.IsNullOrWhiteSpace(currentUser.Department)
                            ? currentUser.ResponsibilityCode
                            : currentUser.Department
                    });
                }

                if (departments.Count == 1)
                    selectedRespCode = departments[0].RespCode ?? "";
            }
        }
        catch (Exception ex)
        {
            errorMessage = "تعذر تحميل بيانات التصريح: " + ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private void ApplyShiftApproval()
    {
        if (NeedsShiftApproval(model.Date, expectedExecutionTime))
            shiftApproval = true;
    }

    private static bool NeedsShiftApproval(DateTime permitDate, string? expectedTime)
    {
        if (permitDate.DayOfWeek is DayOfWeek.Friday or DayOfWeek.Saturday)
            return true;

        if (!TimeSpan.TryParse(expectedTime, out var time))
            return false;

        return time >= TimeSpan.FromHours(15) || time <= TimeSpan.FromHours(8);
    }

    private void AddEquipmentRow() => model.EquipmentsAndMaterials.Add(new EquipMatiMovmentViewModel());
    private void AddCarRow() => model.Cars.Add(new CarMovmentViewModel());

    private Task PreventSubmit(EditContext _) => SaveAsync(true);

    private async Task SaveAsync(bool submit)
    {
        if (saving) return;
        errorMessage = null;
        saving = true;
        try
        {
            var request = new MaterialPermitRequest
            {
                PermitNumber = model.No,
                Type = model.Type,
                IsTemp = model.IsTemp,
                PermitDate = model.Date,
                HourOfEntry = model.HourOfEntry,
                ValidTo = validTo,
                ExpectedExecutionTime = expectedExecutionTime,
                ShiftApproval = shiftApproval,
                RequestingDepartmentCode = selectedRespCode,
                AuthorizedParty = model.OrgDescription,
                Phone = model.PhoneNo,
                MoveFrom = model.MoveFrom,
                MoveTo = model.MoveTo,
                Purpose = purpose,
                Notes = model.Notes,
                Items = model.EquipmentsAndMaterials,
                Cars = model.Cars
            };

            var id = await MaterialPermits.SaveAsync(request, currentUser!, submit);
            Navigation.NavigateTo(ReturnUrl.Read(Navigation) ?? "/permits");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }
}
