@page "/permits/vehicles/edit/{Id:guid}"
@rendermode InteractiveServer
@inject IPermit PermitService
@inject IMaterialPermitService MaterialPermits
@inject IDepartmentService DepartmentService
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@using Microsoft.AspNetCore.Identity
@using Services.Permits

<PageTitle>تعديل تصريح مركبات - PMS</PageTitle>

<h3 class="mb-4"><i class="bi bi-truck text-warning"></i> تعديل تصريح مركبات</h3>

@if (loading)
{
    <div class="text-center p-5"><div class="spinner-border text-warning"></div></div>
}
else if (request == null)
{
    <div class="alert alert-warning">@errorMessage</div>
    <BackLink Fallback="/permits">العودة للقائمة</BackLink>
}
else
{
    <EditForm Model="request" OnSubmit="PreventSubmit">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card">
                    <div class="card-header pms-header">البيانات الأساسية</div>
                    <div class="card-body">
                        <div class="form-check form-switch mb-3">
                            <InputCheckbox class="form-check-input" @bind-Value="request.IsTemp" id="isTemp" />
                            <label class="form-check-label fw-bold" for="isTemp">تصريح مؤقت</label>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">رقم التصريح</label>
                            <input class="form-control text-center fw-bold" value="@request.PermitNumber" readonly />
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-7">
                                <label class="form-label">تاريخ التصريح</label>
                                <InputDate class="form-control" @bind-Value="request.PermitDate" @bind-Value:after="ApplyShiftApproval" />
                            </div>
                            <div class="col-5">
                                <label class="form-label">الوقت</label>
                                <InputText type="time" class="form-control" @bind-Value="request.HourOfEntry" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">ساري حتى</label>
                            <InputDate class="form-control" @bind-Value="request.ValidTo" />
                        </div>
                        <div class="row g-2 mb-3 align-items-center">
                            <div class="col-7">
                                <label class="form-label fw-bold">الوقت المتوقع للتنفيذ</label>
                                <InputText type="time" class="form-control" @bind-Value="request.ExpectedExecutionTime" @bind-Value:after="ApplyShiftApproval" />
                            </div>
                            <div class="col-5">
                                <div class="form-check form-switch mt-4">
                                    <InputCheckbox class="form-check-input" @bind-Value="request.ShiftApproval" id="shiftApproval" />
                                    <label class="form-check-label fw-bold" for="shiftApproval">اعتماد مناوب</label>
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">الغرض</label>
                            <InputTextArea class="form-control" rows="2" @bind-Value="request.Purpose" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">الجهة الطالبة</label>
                            <InputSelect class="form-select" @bind-Value="request.RequestingDepartmentCode">
                                <option value="">-- اختر الجهة الطالبة --</option>
                                @foreach (var dep in departments)
                                {
                                    <option value="@dep.RespCode">@dep.DepartmentName</option>
                                }
                            </InputSelect>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">الجهة المسؤولة عن المركبة</label>
                            <InputText class="form-control" @bind-Value="request.ResponsibleParty" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">رقم الهاتف</label>
                            <InputText class="form-control" @bind-Value="request.Phone" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">قادم من</label>
                            <InputText class="form-control" @bind-Value="request.MoveFrom" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">ذاهب إلى</label>
                            <InputText class="form-control" @bind-Value="request.MoveTo" />
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-8">
                <div class="card mb-3">
                    <div class="card-header pms-header d-flex justify-content-between align-items-center">
                        <span>المركبات</span>
                        <button type="button" class="btn btn-sm btn-light" @onclick="AddVehicle"><i class="bi bi-plus-circle"></i> إضافة مركبة</button>
                    </div>
                    <div class="card-body p-0">
                        <table class="table table-bordered mb-0">
                            <thead>
                                <tr>
                                    <th>رقم اللوحة</th>
                                    <th>نوع المركبة</th>
                                    <th>السائق</th>
                                    <th>رخصة القيادة</th>
                                    <th style="width:50px"></th>
                                </tr>
                            </thead>
                                <tbody>
                                    @foreach (var vehicle in request.Vehicles)
                                    {
                                        <tr @key="vehicle">
                                            <td><input class="form-control" @bind="vehicle.CarNo" /></td>
                                            <td><input class="form-control" @bind="vehicle.CarType" /></td>
                                            <td><input class="form-control" @bind="vehicle.DriverName" /></td>
                                            <td><input class="form-control" @bind="vehicle.licenseNo" /></td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => request.Vehicles.Remove(vehicle)"><i class="bi bi-trash"></i></button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                        </table>
                    </div>
                </div>
                <div class="card mb-3">
                    <div class="card-header pms-header">التنفيذ</div>
                    <div class="card-body">
                        <div class="form-check form-switch mb-3">
                            <InputCheckbox class="form-check-input" @bind-Value="request.InternalUse" id="internalUse" />
                            <label class="form-check-label fw-bold" for="internalUse">استخدام داخلي</label>
                        </div>
                        @if (request.InternalUse)
                        {
                            <div style="max-width:220px">
                                <label class="form-label fw-bold">عدد الرحلات</label>
                                <InputNumber class="form-control" @bind-Value="request.TripCount" />
                            </div>
                        }
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">ملاحظات</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="request.Notes" />
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-3">@errorMessage</div>
        }

        <div class="mt-4 text-center">
            <button type="button" class="btn btn-warning px-4" @onclick="SaveAsync" disabled="@saving">
                <i class="bi bi-save"></i> حفظ التعديل
            </button>
            <BackLink Fallback="/permits" Css="btn btn-outline-secondary px-4">إلغاء</BackLink>
        </div>
    </EditForm>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private bool loading = true;
    private bool saving;
    private string? errorMessage;
    private VehiclePermitRequest? request;
    private List<DepartmentDto> departments = new();
    private User? currentUser;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userName = authState.User.Identity?.Name;
            currentUser = userName != null ? await UserManager.FindByNameAsync(userName) : null;
            var permit = await PermitService.GetPermitByIdAsync(Id);
            if (permit == null || !string.Equals(permit.classification, nameof(PermitClassification.Cars), StringComparison.OrdinalIgnoreCase))
            {
                errorMessage = "تصريح المركبات غير موجود.";
                return;
            }

            var names = currentUser == null
                ? new HashSet<string>()
                : await MaterialPermits.GetSameCenterUserNamesAsync(currentUser);
            if (currentUser == null || !MaterialPermitService.CanEdit(permit, currentUser, names))
            {
                errorMessage = "التعديل متاح لمسودة أدخلها مركز المسؤولية نفسه.";
                return;
            }

            request = new VehiclePermitRequest
            {
                PermitNumber = permit.no ?? "",
                IsTemp = permit.IsTemp,
                PermitDate = permit.date,
                HourOfEntry = permit.hourOfEntry,
                ValidTo = permit.ValidTo ?? permit.date,
                ExpectedExecutionTime = permit.ExpectedExecutionTime,
                ShiftApproval = permit.ShiftApproval,
                RequestingDepartmentCode = permit.reqDepartment ?? "",
                ResponsibleParty = permit.OrgDescription,
                Phone = permit.phoneNo,
                MoveFrom = permit.moveFrom,
                MoveTo = permit.moveTo,
                Purpose = permit.VehicleDetail?.remarks,
                Notes = permit.remarks,
                InternalUse = permit.VehicleDetail?.InternalUse ?? true,
                TripCount = Math.Max(1, permit.VehicleDetail?.TripCount ?? 1),
                Vehicles = permit.Cars
                    .Where(c => !c.isDeleted && !string.IsNullOrWhiteSpace(c.carNo))
                    .GroupBy(c => $"{c.carNo}|{c.carType}|{c.name}|{c.licenseNo}", StringComparer.OrdinalIgnoreCase)
                    .Select(g => g.First())
                    .Select(c => new CarMovmentViewModel
                    {
                        CarNo = c.carNo ?? "",
                        CarType = c.carType ?? "",
                        DriverName = c.name ?? "",
                        licenseNo = c.licenseNo ?? ""
                    }).ToList()
            };
            if (request.Vehicles.Count == 0)
                request.Vehicles.Add(new CarMovmentViewModel());

            if (currentUser != null && !string.IsNullOrWhiteSpace(currentUser.ResponsibilityCode))
            {
                departments = await DepartmentService.GetDepartmentsByResponsibilityAsync(currentUser.ResponsibilityCode);
                if (departments.All(d => d.RespCode != request.RequestingDepartmentCode) && !string.IsNullOrWhiteSpace(request.RequestingDepartmentCode))
                {
                    departments.Insert(0, new DepartmentDto
                    {
                        RespCode = request.RequestingDepartmentCode,
                        DepartmentName = request.RequestingDepartmentCode
                    });
                }
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private void ApplyShiftApproval()
    {
        if (request != null && NeedsShiftApproval(request.PermitDate, request.ExpectedExecutionTime))
            request.ShiftApproval = true;
    }

    private static bool NeedsShiftApproval(DateTime permitDate, string? expectedTime)
    {
        if (permitDate.DayOfWeek is DayOfWeek.Friday or DayOfWeek.Saturday)
            return true;
        if (!TimeSpan.TryParse(expectedTime, out var time))
            return false;
        return time >= TimeSpan.FromHours(15) || time <= TimeSpan.FromHours(8);
    }

    private void AddVehicle() => request?.Vehicles.Add(new CarMovmentViewModel());
    private Task PreventSubmit(EditContext _) => SaveAsync();

    private async Task SaveAsync()
    {
        if (saving || request == null || currentUser == null) return;
        errorMessage = null;
        saving = true;
        try
        {
            if (!request.InternalUse)
                request.TripCount = 1;
            await MaterialPermits.UpdateVehicleAsync(Id, request, currentUser);
            Navigation.NavigateTo(ReturnUrl.Read(Navigation) ?? "/permits");
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }
}
