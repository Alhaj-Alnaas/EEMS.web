@page "/permits/materials/edit/{Id:guid}"
@rendermode InteractiveServer
@inject IPermit PermitService
@inject IMaterialPermitService MaterialPermits
@inject IProcedureMovment ProcedureMovmentService
@inject IDepartmentService DepartmentService
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation
@inject PMS.web.Notifications.IUiToast Toast
@using Microsoft.AspNetCore.Identity
@using Core.Entities.DTOs
@using static Core.Enums.BaseEnums
@using Services.Permits

<PageTitle>تعديل تصريح مواد - PMS</PageTitle>

<div class="pms-create-page">
<h3 class="mb-1"><i class="bi bi-pencil-square text-warning"></i> تعديل تصريح مواد</h3>

@if (loading)
{
    <div class="text-center p-5"><div class="spinner-border text-warning"></div></div>
}
else if (notFound)
{
    <div class="alert alert-danger">لم يتم العثور على التصريح.</div>
}
else if (editBlocked)
{
    <div class="alert alert-warning">التعديل متاح فقط لمن أدخل التصريح، وعندما تكون حالته مسودة.</div>
    <BackLink Fallback="/permits">العودة للقائمة</BackLink>
}
else
{
    <EditForm Model="model" class="pms-create-form" OnSubmit="PreventSubmit">
        <div class="pms-create-body">
        <div class="row g-4">
            <div class="col-md-4">
                <div class="card pms-basic-card">
                    <div class="card-header pms-header">البيانات الأساسية</div>
                    <div class="card-body pms-basic-scroll">
                        <div class="form-check form-switch mb-3">
                            <InputCheckbox class="form-check-input" @bind-Value="model.IsTemp" id="isTemp" />
                            <label class="form-check-label fw-bold" for="isTemp">تصريح مؤقت</label>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">رقم التصريح</label>
                            <input class="form-control text-center fw-bold text-warning" value="@model.No" readonly />
                        </div>

                        <div class="row g-2 mb-3">
                            <div class="col-7">
                                <label class="form-label">تاريخ التصريح</label>
                                <InputDate class="form-control" @bind-Value="model.Date" />
                            </div>
                            <div class="col-5">
                                <label class="form-label">الوقت</label>
                                <InputText type="time" class="form-control" @bind-Value="model.HourOfEntry" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">نوع التصريح</label>
                            <InputSelect class="form-select" @bind-Value="model.Type">
                                <option value="@EnumPermitType.Export">استخراج</option>
                                <option value="@EnumPermitType.Import">إدخال</option>
                                <option value="@EnumPermitType.ExtractAndInsert">إستخراج وإدخال</option>
                            </InputSelect>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">الجهة الطالبة <span class="pms-req">*</span></label>
                            <InputSelect class="form-select" @bind-Value="selectedRespCode">
                                <option value="">-- اختر الجهة الطالبة --</option>
                                @foreach (var dep in departments)
                                {
                                    <option value="@dep.RespCode">@dep.DepartmentName</option>
                                }
                            </InputSelect>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">الجهة المصرح لها</label>
                            <InputText class="form-control" @bind-Value="model.OrgDescription" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">رقم الهاتف</label>
                            <InputText class="form-control" @bind-Value="model.PhoneNo" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">قادم من</label>
                            <InputText class="form-control" @bind-Value="model.MoveFrom" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">ذاهب إلى</label>
                            <InputText class="form-control" @bind-Value="model.MoveTo" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-8 pms-side-scroll">
                <div class="card mb-3">
                    <div class="card-header pms-header d-flex justify-content-between align-items-center">
                        <span>المواد والمعدات</span>
                        <button type="button" class="btn btn-sm btn-light" @onclick="AddEquipmentRow">
                            <i class="bi bi-plus-circle"></i> إضافة مادة
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-bordered mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>اسم المادة/المعدة</th>
                                        <th style="width:120px">الكمية</th>
                                        <th style="width:160px">الوحدة</th>
                                        <th style="width:50px"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < model.EquipmentsAndMaterials.Count; i++)
                                    {
                                        var idx = i;
                                        <tr>
                                            <td><input class="form-control" @bind="model.EquipmentsAndMaterials[idx].ItemName" /></td>
                                            <td><input type="number" class="form-control" @bind="model.EquipmentsAndMaterials[idx].Quantity" /></td>
                                            <td>
                                                <select class="form-select" @bind="model.EquipmentsAndMaterials[idx].Unit">
                                                    @foreach (var u in Enum.GetValues<UnitType>())
                                                    {
                                                        <option value="@u">@u.ToString().Replace('_', ' ')</option>
                                                    }
                                                </select>
                                            </td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => model.EquipmentsAndMaterials.RemoveAt(idx)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="card mb-3">
                    <div class="card-header pms-header d-flex justify-content-between align-items-center">
                        <span>السيارات</span>
                        <button type="button" class="btn btn-sm btn-light" @onclick="AddCarRow">
                            <i class="bi bi-plus-circle"></i> إضافة سيارة
                        </button>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-bordered mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>رقم السيارة</th>
                                        <th>نوع السيارة</th>
                                        <th>اسم السائق</th>
                                        <th>جنسية السائق</th>
                                        <th>رخصة القيادة</th>
                                        <th style="width:50px"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < model.Cars.Count; i++)
                                    {
                                        var idx = i;
                                        <tr>
                                            <td><input class="form-control" @bind="model.Cars[idx].CarNo" /></td>
                                            <td><input class="form-control" @bind="model.Cars[idx].CarType" /></td>
                                            <td><input class="form-control" @bind="model.Cars[idx].DriverName" /></td>
                                            <td>
                                                <select class="form-select" @bind="model.Cars[idx].driverNationality">
                                                    @foreach (var n in Enum.GetValues<Nationality>())
                                                    {
                                                        <option value="@n">@n.ToString().Replace('_', ' ')</option>
                                                    }
                                                </select>
                                            </td>
                                            <td><input class="form-control" @bind="model.Cars[idx].licenseNo" /></td>
                                            <td class="text-center">
                                                <button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => model.Cars.RemoveAt(idx)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">ملاحظات</label>
                    <InputTextArea class="form-control" rows="3" @bind-Value="model.Notes" />
                </div>
            </div>
        </div>
        </div>

        <div class="pms-create-actions">
            <button type="button" class="btn btn-outline-secondary px-4" @onclick="() => SaveAsync(false)" disabled="@saving">
                <i class="bi bi-save"></i> حفظ التعديلات
            </button>
            <button type="button" class="btn btn-warning px-4" @onclick="() => SaveAsync(true)" disabled="@saving">
                <i class="bi bi-send"></i> إرسال للاعتماد
            </button>
            <button type="button" class="btn btn-outline-danger px-4" @onclick="CancelPermitAsync" disabled="@saving">
                <i class="bi bi-x-circle"></i> إلغاء التصريح
            </button>
            <BackLink Fallback="/permits" Css="btn btn-outline-secondary px-4">رجوع</BackLink>
        </div>
    </EditForm>
}
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private bool loading = true;
    private bool saving;
    private bool notFound;
    private bool editBlocked;
    private PermitViewModel model = new();
    private List<DepartmentDto> departments = new();
    private string selectedRespCode = "";
    private User? currentUser;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthProvider.GetAuthenticationStateAsync();
        var userName = authState.User.Identity?.Name;
        currentUser = userName != null ? await UserManager.FindByNameAsync(userName) : null;

        if (currentUser != null)
        {
            departments = await DepartmentService.GetDepartmentsByResponsibilityAsync(currentUser.ResponsibilityCode);
        }

        var permit = await PermitService.GetPermitByIdAsync(Id);
        if (permit == null)
        {
            notFound = true;
            loading = false;
            return;
        }

        if (currentUser == null)
        {
            editBlocked = true;
            loading = false;
            return;
        }

        if (!MaterialPermitService.CanEdit(permit, currentUser))
        {
            editBlocked = true;
            loading = false;
            return;
        }

        model = new PermitViewModel
        {
            Id = permit.Id,
            No = permit.no,
            Classification = permit.classification ?? "",
            Type = Enum.TryParse<EnumPermitType>(permit.type, out var t) ? t : EnumPermitType.Import,
            OrgDescription = permit.OrgDescription ?? "",
            IsTemp = permit.IsTemp,
            MoveFrom = permit.moveFrom ?? "",
            MoveTo = permit.moveTo ?? "",
            Notes = permit.remarks ?? "",
            PhoneNo = permit.phoneNo ?? "",
            Date = permit.date,
            HourOfEntry = permit.hourOfEntry,
            ReqDepartment = permit.reqDepartment ?? "",
            Cars = permit.Cars.Select(c => new CarMovmentViewModel
            {
                CarType = c.carType,
                CarNo = c.carNo,
                DriverName = c.name,
                DriverOrg = c.orginaization,
                driverNationality = Enum.TryParse<Nationality>(c.nattiunality, out var n) ? n : Nationality.غير_معروف,
                licenseNo = c.licenseNo
            }).ToList(),
            EquipmentsAndMaterials = permit.EquipmentsAndMatirials.Select(e => new EquipMatiMovmentViewModel
            {
                ItemName = e.description,
                Quantity = e.qty,
                Unit = Enum.TryParse<UnitType>(e.unit, out var u) ? u : UnitType.غير_معروف
            }).ToList()
        };

        selectedRespCode = permit.reqDepartment ?? "";
        loading = false;
    }

    private void AddEquipmentRow() => model.EquipmentsAndMaterials.Add(new EquipMatiMovmentViewModel());
    private void AddCarRow() => model.Cars.Add(new CarMovmentViewModel());
    private Task PreventSubmit(EditContext _) => SaveAsync(true);

    private async Task SaveAsync(bool submit)
    {
        if (saving) return;
        var namedItems = model.EquipmentsAndMaterials
            .Where(e => !string.IsNullOrWhiteSpace(e.ItemName))
            .ToList();
        if (namedItems.Count == 0)
        {
            await Toast.WarningAsync("أضف مادة أو معدة واحدة على الأقل.");
            return;
        }
        if (string.IsNullOrWhiteSpace(selectedRespCode))
        {
            await Toast.WarningAsync("يرجى اختيار الجهة الطالبة.");
            return;
        }
        if (submit && !await Toast.ConfirmAsync("هل تريد إرسال هذا التصريح للاعتماد؟", "نعم", "لا", "confirm"))
            return;
        saving = true;
        try
        {
        var permit = await PermitService.GetPermitByIdAsync(Id);
        if (permit == null || currentUser == null) return;

        if (!MaterialPermitService.CanEdit(permit, currentUser))
        {
            editBlocked = true;
            return;
        }

        permit.updatedBy = currentUser?.UserName;
        permit.updatedOn = DateTime.Now;
        permit.date = model.Date;
        permit.hourOfEntry = model.HourOfEntry;
        permit.type = model.Type.ToString();
        permit.IsTemp = model.IsTemp;
        permit.moveFrom = model.MoveFrom;
        permit.moveTo = model.MoveTo;
        permit.reqDepartment = selectedRespCode;
        permit.phoneNo = model.PhoneNo;
        permit.OrgDescription = model.OrgDescription;
        permit.remarks = model.Notes;

        permit.EquipmentsAndMatirials = namedItems
            .Select(e => new EquipMatiMovment { description = e.ItemName, qty = e.Quantity, unit = e.Unit.ToString() })
            .ToList();

        permit.Cars = model.Cars
            .Select(c => new CarMovment
            {
                carType = c.CarType,
                carNo = c.CarNo,
                licenseNo = c.licenseNo,
                name = c.DriverName,
                nattiunality = c.driverNationality.ToString(),
                orginaization = model.OrgDescription
            }).ToList();

        await PermitService.UpdatePermitAsync(permit);
        await ProcedureMovmentService.InsertProcedureMovment(new ProcedureMovment
        {
            Id = Guid.NewGuid(),
            permitId = permit.Id,
            procedureType = "Update",
            donedBy = currentUser.FullName,
            doneAs = currentUser.JobtypeName,
            shift = "A",
            doneOn = DateTime.Now,
            remarks = "تعديل التصريح",
            createdBy = currentUser.UserName,
            createdOn = DateTime.Now
        });
        if (submit)
            await MaterialPermits.SubmitDraftAsync(permit.Id, currentUser);
        Navigation.NavigateTo(ReturnUrl.Read(Navigation) ?? "/permits");
        }
        catch (Exception ex)
        {
            await Toast.ErrorAsync(ex.Message);
        }
        finally
        {
            saving = false;
        }
    }

    private async Task CancelPermitAsync()
    {
        if (saving || currentUser == null) return;
        if (!await Toast.ConfirmAsync("هل تريد إلغاء هذا التصريح؟ لا يمكن التراجع عن الإلغاء.", "إلغاء التصريح", "لا", "danger"))
            return;
        saving = true;
        try
        {
            await MaterialPermits.CancelAsync(Id, currentUser);
            await Toast.SuccessAsync("تم إلغاء التصريح.");
            Navigation.NavigateTo(ReturnUrl.Read(Navigation) ?? "/permits");
        }
        catch (Exception ex)
        {
            await Toast.ErrorAsync(ex.Message);
        }
        finally
        {
            saving = false;
        }
    }
}
