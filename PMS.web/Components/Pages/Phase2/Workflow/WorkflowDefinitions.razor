@page "/admin/workflows"
@page "/admin/permit-gates"
@rendermode InteractiveServer
@inject IApprovalPathService ApprovalPaths
@inject IPermitExecutionService Execution
@inject UserManager<User> UserManager
@inject AuthenticationStateProvider AuthProvider
@inject PMS.web.Notifications.IUiToast Toast
@using Microsoft.AspNetCore.Identity
@using Core.Models
@using static Core.Enums.BaseEnums

<PageTitle>إعدادات التصريح - PMS</PageTitle>

<div class="pms-settings">
    <div class="pms-settings-heading">
        <h3>إعدادات التصريح</h3>
        <p>اختر نوع التصريح، ثم اضبط مسار اعتماده أو بوابات تنفيذه.</p>
    </div>

    @if (!string.IsNullOrEmpty(loadError))
    {
        <div class="alert alert-danger mb-0">@loadError</div>
    }

    @if (loading)
    {
        <div class="text-center p-5"><div class="spinner-border text-warning"></div></div>
    }
    else if (Selected is not null)
    {
        var noApproval = Selected.Steps.First(s => s.Type == WorkflowStepType.NoApproval);
        <div class="pms-settings-shell">
            <aside class="pms-settings-nav">
                <div class="pms-settings-nav-label">أنواع التصاريح</div>
                @foreach (var row in rows)
                {
                    <button type="button"
                            class="pms-settings-type @(row.Classification == Selected.Classification ? "active" : "")"
                            @onclick="() => Select(row)">
                        <i class="bi @TypeIcon(row.Classification)"></i>
                        <span>@row.Title</span>
                    </button>
                }
            </aside>

            <section class="pms-settings-pane">
                <div class="pms-settings-pane-head">
                    <div>
                        <div class="pms-settings-kicker">نوع التصريح</div>
                        <h4>@Selected.Title</h4>
                    </div>
                    <div class="pms-settings-tabs" role="tablist">
                        <button type="button" role="tab" class="@(tab == SettingsTab.Path ? "active" : "")" @onclick="() => tab = SettingsTab.Path">مسار الاعتماد</button>
                        <button type="button" role="tab" class="@(tab == SettingsTab.Gates ? "active" : "")" @onclick="() => tab = SettingsTab.Gates">بوابات التنفيذ</button>
                    </div>
                </div>

                <div class="pms-settings-body">
                    @if (tab == SettingsTab.Path)
                    {
                        <div class="pms-settings-summary">
                            <span>المسار المحفوظ</span>
                            <strong>@SavedPathText(Selected)</strong>
                        </div>

                        @foreach (var step in Selected.Steps)
                        {
                            var inputId = $"{Selected.Classification}-{step.Type}";
                            var locked = step.Type != WorkflowStepType.NoApproval && noApproval.Enabled;
                            <div class="pms-setting-row @(locked ? "is-locked" : "")">
                                <div class="pms-setting-copy">
                                    <label for="@inputId">@step.Label</label>
                                    <p>@step.Hint</p>
                                </div>
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" role="switch" id="@inputId"
                                           checked="@step.Enabled" disabled="@locked"
                                           @onchange="args => TogglePath(Selected, step, args)" />
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="pms-settings-summary">
                            <span>البوابات المحفوظة</span>
                            <strong>@SavedGateText(Selected.Classification)</strong>
                        </div>
                        <p class="text-muted small mb-3">تُستخدم هذه البوابات عندما لا يمر مسار الاعتماد بقسم الحراسة.</p>

                        @if (!string.IsNullOrEmpty(gateError))
                        {
                            <div class="alert alert-danger">@gateError</div>
                        }
                        else if (gates.Count == 0)
                        {
                            <div class="pms-settings-empty">لا توجد بوابات نشطة. أضف البوابات من إدارة البوابات.</div>
                        }
                        else
                        {
                            @foreach (var gate in gates)
                            {
                                var inputId = $"gate-{Selected.Classification}-{gate.Id}";
                                <div class="pms-setting-row">
                                    <div class="pms-setting-copy">
                                        <label for="@inputId">@GateText(gate)</label>
                                    </div>
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" role="switch" id="@inputId"
                                               checked="@IsGateChecked(Selected.Classification, gate.Id)"
                                               @onchange="args => ToggleGate(Selected.Classification, gate.Id, args)" />
                                    </div>
                                </div>
                            }
                        }
                    }
                </div>

                <div class="pms-settings-foot d-flex flex-wrap gap-2">
                    @if (tab == SettingsTab.Path)
                    {
                        <button class="btn btn-warning" disabled="@saving" @onclick="() => SavePathAsync(Selected)">حفظ المسار</button>
                    }
                    else if (string.IsNullOrEmpty(gateError) && gates.Count > 0)
                    {
                        <button class="btn btn-warning" disabled="@saving" @onclick="() => SaveGatesAsync(Selected.Classification)">حفظ البوابات</button>
                    }
                    <BackLink Fallback="/dashboard" Css="btn btn-outline-secondary px-4">إلغاء</BackLink>
                </div>
            </section>
        </div>
    }
</div>

@code {
    private enum SettingsTab { Path, Gates }

    private bool loading = true;
    private bool saving;
    private string? loadError;
    private string? gateError;
    private SettingsTab tab = SettingsTab.Path;
    private List<ApprovalPathRow> rows = new();
    private List<Gate> gates = new();
    private PermitClassification selected = PermitClassification.Materials;
    private Dictionary<PermitClassification, string> savedPaths = new();
    private Dictionary<PermitClassification, HashSet<Guid>> chosenGates = new();
    private Dictionary<PermitClassification, string> savedGates = new();

    private ApprovalPathRow? Selected =>
        rows.FirstOrDefault(r => r.Classification == selected) ?? rows.FirstOrDefault();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            rows = await ApprovalPaths.GetAsync();
            RememberSavedPaths();
            if (rows.Count > 0)
                selected = rows[0].Classification;
        }
        catch (Exception ex)
        {
            loadError = "تعذر تحميل إعدادات التصريح: " + ex.Message;
        }

        try
        {
            gates = await Execution.GetActiveGatesAsync();
            var links = await Execution.GetLinksAsync();
            foreach (var kind in rows.Select(r => r.Classification))
            {
                var ids = links.TryGetValue(kind, out var stored)
                    ? stored.ToHashSet()
                    : new HashSet<Guid>();
                chosenGates[kind] = ids;
                savedGates[kind] = DescribeGates(ids);
            }
        }
        catch (Exception ex)
        {
            gateError = "تعذر تحميل بوابات التنفيذ: " + ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private void Select(ApprovalPathRow row) => selected = row.Classification;

    private static string TypeIcon(PermitClassification kind) => kind switch
    {
        PermitClassification.Materials => "bi-box-seam",
        PermitClassification.Visitors => "bi-people",
        PermitClassification.Cars => "bi-truck",
        PermitClassification.EmployeeAccess => "bi-person-badge",
        _ => "bi-file-earmark-text"
    };

    private string SavedPathText(ApprovalPathRow row) =>
        savedPaths.TryGetValue(row.Classification, out var text) && text != "لم يُحدد بعد"
            ? text
            : "لا يوجد مسار محفوظ لهذا النوع";

    private string SavedGateText(PermitClassification kind) =>
        savedGates.TryGetValue(kind, out var text) ? text : "لا توجد بوابات محفوظة لهذا النوع";

    private void TogglePath(ApprovalPathRow row, ApprovalPathStepChoice step, ChangeEventArgs args)
    {
        var enabled = args.Value is bool value && value;
        step.Enabled = enabled;

        if (step.Type == WorkflowStepType.NoApproval && enabled)
        {
            foreach (var other in row.Steps.Where(s => s.Type != WorkflowStepType.NoApproval))
                other.Enabled = false;
        }
        else if (enabled)
        {
            var noApproval = row.Steps.First(s => s.Type == WorkflowStepType.NoApproval);
            noApproval.Enabled = false;
        }
    }

    private bool IsGateChecked(PermitClassification kind, Guid gateId) =>
        chosenGates.TryGetValue(kind, out var ids) && ids.Contains(gateId);

    private void ToggleGate(PermitClassification kind, Guid gateId, ChangeEventArgs args)
    {
        if (!chosenGates.TryGetValue(kind, out var ids))
        {
            ids = new HashSet<Guid>();
            chosenGates[kind] = ids;
        }

        if (args.Value is bool on && on)
            ids.Add(gateId);
        else
            ids.Remove(gateId);
    }

    private static string Preview(ApprovalPathRow row)
    {
        var labels = row.Steps.Where(s => s.Enabled).Select(s => s.Label).ToList();
        return labels.Count == 0 ? "لم يُحدد بعد" : string.Join(" ← ", labels);
    }

    private void RememberSavedPaths() =>
        savedPaths = rows.ToDictionary(r => r.Classification, Preview);

    private string DescribeGates(IReadOnlySet<Guid> ids)
    {
        var names = gates.Where(g => ids.Contains(g.Id)).Select(GateText).ToList();
        return names.Count == 0 ? "لا توجد بوابات محفوظة لهذا النوع" : string.Join("، ", names);
    }

    private async Task SavePathAsync(ApprovalPathRow row)
    {
        saving = true;
        try
        {
            var auth = await AuthProvider.GetAuthenticationStateAsync();
            var userName = auth.User.Identity?.Name;
            var user = userName == null ? null : await UserManager.FindByNameAsync(userName);
            if (user == null)
                throw new InvalidOperationException("تعذر تحديد المستخدم الحالي.");

            var enabled = row.Steps.Where(s => s.Enabled).Select(s => s.Type).ToList();
            await ApprovalPaths.SaveAsync(row.Classification, enabled, user);
            selected = row.Classification;
            rows = await ApprovalPaths.GetAsync();
            RememberSavedPaths();
            await Toast.SuccessAsync("حُفظ مسار " + row.Title + ".");
        }
        catch (Exception ex)
        {
            await Toast.ErrorAsync(ex.Message);
        }
        finally
        {
            saving = false;
        }
    }

    private async Task SaveGatesAsync(PermitClassification kind)
    {
        if (!chosenGates.TryGetValue(kind, out var ids))
            ids = new HashSet<Guid>();

        saving = true;
        try
        {
            await Execution.SaveLinksAsync(kind, ids);
            savedGates[kind] = DescribeGates(ids);
            await Toast.SuccessAsync("حُفظت بوابات التنفيذ.");
        }
        catch (Exception ex)
        {
            await Toast.ErrorAsync(ex.Message);
        }
        finally
        {
            saving = false;
        }
    }

    private static string GateText(Gate gate)
    {
        var number = gate.no?.Trim() ?? "";
        var description = gate.description?.Trim() ?? "";
        if (number.Length == 0)
            return description.Length == 0 ? gate.Id.ToString() : description;
        return description.Length == 0 ? number : number + " - " + description;
    }
}
