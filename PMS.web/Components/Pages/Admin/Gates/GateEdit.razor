@page "/admin/gates/edit/{Id:guid}"
@rendermode InteractiveServer
@inject IGates GateService
@inject AuthenticationStateProvider AuthProvider
@inject NavigationManager Navigation

<PageTitle>@(IsNew ? "إضافة بوابة" : "تعديل بوابة") - PMS</PageTitle>

<div class="pms-create-page pms-gate-page">
    <h3 class="mb-1">
        <i class="bi bi-door-open-fill text-warning"></i>
        @(IsNew ? "إضافة بوابة جديدة" : "تعديل بيانات البوابة")
    </h3>
    <p class="text-muted small mb-2">سجّل رقم البوابة ووصفها، ثم احفظ البيانات.</p>

    @if (loading)
    {
        <div class="text-center p-5"><div class="spinner-border text-warning"></div></div>
    }
    else
    {
        <EditForm Model="gate" class="pms-create-form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />
            <div class="pms-create-body">
                <div class="card pms-basic-card">
                    <div class="card-header pms-header">بيانات البوابة</div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">رقم البوابة <span class="text-danger">*</span></label>
                            <InputText class="form-control" inputmode="numeric" @bind-Value="gate.no" @bind-Value:after="NormalizeGateNo" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">الوصف <span class="text-danger">*</span></label>
                            <InputText class="form-control" @bind-Value="gate.description" />
                        </div>
                        <div class="form-check form-switch mb-3">
                            <InputCheckbox class="form-check-input" @bind-Value="gate.isActive" id="isActive" />
                            <label class="form-check-label fw-bold" for="isActive">بوابة نشطة</label>
                        </div>
                        <div class="mb-0">
                            <label class="form-label">ملاحظات</label>
                            <InputTextArea class="form-control" @bind-Value="gate.remarks" rows="3" />
                        </div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger mt-2 mb-0">@error</div>
            }

            <div class="pms-create-actions">
                <button type="submit" class="btn btn-warning px-4" disabled="@saving">
                    <i class="bi bi-save"></i> @(saving ? "جاري الحفظ..." : "حفظ")
                </button>
                <BackLink Fallback="/admin/gates" Css="btn btn-outline-secondary px-4">إلغاء</BackLink>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private bool IsNew => Id == Guid.Empty;
    private bool loading = true;
    private bool saving;
    private string? error;
    private Gate gate = new() { no = "", description = "", isActive = true };

    protected override async Task OnInitializedAsync()
    {
        if (!IsNew)
        {
            var existing = await GateService.GetByIdAsync(Id);
            if (existing != null)
                gate = existing;
            else
                error = "البوابة غير موجودة.";
        }

        loading = false;
    }

    private void NormalizeGateNo() => gate.no = FieldRules.Digits(gate.no);

    private async Task SaveAsync()
    {
        error = null;
        if (string.IsNullOrWhiteSpace(gate.no))
        {
            error = "رقم البوابة مطلوب.";
            return;
        }
        if (string.IsNullOrWhiteSpace(gate.description))
        {
            error = "وصف البوابة مطلوب.";
            return;
        }

        saving = true;
        try
        {
            var authState = await AuthProvider.GetAuthenticationStateAsync();
            var userName = authState.User.Identity?.Name;

            if (IsNew)
            {
                gate.Id = Guid.NewGuid();
                gate.createdOn = DateTime.Now;
                gate.createdBy = userName;
                await GateService.InsertAsync(gate);
            }
            else
            {
                gate.updatedOn = DateTime.Now;
                gate.updatedBy = userName;
                await GateService.UpdateAsync(gate);
            }

            Navigation.NavigateTo(ReturnUrl.Read(Navigation) ?? "/admin/gates");
        }
        catch (Exception ex)
        {
            error = ex.InnerException?.Message ?? ex.Message;
        }
        finally
        {
            saving = false;
        }
    }
}
