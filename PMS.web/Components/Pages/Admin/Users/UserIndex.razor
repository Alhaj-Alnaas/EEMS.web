@page "/admin/users"
@rendermode InteractiveServer
@attribute [Authorize(Policy = TaskPolicies.AdminUsers)]
@using Core.Interfaces.Services.Security
@using Core.Models.Security
@using Core.Security
@using PMS.web.Authorization
@inject IUserAccountService Users
@inject IAccessLevelService AccessLevels
@inject NavigationManager Navigation

<PageTitle>إدارة المستخدمين - PMS</PageTitle>

<div class="user-mgmt" dir="rtl">
    <div class="header-info mb-3">
        <h1>إدارة حسابات المستخدمين</h1>
        <p>استخدم رقم الملف الوظيفي للوصول إلى بيانات الموظف وتعديل مستوى دخوله</p>
    </div>

    <div class="d-flex justify-content-end mb-3">
        <a class="btn btn-warning" href="@ReturnUrl.Go(Navigation, "/admin/users/create")">
            <i class="bi bi-person-plus-fill"></i> إضافة مستخدم
        </a>
    </div>

    @if (!string.IsNullOrEmpty(message))
    {
        <div class="alert @(messageOk ? "alert-success" : "alert-danger")">@message</div>
    }
    @if (!string.IsNullOrEmpty(tempPassword))
    {
        <div class="alert alert-warning">
            كلمة المرور المؤقتة: <strong class="user-select-all">@tempPassword</strong>
        </div>
    }

    <div class="card mb-4 search-panel">
        <div class="card-body">
            <div class="row align-items-end g-3">
                <div class="col-lg-3">
                    <h5 class="m-0 fw-bold"><i class="bi bi-search text-warning me-2"></i>بحث عن موظف</h5>
                </div>
                <div class="col-lg-6">
                    <label class="form-label fw-bold small mb-1">رقم الملف الوظيفي</label>
                    <input class="form-control" @bind="searchFileNo" @bind:event="oninput"
                           placeholder="أدخل رقم الملف الوظيفي..." @onkeydown="OnSearchKey" />
                </div>
                <div class="col-lg-3">
                    <button class="btn btn-warning w-100 fw-bold" @onclick="LoadUserAsync" disabled="@busy">
                        <i class="bi bi-search"></i> عرض البيانات
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (detail != null)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-body p-4">
                <div class="row">
                    <div class="col-md-7">
                        <h5 class="mb-4"><i class="bi bi-person-badge me-2"></i>البيانات الشخصية</h5>
                        <div class="mb-3">
                            <label class="form-label fw-bold">اسم الموظف بالكامل</label>
                            <input class="form-control bg-light fw-bold" value="@detail.EmpName" readonly />
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">الإدارة / القسم</label>
                                <input class="form-control bg-light" value="@detail.Department" readonly />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">المسمى الوظيفي</label>
                                <input class="form-control bg-light" value="@detail.JobTypeName" readonly />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">البريد</label>
                                <input class="form-control bg-light" value="@detail.EmpEmail" readonly />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label fw-bold">الحالة الوظيفية</label>
                                <input class="form-control bg-light" value="@detail.JobStatus" readonly />
                            </div>
                        </div>
                    </div>

                    <div class="col-md-5 border-start-orange">
                        <h5 class="mb-4"><i class="bi bi-shield-lock me-2"></i>مستوى الدخول</h5>

                        <label class="form-label fw-bold">مستوى الدخول</label>
                        <div class="d-flex gap-2 mb-4">
                            <select class="form-select border-warning fw-bold" @bind="selectedLevelId">
                                <option value="">-- اختر المستوى --</option>
                                @foreach (var l in levels)
                                {
                                    <option value="@l.Id">@l.Name</option>
                                }
                            </select>
                            <button class="btn btn-warning" @onclick="SaveLevelAsync" title="حفظ المستوى" disabled="@busy">
                                <i class="bi bi-floppy"></i>
                            </button>
                        </div>

                        <label class="form-label fw-bold">إجراءات الحساب</label>
                        <div class="d-grid gap-2">
                            <button class="btn btn-outline-primary text-end fw-bold" @onclick="ResetPasswordAsync" disabled="@busy">
                                <i class="bi bi-key ms-2"></i> تصفير كلمة المرور
                            </button>
                            <button class="btn btn-outline-danger text-end fw-bold" @onclick="DeleteAsync" disabled="@busy">
                                <i class="bi bi-trash ms-2"></i> حذف المستخدم
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else if (searched)
    {
        <div class="pms-placeholder">
            <i class="bi bi-person-x"></i>
            <h5>لا يوجد مستخدم بهذا الرقم</h5>
            <p class="text-muted">يمكنك إضافته من شاشة إضافة مستخدم.</p>
        </div>
    }
    else
    {
        <div class="pms-placeholder">
            <i class="bi bi-people"></i>
            <h5>جاهز لاستعراض البيانات</h5>
            <p class="text-muted">أدخل رقم الملف الوظيفي أعلاه لإظهار خيارات الحساب.</p>
        </div>
    }

    <div class="card mt-4">
        <div class="card-header fw-bold">آخر المستخدمين</div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>الرقم الوظيفي</th>
                        <th>الاسم</th>
                        <th>الإدارة</th>
                        <th>مستوى الدخول</th>
                        <th>الحالة</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in recent)
                    {
                        <tr>
                            <td>@u.FileNumber</td>
                            <td>@u.FullName</td>
                            <td>@u.Department</td>
                            <td>@(u.AccessLevelName ?? "—")</td>
                            <td>@u.JobStatus</td>
                            <td>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenAsync(u.FileNumber)">
                                    عرض
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    private string searchFileNo = "";
    private bool busy;
    private bool searched;
    private bool messageOk;
    private string? message;
    private string? tempPassword;
    private string selectedLevelId = "";
    private UserAccountDetail? detail;
    private List<Core.Entities.Security.AccessLevel> levels = new();
    private List<UserAccountListItem> recent = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            levels = await AccessLevels.GetAllAsync();
            recent = await Users.SearchAsync(null, 50);
        }
        catch (Exception ex)
        {
            messageOk = false;
            message = "تعذر تحميل إدارة المستخدمين. تأكد من تطبيق ترحيل AccessLevels ثم أعد تشغيل النظام. " + ex.Message;
        }
    }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadUserAsync();
    }

    private async Task OpenAsync(string fileNo)
    {
        searchFileNo = fileNo;
        await LoadUserAsync();
    }

    private async Task LoadUserAsync()
    {
        message = null;
        tempPassword = null;
        searched = true;
        busy = true;
        try
        {
            detail = string.IsNullOrWhiteSpace(searchFileNo)
                ? null
                : await Users.GetByFileNumberAsync(searchFileNo.Trim());
            selectedLevelId = detail?.AccessLevelId?.ToString() ?? "";
        }
        finally
        {
            busy = false;
        }
    }

    private async Task SaveLevelAsync()
    {
        if (detail == null) return;
        if (!Guid.TryParse(selectedLevelId, out var levelId))
        {
            messageOk = false;
            message = "يجب اختيار مستوى الدخول.";
            return;
        }

        busy = true;
        try
        {
            var (ok, msg) = await Users.UpdateAccessLevelAsync(detail.Id, levelId);
            messageOk = ok;
            message = msg;
            if (ok)
            {
                await LoadUserAsync();
                recent = await Users.SearchAsync(null, 50);
            }
        }
        finally { busy = false; }
    }

    private async Task ResetPasswordAsync()
    {
        if (detail == null) return;
        busy = true;
        try
        {
            var (ok, msg, pwd) = await Users.ResetPasswordAsync(detail.Id);
            messageOk = ok;
            message = msg;
            tempPassword = pwd;
        }
        finally { busy = false; }
    }

    private async Task DeleteAsync()
    {
        if (detail == null) return;
        busy = true;
        try
        {
            var (ok, msg) = await Users.DeleteAsync(detail.Id);
            messageOk = ok;
            message = msg;
            if (ok)
            {
                detail = null;
                searched = false;
                recent = await Users.SearchAsync(null, 50);
            }
        }
        finally { busy = false; }
    }
}
